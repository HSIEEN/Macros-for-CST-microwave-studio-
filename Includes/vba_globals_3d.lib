Sub Load_1D (lib_modfile As String, cst_runid As String)
	Dim sResultName_tmp2 As String
	Dim MyResult$(4), MyFolder$(4), myXLabel$(4)

	MyResult$(1)=".rd1"
	MyFolder$(1)="1D-Templates"
	myXLabel$(1)=""

	MyResult$(2)=".m1d"
	MyFolder$(2)="MAFIA"
	myXLabel$(2)=""

	Dim myres$, myfol$, myfilepath$, myfilepattern$, myfilepath_short$, myext$, myext2$, sResultName_tmp$, sResultName_tmp_short$
	Dim iii As Integer

	For iii = 1 To 2
		myfilepath    = lib_modfile+"\Result"
		myfilepattern = "*" + MyResult$(iii)

		' Search for first result file
		sResultName_tmp = FindFirstFile(myfilepath , myfilepattern, False) 'See if a result exist

		While (sResultName_tmp <> "")
				sResultName_tmp_short = sResultName_tmp
				RemoveLastChars(sResultName_tmp_short,4)
				sResultName_tmp2= myfilepath + "\" + sResultName_tmp
				'Add all result files to tree
				With Resulttree
						.Reset
						.Type "XYSignal"
						.Xlabel myXLabel$(iii)
						.Title sResultName_tmp_short
						.Name "1D Results\Comparison\" + MyFolder$(iii) + "\" + sResultName_tmp_short + "\" + cst_runid
						.File sResultName_tmp2
						.Add
				End With
			sResultName_tmp = FindNextFile
		Wend
	Next iii
End Sub


Function mwsversion4 As Boolean
	' oSelectedSP is determined here again in addition to the calls in Evaluate0D/1D/...
	' This ensures that the lib remains compatible with old templates that do not store a script setting "SPName"
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	If InStr(oSelectedSP.getmwsversion,"V 3") > 0 Then
		mwsversion4 = False
	Else
		mwsversion4 = True
	End If
End Function


Function MWS_Version As Double
	' oSelectedSP is determined here again in addition to the calls in Evaluate0D/1D/...
	' This ensures that the lib remains compatible with old templates that do not store a script setting "SPName"
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	MWS_Version = RealVal (Mid(Trim$(oSelectedSP.GetMWSVersion),3,3))
End Function


Function GetNormImpedance(sdsnfilename As String, spomo As String) As Double
	On Error GoTo Imp_undefined
	GetAttr(sdsnfilename)	' See if file exists; don't use Dir() !!
	On Error GoTo 0

	Dim spomo2 As String
	spomo2 = Replace(spomo,"(",",")
	spomo2 = Left(spomo2, Len(spomo2)-1)

	Dim i1 As Integer
	i1 = InStr(spomo2,",")

	Dim strPort As String, strMode As String
	strPort = "Portname: "  + Left(spomo2,i1-1) +"#"
	strMode = "Modenumber: "+ Mid(spomo2,i1+1)  +"#"

	Dim icount As Integer
	icount = 0

	Dim d_Zline As Double, d_Zref As Double
	Dim cst_line As String
	Dim cst_nitems As Integer
	Dim string_item(99) As String

	Dim cst_line_array(50) As String, cst_line1 As String, cst_line2 As String, cst_line3 As String
	Dim nstr As Integer, istr	As Integer

	Open sdsnfilename For  Input As #1

		While Not EOF(1)
			Line Input #1,cst_line1
			If InStr(cst_line1+"#",strPort) > 0 Then
				Line Input #1,cst_line2
				If InStr(cst_line2+"#",strMode) > 0 Then
					' pomo found, now read 4 more lines to get zref
					'		Portname: 2
					'		Modenumber: 1
					'		Modetype: 0
					'		Zwave: 6.726307e+002 0.000000e+000
					'		Zline: 0.000000e+000 0.000000e+000
					'		Zref: 0.000000e+000 0.000000e+000
					Line Input #1,cst_line3
					Line Input #1,cst_line3
					Line Input #1,cst_line3
					cst_nitems = CSTSplit (cst_line3, string_item)
					d_Zline = RealVal(string_item(1))

					Line Input #1,cst_line3
					cst_nitems = CSTSplit (cst_line3, string_item)
					d_Zref = RealVal(string_item(1))

					If d_Zline = 0 Then
						GetNormImpedance = -1
					Else
						If d_Zref = 0 Then
							GetNormImpedance = d_Zline
						Else
							GetNormImpedance = d_Zref
						End If
					End If
					Close #1
					Exit Function
				End If
			End If
		Wend
	Close #1

	Imp_undefined:
		GetNormImpedance = -1
End Function


Sub Handle_0D_Results  (lib_action As String, lib_extension As String, lib_0Dtype As String, _
						lib_targetdir1 As String, lib_modfile As String, lib_dXValue_now As Double, lib_cXLabelNow As String)
	' this subroutine can be used to collect and plot arbitrary 0D Results, written in a file
	' action=write  /  plot   available

	'
	' in this subroutine targetdir must not have a backslash at the end
	'
	Dim lib_targetdir As String
	lib_targetdir = lib_targetdir1

	If Right(lib_targetdir1,1)="\" Then lib_targetdir = Left(lib_targetdir1,Len(lib_targetdir1)-1)

	Dim s0Dtargetmain As String, istartname As Integer, ilenpattern As Integer
	Dim lib_searchpath As String, lib_searchpattern As String, lib_dummy As String
	Dim mysigname As String, sm0dfile As String, iLenM0dfile As Integer, s0DName As String

	s0Dtargetmain = lib_targetdir + "\0D_" + lib_0Dtype + "_"

	'
	' define parameters for file search
	'
	Select Case lib_action

		Case "write"

			lib_searchpath = lib_modfile + "\Result"
			lib_searchpattern = "*" + lib_extension
			istartname = Len(lib_searchpath) + 2

		Case "plot"

			lib_searchpath = DirName(s0Dtargetmain)
			lib_searchpattern = ShortName(s0Dtargetmain) + "*.txt"
			istartname = Len(s0Dtargetmain) + 1

	End Select

	ilenpattern = Len(lib_searchpath) + Len(lib_searchpattern)

	mysigname = FindFirstFile(lib_searchpath , lib_searchpattern, False)

	While (mysigname <> "")

		sm0dfile = lib_searchpath + "\" + mysigname
		iLenM0dfile = Len(sm0dfile)

		s0DName = Mid(sm0dfile, istartname, iLenM0dfile-ilenpattern)

		Select Case lib_action
			Case "write"
				Open s0Dtargetmain + s0DName + ".txt" For Append As #12
					lib_dummy = ""
					Open sm0dfile For Input As #44
						Line Input #44, lib_dummy
					Close #44
					Print #12, CStr(lib_dXValue_now) + "   " +  lib_dummy
				Close #12

			Case "plot"
				With ResultTree
					.Reset
					.Type "XYSignal"
					.Xlabel lib_cXLabelNow
					.Title s0DName
					.Title "" ' otherwise no multiplot possible
					.Name "0D Results\" + lib_0Dtype + "\" + s0DName
					.File sm0dfile
					.Add
				End With
		End Select
		mysigname = FindNextFile
	Wend
End Sub


Sub Prepare_Step_File
	' oSelectedSP is determined here again in addition to the calls in Evaluate0D/1D/...
	' This ensures that the lib remains compatible with old templates that do not store a script setting "SPName"
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	oSelectedSP.SelectTreeItem "Components"
	oSelectedSP.SelectModelView
	With oSelectedSP.STEP
		.Reset
		.ExportAttributes (True)
		.FileName GetProjectPath("ModelCache") + "example.stp"
		On Error GoTo no_step_license
		.WriteAll
	End With

	Dim sfile As String
	sfile = GetProjectPath("ModelCache") + "example.stp"

	Dim cst_line As String
	cst_line = GrepFirstPattern(sfile, sfile)
	If (cst_line <> "") Then
		StoreGlobalDataValue ("Step\Chk1", "11")
	End If

	Dim stree As String
	stree = Resulttree.GetFirstChildName("Components")
	RemoveFirstChars(stree,11)

	cst_line = GrepFirstPattern(sfile, stree)
	If (cst_line <> "") Then
		StoreGlobalDataValue ("Step\Chk2", "23")
	End If

	Exit Sub
	no_step_license:
		MsgBox "Step License not available.",vbCritical
End Sub


Function SolidPointCoordinatesSTEP(sName As String, index As String, x As Double, y As Double, z As Double) As Boolean
	' oSelectedSP is determined here again in addition to the calls in Evaluate0D/1D/...
	' This ensures that the lib remains compatible with old templates that do not store a script setting "SPName"
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	If ( oSelectedSP.Solid.GetPointCoordinates(sName, index, x, y, z) ) Then
		SolidPointCoordinatesSTEP = True
	Else
		SolidPointCoordinatesSTEP = False
