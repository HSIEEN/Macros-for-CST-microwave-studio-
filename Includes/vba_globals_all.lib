'--------------------------------------------------------------------------------------------
Function GetSpiceDouble(value As String) As Double

	' Spice has a special convention for exponential number (without E)
	' e.g.  1.2345+007   instead of 1.2345E+007
	' GetSpiceDouble = 12345000, 
	' GetDouble (=Evaluate) would not work : 8.2345

	'	MsgBox CStr(GetSpiceDouble("1.2345+007"))

	Dim index As Long
	index = InStrRev(value, "+")
	If (index = 0) Then index = InStrRev(value, "-")
	If (index > 1) Then
		If (Mid(value, index-1, 1) <> "E" And Mid(value, index-1, 1) <> "e") Then
			value = Left(value, index-1) + "E" + Mid(value, index)
		End If
	End If

	Dim cst_separator    As String								'<<<<<<<<<<
	cst_separator    = Mid$(CStr(0.5), 2, 1)					'<<<<<<<<<<<

	' 06-aug-2004 ube/cwe: GetSpiceDouble: changed CVar to CDbl (now CVar had problems, see also 13-Nov-2003)
	GetSpiceDouble   = CDbl(Replace(value, ".", cst_separator))	'<<<<<<<<<<<

	'GetSpiceDouble = CVar(Replace(value, ".", ","))

End Function
'--------------------------------------------------------------------------------------------
Function GetDouble(lib_Text As Variant) As Double

	GetDouble = RealVal(lib_Text)

End Function
'-----------------------------------------------------------------------------------------------------
Function RealVal(lib_Text As Variant) As Double

  Dim sText As String
  sText = CStr(lib_Text)
  
  If sText = "" Then
    RealVal = 0
  Else
    RealVal = Evaluate(CStr(lib_Text))
  End If

' known problem does not work in France	
'	If (CDbl("0.5") > 1) Then
'		' komma needed instead of point 
'		RealVal = CDbl(Replace(CStr(lib_Text), ".", ","))
'	Else
'                On Error Resume Next
'                        RealVal = CDbl(CStr(lib_Text))
'                On Error GoTo 0
'	End If

'does also not work in France	
'	If (Val("0.5") > Val("1")) Then

End Function
'-----------------------------------------------------------------------------------------------------
Function CSTSplit(lib_Text As String, lib_array() As String) As Integer

	Dim lib_index As Integer, lib_position As Integer
	
	lib_Text  = Trim$(Replace(lib_Text, Chr$(9), " "))
	lib_index = 0

	While lib_Text <> ""
		lib_position         = InStr(lib_Text + " ", " ")
		lib_array(lib_index) = Trim$(Left$(lib_Text, lib_position))
		lib_Text             = Trim$(Mid$(lib_Text, lib_position))
		lib_index            = lib_index + 1
	Wend

	CSTSplit = lib_index
				
End Function
'-----------------------------------------------------------------------------------------------------
Sub CST_MkDir (lib_dir As String)

	' creates directory, even if some directory levels are missing

	If (Len(lib_dir) > 240) Then
		ReportError(" Cannot create folder. The specified folder path is too long by an estimated " & CStr(Len(lib_dir) - 240) & " characters. Please shorten the folder path.")
	End If

	Const dir_max_level = 10

	Dim lib_subdir(dir_max_level) As String, lib_Ftmp As String, lib_dir2 As String, lib_s3tmp as String
	Dim lib_iii As Integer, lib_jjj As Integer

	lib_dir2 = lib_dir

	If Right$(lib_dir2,1) = "\" Then
		' removes trailing "\"
		lib_dir2 = DirName (lib_dir2)
	End If
	
	If InStr(lib_dir2,"\\")>0 Then
		' remove all multiple backslashes except at the very beginning of the string
		lib_s3tmp=Mid(lib_dir2,2)   			' copy everything except first character
		While InStr(lib_s3tmp,"\\")>0
			lib_s3tmp = Replace(lib_s3tmp, "\\", "\")
		Wend
		lib_dir2 = Left(lib_dir2,1)+lib_s3tmp   ' merge first char again with the rest
	End If

	lib_Ftmp$ = ""
	On Error Resume Next
		lib_Ftmp$ = Dir$(lib_dir2,vbDirectory)
	On Error GoTo 0

	If lib_Ftmp$ <> "" Then
		' directory already exists
		Exit Sub
	End If

	lib_iii=0
	Do
		lib_subdir(lib_iii) = lib_dir2
		lib_dir2 = DirName (lib_dir2)
		lib_iii=lib_iii+1

		lib_Ftmp$ = ""
		On Error Resume Next
			lib_Ftmp$ = Dir$(lib_dir2,vbDirectory)
		On Error GoTo 0

	Loop Until lib_Ftmp$ <> "" Or lib_iii = dir_max_level+1 Or Right$(lib_dir2,1)=":"

	If lib_iii <= dir_max_level Then

		For lib_jjj = lib_iii-1 To 0 STEP -1
			MkDir lib_subdir(lib_jjj)
			Wait 0.01
		Next lib_jjj

	Else

		ReportWarning(" The maximum permissible nesting depth has been reached. Further subfolders will not be created.")

	End If

End Sub
'-----------------------------------------------------------------------------------------------------
Sub CST_RmDir (lib_dir As String)

	' removes an empty directory
	' If the directory is not empty, do not remove and proceed without a warning

	On Error Resume Next
		RmDir lib_dir
	On Error GoTo 0

End Sub

'------------------------------------------------------------------------------------------------------
Sub SendEmail(EmailSubject As String, AttachFile As String)
	
	On Error GoTo NoOutlook
	
	Dim myAttachments As Object

    With CreateObject("Outlook.Application").CreateItem(0)
        .Subject = EmailSubject
        If Not (IsNull(AttachFile) Or IsEmpty(AttachFile)) Then
        	Set myAttachments = .Attachments
            myAttachments.Add AttachFile
        End If
        .Display
    End With
    
NoOutlook:
    
End Sub
