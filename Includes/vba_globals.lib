'---------------------------------------------------------------------
' public variables for searching (=grepping) patterns in txt-file
Dim lib_GrepFilename As String
Dim lib_GrepPattern As String
Dim lib_GrepIndex As Long
'---------------------------------------------------------------------
' public variables for file-searching file-patterns
Dim lib_FindFileRoot As String
Dim lib_FindFilePattern As String
Dim lib_FindFileRecursive As Boolean
Dim lib_FindFileLast As String
'---------------------------------------------------------------------
Function c_Text(cst_x As Variant) As String

        c_Text = "(" + CStr(cst_x(0)) + "+i*" + CStr(cst_x(1)) + ")"

End Function
'---------------------------------------------------------------------
Function c_Neg(cst_x As Variant) As Variant

        c_Neg = Array( _
                                - cst_x(0), - cst_x(1) _
                        )

End Function
'---------------------------------------------------------------------
Function c_Sum(cst_x As Variant, cst_y As Variant) As Variant

        c_Sum = Array( _
                                cst_x(0) + cst_y(0), _
                                cst_x(1) + cst_y(1) _
                        )

End Function
'---------------------------------------------------------------------
Function c_Diff(cst_x As Variant, cst_y As Variant) As Variant

        c_Diff = Array( _
                                cst_x(0) - cst_y(0), _
                                cst_x(1) - cst_y(1) _
                        )

End Function
'---------------------------------------------------------------------
Function c_Prod(cst_x As Variant, cst_y As Variant) As Variant

        c_Prod = Array( _
                                cst_x(0) * cst_y(0) - cst_x(1) * cst_y(1), _
                                cst_x(0) * cst_y(1) + cst_x(1) * cst_y(0) _
                        )

End Function
'---------------------------------------------------------------------
Function c_Quot(cst_x As Variant, cst_y As Variant) As Variant

        c_Quot = Array( _
                                (cst_x(0) * cst_y(0) + cst_x(1) * cst_y(1)) / (1e-10 + cst_y(0)^2 + cst_y(1)^2), _
                                (cst_x(1) * cst_y(0) - cst_x(0) * cst_y(1)) / (1e-10 + cst_y(0)^2 + cst_y(1)^2) _
                        )

End Function
'---------------------------------------------------------------------
Function c_Mag(cst_x As Variant) As Double

        c_Mag = Sqr(cst_x(0)^2 + cst_x(1)^2)

End Function
'---------------------------------------------------------------------
Function c_Deg(cst_x As Variant) As Double

		MsgBox "only with MWS"
       ' c_Deg = ATn2D (cst_x(0), cst_x(1))

End Function
'---------------------------------------------------------------------
Sub Start (lib_filename As String)

        On Error GoTo Win95
        WINNT:
                Shell "cmd /c " + Quote(lib_filename)
                Exit Sub
        Win95:
                Shell "start " + Quote(lib_filename)
                Exit Sub

End Sub
'---------------------------------------------------------------------
Function GrepFirstPattern (lib_filename As String, lib_pattern As String) As String
	
	' initialize public variables
	
	lib_GrepFilename = lib_filename
	lib_GrepPattern = lib_pattern
	lib_GrepIndex = 0
	
	GrepFirstPattern = GrepNextPattern

End Function
			
Function GrepNextPattern As String
	
	Dim lib_dummy As String
	Dim lib_count As Long
	
	' use public variables, initialized in function GrepFirstPattern
	
	lib_count = 0
	
	Open lib_GrepFilename For Input As #44
		While Not EOF(44)
			Line Input #44, lib_dummy
			If (InStr(lib_dummy, lib_GrepPattern)) Then
				lib_count = lib_count + 1
				If (lib_count > lib_GrepIndex) Then
					GrepNextPattern = lib_dummy
					lib_GrepIndex = lib_GrepIndex + 1
					Close #44
					Exit Function
				End If
			End If
		Wend
	Close #44
		
	GrepNextPattern = ""

End Function

Function GetLastLine  (lib_filename As String) As String
	
	Dim lib_dummy As String
	
	lib_dummy = ""
	Open lib_filename For Input As #44
		While Not EOF(44)
			Line Input #44, lib_dummy
		Wend
	Close #44
		
	GetLastLine = lib_dummy

End Function

Function FindFirstFile (lib_rootdir As String, lib_pattern As String, lib_recursive As Boolean) As String

        If (Right$(lib_rootdir, 1) = "\") Then lib_rootdir = Left$(lib_rootdir, Len(lib_rootdir) - 1)
        If (lib_pattern = "")             Then lib_pattern = "*.*"

        CST_MkDir lib_rootdir

		lib_FindFileRoot      = lib_rootdir
        lib_FindFilePattern   = lib_pattern
        lib_FindFileRecursive = lib_recursive
        lib_FindFileLast      = Dir$(lib_rootdir + "\*.*", vbDirectory)

        FindFirstFile     = FindNextFile()

End Function
'---------------------------------------------------------------------
Function FindNextFile () As String

        Dim lib_subdir As String, lib_currentdir, lib_dummy As String, lib_short As String, lib_filename As String
        Dim lib_fileattribute As Integer, lib_tmp_curdir As String

        lib_subdir = DirName(lib_FindFileLast)
        lib_dummy  = Dir$()

        While (Not LCase(lib_dummy) Like LCase(lib_FindFilePattern))

'                If MsgBox(IIf(lib_subdir <> "", lib_subdir + "\" + lib_dummy, lib_dummy), vbQuestion + vbYesNo, "Continue") <> vbYes Then Exit All
                lib_currentdir = lib_FindFileRoot + IIf(lib_subdir <> "", "\" + lib_subdir, "")

                On Error Resume Next
                    lib_fileattribute = 0
                    '
                    ' Bug in GetAttr-Function  for some directories 8208, 8209, 8240 is delivered
                    ' lib_fileattribute = GetAttr(lib_currentdir + "\" + lib_dummy)
                    '
                    ' replaced by new check: try to enter file, if successful => folder, otherwise not
                    '
					lib_tmp_curdir = CurDir
					On Error GoTo No_Directory
						ChDir lib_currentdir + "\" + lib_dummy
						lib_fileattribute = vbDirectory
					No_Directory:
						ChDir lib_tmp_curdir
                On Error GoTo 0

                If (lib_dummy = "") Then
                        If (lib_subdir = "") Then Exit While
                        lib_short      = ShortName(lib_subdir)
                        lib_subdir     = DirName(lib_subdir)
                        lib_currentdir = IIf(lib_subdir <> "", lib_FindFileRoot + "\" + lib_subdir, lib_FindFileRoot)
                        lib_dummy      = Dir$(lib_currentdir + "\*.*", vbDirectory)
                        While (lib_dummy <> lib_short)
                                lib_dummy = Dir$()
                        Wend
                        lib_dummy = Dir$()
                ElseIf (lib_dummy = ".") Or (lib_dummy = "..") Then
                        lib_dummy = Dir$()
                ElseIf (lib_fileattribute = vbDirectory) And lib_FindFileRecursive Then
                        lib_subdir     = IIf(lib_subdir <> "", lib_subdir + "\" + lib_dummy, lib_dummy)
                        lib_currentdir = IIf(lib_subdir <> "", lib_FindFileRoot + "\" + lib_subdir, lib_FindFileRoot)
                        lib_dummy      = Dir$(lib_currentdir + "\*.*", vbDirectory)
                Else
                        lib_dummy = Dir$()
                End If
        Wend
        lib_filename     = IIf(lib_dummy <> "", IIf(lib_subdir <> "", lib_subdir + "\", "") + lib_dummy, "")
        lib_FindFileLast = lib_filename

        FindNextFile     = lib_filename

End Function
'---------------------------------------------------------------------
Function DriveName (lib_path As String) As String

        DriveName  = Left$(lib_path, 1)

End Function
'---------------------------------------------------------------------
Function DirName (lib_path As String) As String

        Dim lib_dircount As Integer

        lib_dircount = InStrRev(lib_path, "\")
        DirName  = Left$(lib_path, IIf(lib_dircount > 1, lib_dircount - 1, 0))

End Function
'---------------------------------------------------------------------
Function ShortName (lib_path As String) As String

        Dim lib_dircount As Integer

        lib_dircount  = InStrRev(lib_path, "\")
        ShortName = Mid$(lib_path, lib_dircount+1, 999)

End Function
'---------------------------------------------------------------------
Function BaseName_noIndex (lib_path As String) As String

	' Basename is short name without index _###
	' Examples
	'			BaseName_noIndex("D:\ub\test_790.sh") = test
	'			BaseName_noIndex("D:\ub\test_79.sh") = test_79
	'			BaseName_noIndex("D:\ub\test_79a.sh") = test_79a
	'			BaseName_noIndex("D:\ub\test_001.sh") = test
	'			BaseName_noIndex("D:\ub\test000.mod") = test000

        Dim lib_dircount As Integer, lib_extcount As Integer, lib_idummy As Integer
        Dim lib_filename As String, lib_name2 As String, lib_length As Integer

        lib_dircount = InStrRev(lib_path, "\")
        lib_filename = Mid$(lib_path, lib_dircount+1)
        lib_extcount = InStrRev(lib_filename, ".")
        lib_name2 = Left$(lib_filename, IIf(lib_extcount > 0, lib_extcount-1, 999))

		On Error GoTo NO_RUN_ID
		If Left(Right(lib_name2,4),1) = "_" Then
			lib_idummy = CInt(Right(lib_name2,3))
			lib_length = Len(lib_name2)
			BaseName_noIndex = Left$(lib_name2, IIf(lib_length > 4, lib_length-4, 999))
			Exit Function
		End If
        
    NO_RUN_ID:
        BaseName_noIndex = lib_name2

End Function
'---------------------------------------------------------------------
Function BaseName (lib_path As String) As String

        Dim lib_dircount As Integer, lib_extcount As Integer, lib_filename As String

        lib_dircount = InStrRev(lib_path, "\")
        lib_filename = Mid$(lib_path, lib_dircount+1)
        lib_extcount = InStrRev(lib_filename, ".")
        BaseName = Left$(lib_filename, IIf(lib_extcount > 0, lib_extcount-1, 999))

End Function
'---------------------------------------------------------------------
Function ExtName (lib_filename As String) As String

        Dim lib_extcount As Integer

        lib_extcount = InStrRev(lib_filename, ".")
        ExtName = IIf(lib_extcount > 0, Mid$(lib_filename, lib_extcount+1), "")

End Function
'---------------------------------------------------------------------
Function FullPath(lib_filename As String, lib_directory As String) As String

        FullPath = IIf(Mid$(lib_filename,2,1) = ":", lib_filename, lib_directory + "\" + lib_filename)

End Function
'---------------------------------------------------------------------
Function ShortPath(lib_filename As String, lib_directory As String) As String

        If (LCase$(DirName(lib_filename)) = LCase$(lib_directory)) Then
                ShortPath = ShortName(lib_filename)
        Else
                ShortPath = lib_filename
        End If

End Function
'---------------------------------------------------------------------
Function Quote (lib_Text As String) As String

        Quote = Chr$(34) + lib_Text + Chr$(34)

End Function
'---------------------------------------------------------------------
Sub CheckApplication (lib_appname As String, lib_filename As String, lib_downloadsource As String)

        Dim lib_newline As String, lib_appdir As String, lib_hotlink As String
        lib_newline = Chr$(10) + Chr$(13)
        lib_appdir  = DirName(lib_filename)
        lib_hotlink = lib_appdir + lib_appname + ".url"

       	Dim bLib_Missing As Boolean
       	bLib_Missing = False
        If (Dir$(DirName(lib_filename), vbDirectory) = "") Then
        	bLib_Missing = True
        Else
	        If (Dir$(lib_filename, vbNormal) = "") Then
	        	bLib_Missing = True
	        End If
        End If
        
        If (bLib_Missing) Then
                If (MsgBox( _
                                lib_appname + " must be installed in" + lib_newline + lib_newline + _
                                lib_appdir                            + lib_newline + lib_newline + _
                                "Download " + lib_appname + " from"   + lib_newline + lib_newline + _
                                lib_downloadsource, _
                                vbOkCancel + vbQuestion, _
                                lib_appname + " is missing" _
                        ) = vbOK) Then
                        If (Dir$(lib_appdir, vbDirectory) = "") Then
                                MkDir lib_appdir
                        End If
                        Open lib_hotlink For Output As #1
                                Print #1, "[DEFAULT]"
                                Print #1, "BASEURL=" + lib_downloadsource
                                Print #1, "[InternetShortcut]"
                                Print #1, "URL=" + lib_downloadsource
                        Close #1
                        Shell "explorer " + lib_downloadsource
                End If
                Exit All
        End If

End Sub
'---------------------------------------------------------------------
Sub ShowHelp (lib_name As String)

        Dim lib_filename As String, lib_extension() As Variant, lib_index As Integer

        lib_extension = Array("htm", "html", "txt", "rtf", "doc", "hlp", "pdf", "")

        lib_index = 0
        Do
                    lib_filename = Dir$(GetMacroPath + "\*" + lib_name + "." + lib_extension(lib_index))
                    lib_index = lib_index + 1
        Loop Until (lib_filename <> "" Or lib_extension(lib_index) = "")
	lib_filename = GetMacroPath + "\" + lib_filename 

        Start lib_filename

End Sub
'-----------------------------------------------------------------------------------------------------------------------------

Function GetString(lib_application As String, lib_section As String, lib_key As String, lib_default As String) As String

        Dim lib_dummy As String

        lib_dummy = GetSetting(lib_application, lib_section, lib_key)
        GetString = IIf(lib_dummy <> "", lib_dummy, lib_default)

End Function

'-----------------------------------------------------------------------------------------------------------------------------

Function GetRegDouble(lib_application As String, lib_section As String, lib_key As String, lib_default As Integer) As Double

        Dim lib_dummy As String

        lib_dummy  = GetSetting(lib_application, lib_section, lib_key)
        GetRegDouble = IIf(lib_dummy <> "", RealVal(lib_dummy), lib_default)

End Function

'-----------------------------------------------------------------------------------------------------------------------------

Sub SaveString(lib_application As String, lib_section As String, lib_key As String, lib_value As String)

        SaveSetting lib_application, lib_section, lib_key, lib_value

End Sub

'-----------------------------------------------------------------------------------------------------------------------------

Sub SaveInteger(lib_application As String, lib_section As String, lib_key As String, lib_value As Integer)

        SaveSetting lib_application, lib_section, lib_key, CStr(lib_value)

End Sub

'-----------------------------------------------------------------------------------------------------------------------------
Function Pretty(x As Variant) As String

        Pretty = Replace(Left$(IIf(Left$(CStr(x), 1) = "-", "", " ") + CStr(x) + String$(16, 32), 24) + Chr$(9), ",", ".")

End Function
'--------------------------------------------------------------------------------------------
Function Pretty2(x As Variant, length As Integer) As String

	Select Case Left$(CStr(x), 1)
		Case "0" To "9"
	        Pretty2 = Left$(" " + CStr(x) + String$(length, 32), length)
		Case Else		     
	        Pretty2 = Left$(CStr(x) + String$(length, 32), length)
	End Select
				
End Function
Function CST_Print(variant_cst As Variant, ncharlen_cst As Integer) As String

	' this function prints the variant with ncharlen characters, and tries to make this as flexible as possible
	' there are short functions PP4, PP6, ...., PP30 (also PP15L, ) to have nice tabulated formats in txt-files

	Dim stmp_cst1 As String, stmp_cst2 As String, islen_cst As Integer

	stmp_cst1 = CStr(variant_cst)
	islen_cst = Len(stmp_cst1)

	If (islen_cst > ncharlen_cst-1) Then
		If (IsNumeric(variant_cst)) Then
			If (ncharlen_cst<9) Then
				' number cannot be displayed completely
				stmp_cst2 = " " + Left(stmp_cst1,ncharlen_cst-2) + "x"
			Else
				stmp_cst2 = " " + IIf(variant_cst < 0,""," ") + Replace(Format(variant_cst,"0.0"+Left("0000000000000000000",ncharlen_cst-9)+"E+00"),",",".")
			End If
		Else
			stmp_cst2= " " + Left(stmp_cst1,ncharlen_cst-1)
		End If
	Else
		stmp_cst2 = Left("                                     ", ncharlen_cst-islen_cst) + stmp_cst1
	End If

	CST_Print = stmp_cst2

End Function
Function PP4(variant_cst As Variant) As String
	PP4 = CST_Print(variant_cst, 4)
End Function

Function PP5(variant_cst As Variant) As String
	PP5 = CST_Print(variant_cst, 5)
End Function

Function PP6(variant_cst As Variant) As String
