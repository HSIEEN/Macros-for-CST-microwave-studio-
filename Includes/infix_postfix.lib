'Public Const lib_rundef = -1.234567e-27
Sub Main_LIB

	' Test function

	Dim Infix As String
	Dim Postfix As String
	Dim VBA As String

	ShowSupportedOperators()
	Infix = InputBox("Please enter an infix expression:")
	Postfix = InfixToPostfix(Infix)
	VBA = PostfixToVBA_1DC(Postfix)

	MsgBox("Infix: " + Infix + vbNewLine _
			+ "Postfix: "+ Postfix + vbNewLine _
			+ "VBA: " + vbNewLine + VBA)

End Sub

Sub ShowSupportedOperators(Optional sDataType As String)

	Dim SupportedOperators As String
	Dim i As Long, j As Long
	Dim sEnumeration As String ' enumeration of entries in current line (used to determine linebreak)

	If (sDataType = "" Or sDataType = "1DC") Then
		SupportedOperators = "Supported operators, functions, and constants (see help for more details): " + vbNewLine + vbNewLine + vbTab
		'For i = 0 To UBound(OperatorSet1DC)
		'	SupportedOperators = SupportedOperators + Split(OperatorSet1DC(i),"|")(0) + " (" + MapOperatorToCommand(Split(OperatorSet1DC(i),"|")(0)) + "), "  +vbTab+ CStr(GetOperatorArity(Split(OperatorSet1DC(i),"|")(0))) + " argument(s)." +vbNewLine
		'Next
		'SupportedOperators = SupportedOperators  + vbNewLine
		'For i = 0 To UBound(FunctionSet1DC)
		'	SupportedOperators = SupportedOperators  + Split(FunctionSet1DC(i),"|")(0) + ", "  +vbTab + CStr(GetFunctionArity(Split(FunctionSet1DC(i),"|")(0))) + " argument(s)." +vbNewLine
		'Next
		sEnumeration = ""
		For i = 0 To UBound(OperatorSet1DC)
			sEnumeration = sEnumeration + Split(OperatorSet1DC(i),"|")(0) + " (" + MapOperatorToCommand(Split(OperatorSet1DC(i),"|")(0), sDataType) + ")" + IIf(i = UBound(OperatorSet1DC),"",", ")
			If ( Len(sEnumeration) > 40 ) Then
				' add linebreak if a certain number of characters is surpassed (and reset basis for counter of current line)
				SupportedOperators   = SupportedOperators + sEnumeration + vbNewLine + vbTab
				sEnumeration = ""
			End If
		Next
		SupportedOperators = SupportedOperators + sEnumeration + vbNewLine + vbNewLine + vbTab
		sEnumeration = ""
		For i = 0 To UBound(FunctionSet1DC)
			sEnumeration = sEnumeration  + Split(FunctionSet1DC(i),"|")(0) +"(#"
			For j = 1 To GetFunctionArity(Split(FunctionSet1DC(i),"|")(0), sDataType)-1
				sEnumeration = sEnumeration + sParaSep_LIB + "#"
			Next
			sEnumeration = sEnumeration + ")" + IIf(i = UBound(FunctionSet1DC),"",", ")
			If ( Len(sEnumeration) > 40 ) Then
				' add linebreak if a certain number of characters is surpassed (and reset basis for counter of current line)
				SupportedOperators   = SupportedOperators + sEnumeration + vbNewLine + vbTab
				sEnumeration = ""
			End If
		Next
		SupportedOperators = SupportedOperators + sEnumeration
	ElseIf (sDataType = "3D") Then
		SupportedOperators = "Supported operators, functions, and constants (see help for more details): " + vbNewLine + vbNewLine + vbTab
		'For i = 0 To UBound(OperatorSet3D)
		'	SupportedOperators = SupportedOperators + Split(OperatorSet3D(i),"|")(0) + " (" + MapOperatorToCommand(Split(OperatorSet3D(i),"|")(0), sDataType) + "), "  +vbTab+ CStr(GetOperatorArity(Split(OperatorSet3D(i),"|")(0))) + " argument(s)." +vbNewLine
		'Next
		'SupportedOperators = SupportedOperators  + vbNewLine
		'For i = 0 To UBound(FunctionSet3D)
		'	SupportedOperators = SupportedOperators  + Split(FunctionSet3D(i),"|")(0) + ", "  +vbTab + CStr(GetFunctionArity(Split(FunctionSet3D(i),"|")(0))) + " argument(s)." +vbNewLine
		'Next

		sEnumeration = ""
		For i = 0 To UBound(OperatorSet3D)
			sEnumeration = sEnumeration + Split(OperatorSet3D(i),"|")(0) + " (" + MapOperatorToCommand(Split(OperatorSet3D(i),"|")(0), sDataType) + ")" + IIf(i = UBound(OperatorSet3D),"",", ")
			If ( Len(sEnumeration) > 40 ) Then
				' add linebreak if a certain number of characters is surpassed (and reset basis for counter of current line)
				SupportedOperators   = SupportedOperators + sEnumeration + vbNewLine + vbTab
				sEnumeration = ""
			End If
		Next
		SupportedOperators = SupportedOperators + sEnumeration + vbNewLine + vbNewLine + vbTab
		sEnumeration = ""
		For i = 0 To UBound(FunctionSet3D)
			sEnumeration = sEnumeration  + Split(FunctionSet3D(i),"|")(0) +"(#"
			For j = 1 To GetFunctionArity(Split(FunctionSet3D(i),"|")(0), sDataType)-1
				sEnumeration = sEnumeration + sParaSep_LIB + "#"
			Next
			sEnumeration = sEnumeration + ")" + IIf(i = UBound(FunctionSet3D),"",", ")
			If ( Len(sEnumeration) > 40 ) Then
				' add linebreak if a certain number of characters is surpassed (and reset basis for counter of current line)
				SupportedOperators   = SupportedOperators + sEnumeration + vbNewLine + vbTab
				sEnumeration = ""
			End If
		Next
	End If
	SupportedOperators   = SupportedOperators + sEnumeration + vbNewLine + vbNewLine + vbTab
	sEnumeration = ""
	For i = 0 To UBound(ConstantSet)
		If (Split(ConstantSet(i),"|")(0) <> "Mue0") Then ' hide legacy Mue0
			If (Split(ConstantSet(i),"|")(0) <> "QElementary") Then ' hide legacy QElementary
				If (Split(ConstantSet(i),"|")(0) <> "QElectron") Then ' hide legacy QElectron
					If (Split(ConstantSet(i),"|")(0) <> "MElectron") Then ' hide legacy MElectron
						If (Split(ConstantSet(i),"|")(0) <> "MProton") Then ' hide legacy MProton
							If (Split(ConstantSet(i),"|")(0) <> "kBoltzmann") Then ' hide legacy kBoltzmann
								sEnumeration = sEnumeration + Split(ConstantSet(i),"|")(0) + IIf(i = UBound(ConstantSet),"",", ")
								'SupportedOperators   = SupportedOperators  + Split(ConstantSet(i),"|")(0) + IIf(i = UBound(ConstantSet),"",", ")
							End If
						End If
					End If
				End If
			End If
		End If
		If ( Len(sEnumeration) > 40 ) Then
			' add linebreak if a certain number of characters is surpassed (and reset basis for counter of current line)
			SupportedOperators   = SupportedOperators + sEnumeration + vbNewLine + vbTab
			sEnumeration = ""
		End If
	Next i
	SupportedOperators   = SupportedOperators + sEnumeration
	MsgBox(SupportedOperators,"List of supported operators, functions, and constants")
End Sub

Function InfixToPostfix(Infix As String, Optional sDataType As String) As String

	' Operators have to consist of exactly one character, names of variables must have identical length, given by VarNameLength

	Dim Stack() As String
	Dim Postfix() As String
	Dim ParsedItem As String
	Dim ParsedItemLength As Integer
	Dim i As Integer, j As Integer, offset As Integer
	Dim nOpenBrackets As Integer, nOpenInternalBrackets As Integer, nFunctionParameters As Integer, bFunctionFormatCorrect As Boolean
	Dim PostfixCheck() As String, nArityCheck As Integer

	ReDim Postfix(0)
	ReDim Stack(0)

	If Infix = "" Then
		InfixToPostfix = ""
		Exit Function
	End If

	InfixToPostfix = ""
	nOpenBrackets = 0

	' Wrap infix in parentheses, exchange "-" where it means "negative", not "minus" (and equivalent for "+")
	Infix = "(" + Infix + ")"
	Infix = Replace(Infix,"(-","((0-1)*",1,-1)
	Infix = Replace(Infix,"(+","((0+1)*",1,-1)
	Infix = Replace(Infix,",-",",(0-1)*",1,-1)
	Infix = Replace(Infix,",+",",(0+1)*",1,-1)

	For i = 1 To Len(Infix)
		ParsedItemLength = GetNextItemLength(Infix,i)
		If (ParsedItemLength = -1) Then ' Something went wrong
			InfixToPostfix = InfixToPostfix + " error"
			Exit Function
		End If
		ParsedItem = GetNextItem(Infix,i)
		'ReportInformationToWindow(ParsedItem)
		' FSR: A test:
		If (Len(ParsedItem) <> ParsedItemLength) Then ReportWarning("ParsedItemLength <> Len(ParsedItem). This causes no errors but should not have happened.")
		' FSR end test
		If (IsPostfixToVBAOperator(ParsedItem, sDataType) Or IsPostfixToVBAFunction(ParsedItem, sDataType)) Then ' parsed item is in operator or function set
			' For functions: Check if number of parameters is correct
			If IsPostfixToVBAFunction(ParsedItem, sDataType) Then
				nFunctionParameters = 0
				offset = i + ParsedItemLength
				bFunctionFormatCorrect = True ' Assume that the format is correct
				bFunctionFormatCorrect = (GetNextItem(Infix, offset) = "(") ' first item after function should be "("
				offset = offset + 1
				nOpenInternalBrackets = 0 ' Number of open parentheses within the function parameter list
				' Next there should be (Arity-1) occurrences of sParaSep_LIB
				While ((offset < Len(Infix) And ((GetNextItem(Infix, offset) <> ")") Or (nOpenInternalBrackets >= 1))))
					'ReportInformationToWindow(GetNextItem(Infix, offset))
					If GetNextItem(Infix, offset) = "(" Then
						nOpenInternalBrackets = nOpenInternalBrackets + 1
					ElseIf GetNextItem(Infix, offset) = ")" Then
						nOpenInternalBrackets = nOpenInternalBrackets - 1
					End If
					' only count sParaSep_LIBs while nOpenInternalBrackets = 0; otherwise, sParaSep_LIB most likely belongs to a nested function
					nFunctionParameters = nFunctionParameters + IIf((GetNextItem(Infix, offset) = sParaSep_LIB) And (nOpenInternalBrackets = 0), 1, 0)
					offset = offset + GetNextItemLength(Infix, offset)
				Wend
				bFunctionFormatCorrect = bFunctionFormatCorrect And (nFunctionParameters = GetFunctionArity(ParsedItem, sDataType)-1) And (nOpenInternalBrackets = 0)
				If Not bFunctionFormatCorrect Then
					ReportError(ParsedItem + " requires " + CSTr(GetFunctionArity(ParsedItem, sDataType)) _
								+ IIf(GetFunctionArity(ParsedItem, sDataType)=1, " parameter.", " parameters, separated by '"+sParaSep_LIB+"'.") _
								+ " Please check expression.")
				End If
			End If
			If ((UBound(Stack)>0) And (Priority(ParsedItem, sDataType) <= Priority(Stack(UBound(Stack)), sDataType))) Then ' Operator with higher or equal priority lies on top of stack
				' Move operator from top of stack to postfix
				ReDim Preserve Postfix(UBound(Postfix)+1)
				Postfix(UBound(Postfix)) = Stack(UBound(Stack))
				ReDim Preserve Stack(UBound(Stack)-1)
				' decrease i to keep current ParsedItem, to be compared with next item on top of stack
				i = i-ParsedItemLength
			Else ' Operator with lower priority lies on top of stack
				' Put new operator on top of stack
				ReDim Preserve Stack(UBound(Stack)+1)
				Stack(UBound(Stack))=ParsedItem
			End If
		ElseIf IsPostfixToVBANumeric(ParsedItem, sDataType) Then ' parsed item is a number
			' What to do with numbers? Add to postfix for now
			ReDim Preserve Postfix(UBound(Postfix)+1)
			Postfix(UBound(Postfix))=ParsedItem
			' Next item has to be an operator, sParaSep_LIB, or parenthesis
			If (Not IsPostfixToVBAOperator(GetNextItem(Infix, i+ParsedItemLength), sDataType) And GetNextItem(Infix, i+ParsedItemLength)<>sParaSep_LIB And InStr("()",GetNextItem(Infix,i+ParsedItemLength))=0) Then
				ReportError("Mix Template Results: Could not find proper operator after numerical expression '"+ParsedItem+"'. Please check expression.")
			End If
		ElseIf (ParsedItem = "(") Then
			' Put on top of stack
			ReDim Preserve Stack(UBound(Stack)+1)
			Stack(UBound(Stack))=ParsedItem
			nOpenBrackets = nOpenBrackets+1
		ElseIf (ParsedItem = ")") Then
			While ((Stack(UBound(Stack)) <> "(") And (UBound(Stack) > 0))
				' Take item from top of stack, add to postfix, shorten stack
				ReDim Preserve Postfix(UBound(Postfix)+1)
				Postfix(UBound(Postfix)) = Stack(UBound(Stack))
				ReDim Preserve Stack(UBound(Stack)-1)
			Wend
			If nOpenBrackets <= 0 Then
				ReportError("Invalid expression, check parentheses!")
			Else
				' Remove "(" now as well
				ReDim Preserve Stack(UBound(Stack)-1)
				nOpenBrackets = nOpenBrackets-1
			End If
		ElseIf (ParsedItem = sParaSep_LIB) Then ' similar to closing parenthesis, but no open parenthesis to remove
			While ((Stack(UBound(Stack)) <> "(") And (Stack(UBound(Stack)) <> sParaSep_LIB) And (UBound(Stack) > 0))
				' Take item from top of stack, add to postfix, shorten stack
				ReDim Preserve Postfix(UBound(Postfix)+1)
				Postfix(UBound(Postfix)) = Stack(UBound(Stack))
				ReDim Preserve Stack(UBound(Stack)-1)
			Wend
		Else ' Item is a variable
			ReDim Preserve Postfix(UBound(Postfix)+1)
			Postfix(UBound(Postfix))=ParsedItem
		End If
		i = i + ParsedItemLength - 1
	Next i
	' Move all remaining items in stack to postfix
	While (UBound(Stack) > 0)
		ReDim Preserve Postfix(UBound(Postfix)+1)
		Postfix(UBound(Postfix)) = Stack(UBound(Stack))
		ReDim Preserve Stack(UBound(Stack)-1)
	Wend

	If nOpenBrackets <> 0 Then ReportError("Invalid expression, check parentheses!")

	InfixToPostfix = Mid(Join(Postfix,"|"),2,Len(Join(Postfix,"|"))-1) ' Strip first "|"
	'ReportInformationToWindow(InfixToPostfix)

	' Quick check on general format errors in Postfix expression:
	' Find first operator, check arity, and replace Operator + Arity * Number of Operands by "X"
	' Continue until no more operators exist. The resulting expression should be "X"
	PostfixCheck = Split(InfixToPostfix, "|")
	If (IsPostfixToVBAFunction(PostfixCheck(0), sDataType) Or IsPostfixToVBAOperator(PostfixCheck(0), sDataType)) Then
		' First item should not be a function or operator
		ReportError("Problem converting expression '" & Infix & "'. Please check expression.")
	ElseIf (UBound(PostfixCheck) = 0) Then
		' Only a single entry, and it is not a function or operator, OK
		PostfixCheck(0) = "X"
	Else
		' Full expression, carry out pseudo evaluation to make sure that number of functions/operators aligns with inputs
		i = 0
		While (i <= UBound(PostfixCheck))
			If (IsPostfixToVBAFunction(PostfixCheck(i), sDataType) Or IsPostfixToVBAOperator(PostfixCheck(i), sDataType)) Then
				nArityCheck = GetArity_LIB(PostfixCheck(i), sDataType)
				If (nArityCheck > i) Then
					ReportError("Problem converting expression '" & Infix & "'. Please check expression.")
				Else
					PostfixCheck(i - nArityCheck) = "X"
					For j = i + 1 To UBound(PostfixCheck)
						PostfixCheck(j - nArityCheck) = PostfixCheck(j)
					Next
					ReDim Preserve PostfixCheck(UBound(PostfixCheck) - nArityCheck)
					i = i - nArityCheck
				End If
			Else
				i = i + 1
			End If
		Wend
	End If
	If ((UBound(PostfixCheck) <> 0) Or (PostfixCheck(0) <> "X")) Then ReportError("Problem converting expression '" & Infix & "'. Please check expression.")

End Function

Function PostfixToVBA_1DC(Postfix As String) As String

	Dim ParsedItem As String
	Dim ParsedItemLength As Integer
	Dim Arity As Integer, ParsedCommand As String, FullCommand As String
	Dim NonNumReference As String, Operand As String
	Dim i As Integer, j As Integer
	Dim Stack() As String
	Dim sTemp As String
	ReDim Stack(0)

	If Postfix = "" Then
		PostfixToVBA_1DC = ""
		Exit Function
	End If

	' Parse postfix expression once to find first non-numeric object to use as reference (.MakeCompatibleTo) for numeric objects
	NonNumReference = "GetRes1DComplexFrom1DCNumeric(0,0)" ' default in case all items are numeric
	For i = 1 To Len(Postfix)
		ParsedItemLength = GetNextItemLength(Postfix, i)
		If (ParsedItemLength = -1) Then ' Something went wrong
			PostfixToVBA_1DC = PostfixToVBA_1DC + " error"
			Exit Function
		End If
		ParsedItem = Mid(Postfix,i,ParsedItemLength)
		If (Is1DCVariable(ParsedItem)) Then
			NonNumReference = ParsedItem
			' First non-numeric, non-operator, non-function variable has been found
			Exit For
		End If
		i = i+ParsedItemLength
	Next

	For i = 1 To Len(Postfix)
		FullCommand = ""
		ParsedItemLength = GetNextItemLength(Postfix, i)
		If (ParsedItemLength = -1) Then ' Something went wrong
			PostfixToVBA_1DC = PostfixToVBA_1DC + " error"
			Exit Function
		End If
		ParsedItem = GetNextItem(Postfix,i)
		' FSR: A test:
		If (Len(ParsedItem) <> ParsedItemLength) Then ReportWarning("ParsedItemLength <> Len(ParsedItem). This causes no errors but should not have happened.")
		If (Is1DCOperator(ParsedItem) Or Is1DCFunction(ParsedItem)) Then ' parsed item is an operator or a function
			ParsedCommand = IIf(Is1DCOperator(ParsedItem),MapOperatorToCommand(ParsedItem),MapFunctionToCommand(ParsedItem))
			Arity = IIf(Is1DCOperator(ParsedItem),GetOperatorArity(ParsedItem),GetFunctionArity(ParsedItem))
			'Check if any of the operands involved are numeric. If so, create corresponding complex 1D object, (skip last operand if operator is NthPower)
			For j = 1 To Arity
				Operand = Stack(UBound(Stack)-Arity+j)
				If Is1DCNumeric(Operand) Then
					FullCommand = FullCommand + "Dim NumObject_"+Cstr(i)+"_"+Cstr(j)+" As Object" + vbNewLine
					FullCommand = FullCommand + "Set NumObject_"+Cstr(i)+"_"+Cstr(j)+" = GetRes1DComplexFrom1DCNumeric("+IIf(Operand="j","0,1",Operand+",0")+",callingApp)" + vbNewLine
					Stack(UBound(Stack)-Arity+j) = "NumObject_"+Cstr(i)+"_"+Cstr(j)
					FullCommand = FullCommand + "NumObject_"+Cstr(i)+"_"+Cstr(j)+".MakeCompatibleTo("+NonNumReference+")"+vbNewLine
				End If
			Next
			' Put together the VBA command line:
			' Remove (Arity-1) items from stack and use operator, put result on top of stack
			FullCommand = FullCommand + "Dim TmpResult_"+Cstr(i)+" As Object" + vbNewLine
			FullCommand = FullCommand + "Set TmpResult_"+Cstr(i)+" = " + Stack(UBound(Stack)-Arity+1) + ".Copy()" + vbNewLine
			If Is1DCOperator(ParsedItem) Then
				FullCommand = FullCommand + "TmpResult_"+Cstr(i) + "." + ParsedCommand + "("
				For j = 2 To Arity
					FullCommand = FullCommand + IIf(j>2,",","") + Stack(UBound(Stack)-Arity+j)
				Next
				FullCommand = FullCommand + ")" + vbNewLine
			Else ' it's a function
				FullCommand = FullCommand + ParsedCommand + "(TmpResult_"+Cstr(i)
				For j = 2 To Arity
					FullCommand = FullCommand + "," + Stack(UBound(Stack)-Arity+j)
				Next
				FullCommand = FullCommand + ")" + vbNewLine
			End If
			' command line for one operation complete
			Stack(UBound(Stack)-Arity+1) = "TmpResult_"+Cstr(i)
			PostfixToVBA_1DC = PostfixToVBA_1DC + FullCommand
			Stack(UBound(Stack)-Arity+1) = "TmpResult_"+Cstr(i)
			ReDim Preserve Stack(UBound(Stack)-Arity+1)
		ElseIf (Is1DCVariable(ParsedItem) Or Is1DCNumeric(ParsedItem)) Then
			ReDim Preserve Stack(UBound(Stack)+1)
			Stack(UBound(Stack))=ParsedItem
		ElseIf (Is1DCConstant(ParsedItem)) Then
			ReDim Preserve Stack(UBound(Stack)+1)
			Stack(UBound(Stack))=MapConstantNameToValue(ParsedItem)
		ElseIf (Is1DCParameter(ParsedItem)) Then
			ReDim Preserve Stack(UBound(Stack)+1)
			' Newer template versions might store parameter values for a given run ID. If those exist, use them. Otherwise, use current parameter value
			sTemp = GetScriptSetting("Para_" & ParsedItem, "VOID")
			' fsr 10/20/2011: Evaluate returns commas for some locales, make sure to replace these with full stops
			Stack(UBound(Stack))=Replace(Evaluate(IIf(sTemp = "VOID", ParsedItem, sTemp)),",",".")
		Else ' unknown parameter/variable
			ReportError("Cannot find parameter '"+ParsedItem+"', please check expression!")
			Stack(UBound(Stack))=CStr(0)
		End If
		i = i+ParsedItemLength
	Next
	If Is1DCNumeric(Stack(UBound(Stack))) Then ' happens if no operator has been entered
		'callingApp is used to determine if MWS or DS is used
		PostfixToVBA_1DC = PostfixToVBA_1DC + "Set TmpResult_Final = GetRes1DComplexFrom1DCNumeric(" + IIf(Stack(UBound(Stack))="j","0,1",Stack(UBound(Stack))+",0")+",callingApp)"+ vbNewLine
	Else
		PostfixToVBA_1DC = PostfixToVBA_1DC + "Set TmpResult_Final = " + Stack(UBound(Stack)) + vbNewLine
	End If

End Function

Function PostfixToVBA_3D(Postfix As String) As String

	Dim ParsedItem As String, sTempItem As String
	Dim ParsedItemLength As Integer
	Dim Arity As Integer, ParsedCommand As String, FullCommand As String
	Dim NonNumReference As String, Operand As String
	Dim i As Integer, j As Integer
	Dim Stack() As String
	Dim sTemp As String
	ReDim Stack(0)

	If Postfix = "" Then
		PostfixToVBA_3D = ""
		Exit Function
	End If
	NonNumReference = "GetRes1DComplexFrom1DCNumeric(0,0)" ' a 1DC reference object

	For i = 1 To Len(Postfix)
		FullCommand = ""
		ParsedItemLength = GetNextItemLength(Postfix, i)
		If (ParsedItemLength = -1) Then ' Something went wrong
			PostfixToVBA_3D = PostfixToVBA_3D + " error"
			Exit Function
		End If
		ParsedItem = GetNextItem(Postfix,i)
		If (IsPostfixToVBAOperator(ParsedItem, "3D") Or IsPostfixToVBAFunction(ParsedItem, "3D")) Then ' parsed item is an operator or a function
			ParsedCommand = IIf(IsPostfixToVBAOperator(ParsedItem, "3D"),MapOperatorToCommand(ParsedItem, "3D"),MapFunctionToCommand(ParsedItem, "3D"))
			Arity = IIf(IsPostfixToVBAOperator(ParsedItem, "3D"),GetOperatorArity(ParsedItem, "3D"),GetFunctionArity(ParsedItem, "3D"))
			'Check if any of the operands involved are numeric. If so, create corresponding double variable
			For j = 1 To Arity
				' check order of operands for scalar mult and div
				If (UBound(Stack)>0) Then
					If ((ParsedCommand = "ScalarMult") And IsPostfixToVBANumeric(Stack(UBound(Stack)-1), "3D") And (Not IsPostfixToVBANumeric(Stack(UBound(Stack)), "3D"))) Then
						' swap such that 2nd operand in scalar mult is numeric
						sTempItem = Stack(UBound(Stack)-1)
						Stack(UBound(Stack)-1) = Stack(UBound(Stack))
						Stack(UBound(Stack)) = sTempItem
					ElseIf ((ParsedCommand = "ScalarDiv") And IsPostfixToVBANumeric(Stack(UBound(Stack)-1), "3D") And (Not IsPostfixToVBANumeric(Stack(UBound(Stack)), "3D"))) Then
						ReportError("Mix 3D Fields: Division currently does not support 3D fields or functions in denominator, please check expression. In case of multiple factors in the denominator, rewrite in form of multiple divisions.")
					End If
				End If
				Operand = Stack(UBound(Stack)-Arity+j)
				If IsPostfixToVBANumeric(Operand, "3D") Then
					FullCommand = FullCommand + "Dim NumObject_"+Cstr(i)+"_"+Cstr(j)+" As Object" + vbNewLine
					FullCommand = FullCommand + "Set NumObject_"+Cstr(i)+"_"+Cstr(j)+" = GetRes1DComplexFrom1DCNumeric("+IIf(Operand="j","0,1",Operand+",0")+",callingApp)" + vbNewLine
					Stack(UBound(Stack)-Arity+j) = "NumObject_"+Cstr(i)+"_"+Cstr(j)
					FullCommand = FullCommand + "NumObject_"+Cstr(i)+"_"+Cstr(j)+".MakeCompatibleTo("+NonNumReference+")"+vbNewLine
				End If
			Next
			' Put together the VBA command line:
			' Remove (Arity-1) items from stack and use operator, put result on top of stack
			FullCommand = FullCommand + "Dim TmpResult_" & Cstr(i) & " As Object" & vbNewLine
			FullCommand = FullCommand + "Set TmpResult_" & CStr(i) & " = " & Stack(UBound(Stack)-Arity+1) & ".Copy()" & vbNewLine'
			If IsPostfixToVBAOperator(ParsedItem, "3D") Then
				' Special handling of scalar mult and power, make it complex!
				If (ParsedCommand = "ScalarMult") Then
					FullCommand = FullCommand & "ComplexScalarMult3D(TmpResult_"+Cstr(i) & "," & Stack(UBound(Stack)) & ")" & vbNewLine
				ElseIf (ParsedCommand = "ScalarDiv") Then
					FullCommand = FullCommand & "ComplexScalarDiv3D(TmpResult_"+Cstr(i) & "," & Stack(UBound(Stack)) & ")" & vbNewLine
				ElseIf (ParsedCommand = "Pow") Then
					FullCommand = FullCommand & "ComplexPower3D(TmpResult_"+Cstr(i) & "," & Stack(UBound(Stack)) & ")" & vbNewLine
				Else
					If ((ParsedCommand = "Add") Or (ParsedCommand = "Subtract")) Then
						' When trying to add/subtract a constant numeric value to/from field, upgrade numeric value to constant field
						' This is not needed in 1DC version where all variables are upgraded to highest complexity (1DC) from the start, which is not feasible for fields
						' Only valid for constant (complex) scalar fields
						FullCommand = FullCommand & "If ((TmpResult_" & Cstr(i) & ".GetResultObjectType() = ""1DC"") And (" & Stack(UBound(Stack)) & ".GetResultObjectType() = ""3D"")) Then" & vbNewLine
						FullCommand = FullCommand & vbTab & "Set TmpResult_" & Cstr(i) & " = ConstScalarField3D(" & Stack(UBound(Stack)) & ".Copy(), TmpResult_" & Cstr(i) & ")" & vbNewLine
						FullCommand = FullCommand & "ElseIf ((TmpResult_" & Cstr(i) & ".GetResultObjectType() = ""3D"") And (" & Stack(UBound(Stack)) & ".GetResultObjectType() = ""1DC"")) Then" & vbNewLine
						FullCommand = FullCommand & vbTab & "Set " & Stack(UBound(Stack)) & " = ConstScalarField3D(TmpResult_" & Cstr(i) & ".Copy(), " & Stack(UBound(Stack)) & ")" & vbNewLine
						FullCommand = FullCommand & "End If" & vbNewLine
					End If
					FullCommand = FullCommand & "TmpResult_" & Cstr(i) & "." + ParsedCommand & "("
					For j = 2 To Arity
						FullCommand = FullCommand + IIf(j>2,",","") + Stack(UBound(Stack)-Arity+j)
					Next
					FullCommand = FullCommand + ")" + vbNewLine
				End If
			Else ' it's a function
				FullCommand = FullCommand + ParsedCommand + "(TmpResult_"+Cstr(i)
				For j = 2 To Arity
					FullCommand = FullCommand + "," + Stack(UBound(Stack)-Arity+j)
				Next
				FullCommand = FullCommand + ")" + vbNewLine
			End If
			' command line for one operation complete
			Stack(UBound(Stack)-Arity+1) = "TmpResult_"+Cstr(i)
			PostfixToVBA_3D = PostfixToVBA_3D + FullCommand
			Stack(UBound(Stack)-Arity+1) = "TmpResult_"+Cstr(i)
			ReDim Preserve Stack(UBound(Stack)-Arity+1)
		ElseIf (IsPostfixToVBAVariable(ParsedItem, "3D") Or IsPostfixToVBANumeric(ParsedItem, "3D")) Then
			ReDim Preserve Stack(UBound(Stack)+1)
			Stack(UBound(Stack))=ParsedItem
		ElseIf (IsPostfixToVBAConstant(ParsedItem, "3D")) Then
			ReDim Preserve Stack(UBound(Stack)+1)
			Stack(UBound(Stack))=MapConstantNameToValue(ParsedItem)
		ElseIf (IsPostfixToVBAParameter(ParsedItem, "3D")) Then
			ReDim Preserve Stack(UBound(Stack)+1)
			' Newer template versions might store parameter values for a given run ID. If those exist, use them. Otherwise, use current parameter value
			sTemp = GetScriptSetting("Para_" & ParsedItem, "VOID") ' Not active for Mix 3D as of 10/28/2019, should return empty string and thus go into regular branch
			' fsr 10/20/2011: Evaluate returns commas for some locales, make sure to replace these with full stops
			Stack(UBound(Stack))=Replace(Evaluate(IIf(sTemp = "VOID", ParsedItem, sTemp)),",",".")
		Else ' unknown parameter/variable
			ReportError("Cannot find parameter '"+ParsedItem+"', please check expression!")
			Stack(UBound(Stack))=CStr(0)
		End If
		i = i+ParsedItemLength
	Next
'	If IsPostfixToVBANumeric(Stack(UBound(Stack)), "3D") Then ' happens if no operator has been entered
'		ReportError("PostfixToVBA_3D: Numeric operand found, not yet implemented.")
'		'callingApp is used to determine if MWS or DS is used
'		PostfixToVBA_3D = PostfixToVBA_3D + "Set TmpResult_Final = GetRes1DComplexFrom1DCNumeric(" + IIf(Stack(UBound(Stack))="j","0,1",Stack(UBound(Stack))+",0")+",callingApp)"+ vbNewLine
'	Else
		PostfixToVBA_3D = PostfixToVBA_3D + "Set TmpResult_Final = " + Stack(UBound(Stack)) + vbNewLine
'	End If

End Function

Function Priority(Operator As String, Optional sDataType As String) As Integer

	Dim i As Integer, sOperatorSet As Variant

	If (sDataType = "" Or sDataType = "1DC") Then
		sOperatorSet = OperatorSet1DC
	ElseIf (sDataType = "3D") Then
		sOperatorSet = OperatorSet3D
	End If

	Priority = -1 ' Default: Operator not found in set
	If (Operator <> "") Then
		If IsPostfixToVBAFunction(Operator, sDataType) Then
			Priority = UBound(sOperatorSet)+1 ' highest priority
		Else
			For i = 0 To UBound(sOperatorSet)
				If (Split(sOperatorSet(i),"|")(0) = Operator) Then
					Priority = i+1
					Exit Function
				End If
			Next i
		End If
	End If

End Function

Function MapOperatorToCommand(Operator As String, Optional sDataType As String) As String

	Dim i As Integer, sOperatorSet As Variant

	If (sDataType = "" Or sDataType = "1DC") Then
		sOperatorSet = OperatorSet1DC
	ElseIf (sDataType = "3D") Then
		sOperatorSet = OperatorSet3D
	End If

	MapOperatorToCommand = "invalidOperator"
	If (Operator <> "") Then
		For i = 0 To UBound(sOperatorSet)
			If (Split(sOperatorSet(i),"|")(0) = Operator) Then
				MapOperatorToCommand = Split(sOperatorSet(i),"|")(1)
				Exit Function
			End If
		Next i
	End If

End Function

Function MapFunctionToCommand(Query As String, Optional sDataType As String) As String

	Dim i As Integer, sFunctionSet As Variant

	If (sDataType = "" Or sDataType = "1DC") Then
		sFunctionSet = FunctionSet1DC
	ElseIf (sDataType = "3D") Then
		sFunctionSet = FunctionSet3D
	End If

	MapFunctionToCommand = "invalidOperator"
	If (Query <> "") Then
		For i = 0 To UBound(sFunctionSet)
			If (LCase(Split(sFunctionSet(i),"|")(0)) = LCase(Query)) Then
				MapFunctionToCommand = Split(sFunctionSet(i),"|")(1)
				Exit Function
			End If
		Next i
	End If

End Function

Function MapConstantNameToValue(Query As String) As String

	Dim i As Integer

	MapConstantNameToValue = "ivalidConstant"
	If (Query <> "") Then
		For i = 0 To UBound(ConstantSet)
			If (LCase(Split(ConstantSet(i),"|")(0)) = LCase(Query)) Then
				MapConstantNameToValue = Replace(Evaluate(Split(ConstantSet(i),"|")(1)),",",".")
				Exit Function
			End If
		Next i
	End If

End Function

Function GetOperatorArity(Operator As String, Optional sDataType As String) As Integer

	Dim i As Integer, sOperatorSet As Variant

	If (sDataType = "" Or sDataType = "1DC") Then
		sOperatorSet = OperatorSet1DC
	ElseIf (sDataType = "3D") Then
		sOperatorSet = OperatorSet3D
	End If

	GetOperatorArity = -1
	If (Operator <> "") Then
		For i = 0 To UBound(sOperatorSet)
			If (Split(sOperatorSet(i),"|")(0) = Operator) Then
				GetOperatorArity = Evaluate(Split(sOperatorSet(i),"|")(2))
				Exit Function
			End If
		Next i
	End If

End Function

Function GetArity_LIB(Query As String, sDataType As String) As Integer

	If IsPostfixToVBAFunction(Query, sDataType) Then
		GetArity_LIB = GetFunctionArity(Query, sDataType)
	ElseIf IsPostfixToVBAOperator(Query, sDataType) Then
		GetArity_LIB = GetOperatorArity(Query, sDataType)
	Else
		ReportError("infix_postfix:GetArity: Query is neither a function nor an operator")
	End If

End Function

Function GetFunctionArity(Query As String, Optional sDataType As String) As Integer

	Dim i As Integer, sFunctionSet As Variant

	If (sDataType = "" Or sDataType = "1DC") Then
		sFunctionSet = FunctionSet1DC
	ElseIf (sDataType = "3D") Then
		sFunctionSet = FunctionSet3D
	End If

	GetFunctionArity = -1
	If (Query <> "") Then
		For i = 0 To UBound(sFunctionSet)
			If (LCase(Split(sFunctionSet(i),"|")(0)) = LCase(Query)) Then
				GetFunctionArity = Evaluate(Split(sFunctionSet(i),"|")(2))
				Exit Function
			End If
		Next i
	End If

End Function

Function Is1DCNumeric(Query As String) As Boolean
	Is1DCNumeric = IsPostfixToVBANumeric(Query, "1DC") ' bwc
End Function

Function IsPostfixToVBANumeric(Query As String, sDataType As String) As Boolean

	' fsr 04-oct-2010: the line should remain removed, parameters should not be treated as numeric until further down in the conversion process
	' uncommenting this line causes problems with "ABCDEF" or parameter names that contain other parameter names
	'If (GetParameterIndex(Query)>-1) Then Query=Evaluate(Query)

	' fsr 11-jul-2014: Run test for IsNumeric always in US environment, reset before exiting function
	Dim iCurrentLocale As Long
	iCurrentLocale = GetLocale
	SetLocale(Val("&H0409"))

	If (Query="" Or InStr(Query, sParaSep_LIB)>0) Then
		IsPostfixToVBANumeric = False
	ElseIf ((IsNumeric(Query) And (Not IsPostfixToVBAOperator(Right$(Query,1), sDataType))) _
		Or Query="j" _
		Or (Left$(Query,1)="j" And IsNumeric(Right$(Query,Len(Query)-1))) _
		Or (Right$(Query,1)="j" And IsNumeric(Left$(Query,Len(Query)-1))) _
		Or Query="." _
		Or (Right$(Query,1)="e" And IsNumeric(Left$(Query,Len(Query)-1))) _
		Or (Right$(Query,1)="E" And IsNumeric(Left$(Query,Len(Query)-1))))Then
		IsPostfixToVBANumeric = True
	ElseIf (Len(Query)>2) Then
		If ((Right$(Query,2)="e-" And IsNumeric(Left$(Query,Len(Query)-2))) _
		Or (Right$(Query,2)="e+" And IsNumeric(Left$(Query,Len(Query)-2))) _
		Or (Right$(Query,2)="E-" And IsNumeric(Left$(Query,Len(Query)-2))) _
		Or (Right$(Query,2)="E+" And IsNumeric(Left$(Query,Len(Query)-2)))) Then
			IsPostfixToVBANumeric = True
		End If
	Else
		IsPostfixToVBANumeric = False
	End If

	' Reset locale
	SetLocale(iCurrentLocale)

End Function

Function GetParameterIndex(ParameterName As String) As Integer

	' Returns the index of the parameter "ParameterName", in particular it returns -1 if "ParameterName" does not exist
	Dim i As Long

	GetParameterIndex = -1
	For i = 0 To GetNumberOfParameters-1
		If (GetParameterName(i)=ParameterName) Then
			GetParameterIndex = i
			Exit Function
		End If
	Next

End Function

Function Is1DCOperator(Query As String) As Boolean
	Is1DCOperator = IsPostfixToVBAOperator(Query, "1DC")
End Function

Function IsPostfixToVBAOperator(Query As String, sDataType As String) As Boolean

	Dim i As Integer, sOperatorSet As Variant

	Select Case sDataType
		Case "", "1DC"
			sOperatorSet = OperatorSet1DC
		Case "3D"
			sOperatorSet = OperatorSet3D
	End Select

	IsPostfixToVBAOperator = False
	If (Query <> "") Then
		For i = 0 To UBound(sOperatorSet)
			If (Split(sOperatorSet(i),"|")(0) = Query) Then
				IsPostfixToVBAOperator = True
				Exit Function
			End If
		Next i
	End If

End Function

Function Is1DCFunction(Query As String) As Boolean
	Is1DCFunction = IsPostfixToVBAFunction(Query, "1DC")
End Function

Function IsPostfixToVBAFunction(Query As String, sDataType As String) As Boolean

	Dim i As Integer, sFunctionSet As Variant

	Select Case sDataType
		Case "", "1DC"
			sFunctionSet = FunctionSet1DC
		Case "3D"
			sFunctionSet = FunctionSet3D
	End Select

	IsPostfixToVBAFunction = False
	If (Query <> "") Then
		For i = 0 To UBound(sFunctionSet)
			' Ignore case when comparing with function set
			If (LCase(Split(sFunctionSet(i),"|")(0)) = LCase(Query)) Then
				IsPostfixToVBAFunction = True
				Exit Function
			End If
		Next i
	End If

End Function

Function Is1DCConstant(Query As String) As Boolean
	Is1DCConstant = IsPostfixToVBAConstant(Query, "1DC")
End Function

Function IsPostfixToVBAConstant(Query As String, sDataType As String) As Boolean

	' Returns the number where the constant is found in ConstantSet
	' If not found, return -1
	Dim i As Integer

	IsPostfixToVBAConstant = False
	If (Query <> "") Then
		For i = 0 To UBound(ConstantSet)
			' Ignore case when comparing with function set
			If (LCase(Split(ConstantSet(i),"|")(0)) = LCase(Query)) Then
				IsPostfixToVBAConstant = True
				Exit Function
			End If
		Next i
	End If

End Function

Function Is1DCParameter(Query As String) As Boolean
	Is1DCParameter = IsPostfixToVBAParameter(Query, "1DC")
End Function

Function IsPostfixToVBAParameter(Query As String, sDataType As String) As Boolean
	IsPostfixToVBAParameter = IIf(GetParameterIndex(Query)>-1, True, False)
End Function

Function Is1DCVariable(Query As String) As Boolean
	Is1DCVariable = IsPostfixToVBAVariable(Query, "1DC")
End Function

Function IsPostfixToVBAVariable(Query As String, sDataType As String) As Boolean

	IsPostfixToVBAVariable = IIf(Mid(Query,2) = "_cst_tmp", True, False)

	'OLD:
	' If last char is no operator, no function, not numeric, and does not contain "(",")", or "|", it is a variable
	'Is1DCVariable = IIf(Not(Is1DCNumeric(Query) _
	'						Or Is1DCOperator(Mid(Query,Len(Query),1)) _
	'						Or Is1DCFunction(Query) _
	'						Or Is1DCParameter(Query) _
	'						Or (InStr(Query,"(")>0) _
	'						Or (InStr(Query,")")>0) _
	'						Or (InStr(Query,"|")>0)),True,False)

End Function

Function GetNextItem(FullExpression As String, StartPosition As Integer) As String
	Dim NextItemLength As Long
	NextItemLength = GetNextItemLength(FullExpression, StartPosition)
	If (NextItemLength <> -1) Then
		GetNextItem = Mid(FullExpression,StartPosition,NextItemLength)
	Else
		GetNextItem = ""
	End If
End Function

Function GetNextItemLength(FullExpression As String, StartPosition As Integer, Optional sDataType As String) As Integer

	' Returns the length of the next item within FullExpression, starting at StartPosition
	Dim n As Integer
	Dim FirstCharacter As String

	If (sDataType = "") Then sDataType = "1DC" ' bwc

	n = 1
	FirstCharacter = Mid(FullExpression,StartPosition,1)

	If (FirstCharacter = "") Then ' something went wrong
		GetNextItemLength = -1
		Exit Function
	ElseIf ((FirstCharacter = "(") Or (FirstCharacter = ")") Or (FirstCharacter = sParaSep_LIB)) Then
		GetNextItemLength = 1
		Exit Function
	ElseIf (IsPostfixToVBANumeric(FirstCharacter, sDataType)) Then
		While (IsPostfixToVBANumeric(Mid(FullExpression,StartPosition,n), sDataType) And (n+StartPosition <= Len(FullExpression)+1))
			n = n+1
		Wend
		GetNextItemLength = n-1
		Exit Function
	ElseIf (IsPostfixToVBAOperator(FirstCharacter, sDataType)) Then
		While (IsPostfixToVBAOperator(Mid(FullExpression,StartPosition,n), sDataType) And (n+StartPosition <= Len(FullExpression)+1))
			n = n+1
		Wend
		GetNextItemLength = n-1
		Exit Function
	Else
		While ((Not IsPostfixToVBAOperator(Mid(FullExpression,StartPosition+n,1), sDataType)) And (InStr("()|"+sParaSep_LIB,Mid(FullExpression,StartPosition+n,1))=0) And (n+StartPosition <= Len(FullExpression)+1))
		'While ((Is1DCVariable(Mid(FullExpression,StartPosition,n)) Or Is1DCParameter(Mid(FullExpression,StartPosition,n))) And (n+StartPosition <= Len(FullExpression)+1)) ' OLD
			n = n+1
		Wend
		' Could be a function
	'	If (Is1DCFunction(Mid(FullExpression,StartPosition,n))) Then
			GetNextItemLength = n
			Exit Function
	'	End If
	'	GetNextItemLength = n-1
	'	Exit Function
	End If

End Function

Function GetRes1DComplexFrom1DCNumeric(RealPart As Variant, ImagPart As Variant, Optional appName As String) As Object

	If (Not IsNumeric(RealPart)) Then RealPart = Evaluate(RealPart)
	If (Not IsNumeric(ImagPart)) Then ImagPart = Evaluate(ImagPart)

	If (Left(appName,2)="DS") Then
		'MsgBox("DS")
		Set GetRes1DComplexFrom1DCNumeric = DS.Result1DComplex("")
	Else
		'MsgBox("MWS")
		Set GetRes1DComplexFrom1DCNumeric = Result1DComplex("")
	End If
	' Object needs at least 3 points so that .MakeCompatibleTo can be used
	GetRes1DComplexFrom1DCNumeric.AppendXY(lib_rundef,RealPart,ImagPart)
	GetRes1DComplexFrom1DCNumeric.AppendXY(0,RealPart,ImagPart)
	GetRes1DComplexFrom1DCNumeric.AppendXY(-lib_rundef,RealPart,ImagPart)

End Function

Function Convert1DCToDbl(InputObject As Variant) As Double

	If IsObject(InputObject) Then
		Convert1DCToDbl = InputObject.GetYRe(0)
	Else
		Convert1DCToDbl = InputObject
	End If

End Function

Function Sin1DC(Operand As Object) As Object
	' Calculate sin(z), z in rad
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = zsin(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Sin1DC = Operand
End Function

Function SinD1DC(Operand As Object) As Object
	' Calculate sin(z), z in deg
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)*Pi/180
		z.im = dYImValues(i)*Pi/180
		z = zsin(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set SinD1DC = Operand
End Function

