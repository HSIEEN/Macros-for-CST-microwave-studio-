' Complex number and matrix operations
'--------------------------------------------------------------------------------------
' 1) Defines the complex type, and operations with complex numbers:
'  One-argument functions:
'    neg, conj, absolute, absolute2 (square of abs. value), argph2reim, argph2reim_2 (takes two numbers as args), reim2argph
'  Two-argument functions:
'    plus, minus, mult, div, multsc, divsc (divide by scalar)

' 2) Defines operations with 2-dimensional matrices:
'    RealMatrixMult
'    ComplexMatrixMult, ComplexMatrixTransp
'	 RealComplexMatrixMult, ComplexRealMatrixMult (one matrix is of type double, the other one of type complex)

' TO DO:
'      - All functions for both Complex and ComplexMagPh types (see example for the "neg" function), maybe also for real
'      - Matrix inversion?
'
'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
' Copyright 2005-2023 Dassault Systemes Deutschland GmbH
'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
' History of Changes:
'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
' 19-Sep-2019 fsr: Added ComplexPowerReal to calculate z^r
' 05-Nov-2018 fsr: Added AreMatricesEqual to compare matrices, ComplexMatrixPower to calculate A^n; ComplexMatrixMult now works with dynamic or static array as output variable
' 					Added DisplayComplexMatrix to print result; ComplexRealMatrixMult now uses ComplexMatrixMult to carry out multiplication; general overhaul
' 12-Jan-2015 tsi: Add AddComplexToArray function as requested by fsr.
' 25-Apr-2014 mku: added zasinh, zacosh
' 21-Sep-2011 fsr: changed all occurrences of "Arg" in connection with ComplexArgPh to "Mag"
' 15-Jul-2011 fsr: added ztan, zatn, and zatn2; fixed a bug in function "neg" where the angle was multiplied by (-1) instead of shifted by Pi,
'					removed Function "neg1", Split "neg" into "neg" And "neg_ArgPh"
' 18-Feb-2011 fsr: fixed a small bug in the ComplexSqrt when argument was purely real and negative
' 29-Sep-2010 mku: added rtanh, rcoth
' 17-Sep-2010 fsr: added complex sin and cos, log, asin, acos
' 14-Jun-2010 ube: renamed Sub Main into Main_COMPLEX_LIB
' 31-Aug-2009 mku: included zexp; modified ztanh, zcoth
' 15-May-2009 fhi: added ComplexMatrixInv3x3, ComplexMatrixInv2x2, AssignComplex
' 26-Mar-2009 mku: included zsinh, zcosh, ztanh, zcoth, rsinh, rcosh
' 23-Jul-2008 msy: included complex sqrt function ComplexSqrt
' 12-Oct-2005 ube: Changed "MsgBox" to "ReportError"
' 10-Oct-2005 imu: Changed "Error" to "MsgBox"
' First version: imu 08.01.2004
'------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
Type Complex
	re As Double
	im As Double
End Type

Type ComplexMagPh	' complex by argument and phase
	mag As Double
	ph As Double
End Type

'---------------------------------------------------------------------------------------------------------
Function InsertComplexIntoArray( ByRef ArrayOfComplex() As Complex, i As Long, ByRef c As Complex)
	ArrayOfComplex(i).re = c.re
	ArrayOfComplex(i).im = c.im
End Function

'---------------------------------------------------------------------
Function InsertComplexMagPhIntoArray( ByRef ArrayOfComplexMagPh() As ComplexMagPh, i As Long, ByRef c As ComplexMagPh)
	ArrayOfComplexMagPh(i).mag = c.mag
	ArrayOfComplexMagPh(i).ph = c.ph
End Function

'---------------------------------------------------------------------
Function zlog (vx As Complex) As Complex
	' complex log is periodic with n*j*2*pi, this function returns only the solution with n=0
	zlog.re = Log(absolute(vx))
	zlog.im = arc_theta(vx)
End Function

'---------------------------------------------------------------------
Function zsin (vx As Complex) As Complex
	zsin.re = Sin(vx.re)*rcosh(vx.im)
	zsin.im = Cos(vx.re)*rsinh(vx.im)
End Function

'---------------------------------------------------------------------
Function zasin (vx As Complex) As Complex
	Dim ztmp As Complex
	' z = -i*log(i*z+sqrt(1-z^2))
	ztmp = mult(AssignComplex(0,-1),zlog(plus(mult(AssignComplex(0,1),vx),ComplexSqrt(minus(AssignComplex(1,0),mult(vx,vx))))))
	zasin.re = ztmp.re
	zasin.im = ztmp.im
End Function

'---------------------------------------------------------------------
Function zcos (vx As Complex) As Complex
	zcos.re = Cos(vx.re)*rcosh(vx.im)
	zcos.im = -Sin(vx.re)*rsinh(vx.im)
End Function

'---------------------------------------------------------------------
Function zacos (vx As Complex) As Complex
	Dim ztmp As Complex
	' z = pi/2+i*log(i*z+sqrt(1-z^2))
	ztmp = plus(AssignComplex(Pi/2,0),mult(AssignComplex(0,1),zlog(plus(mult(AssignComplex(0,1),vx),ComplexSqrt(minus(AssignComplex(1,0),mult(vx,vx)))))))
	zacos.re = ztmp.re
	zacos.im = ztmp.im
End Function

'---------------------------------------------------------------------
Function ztan (vx As Complex) As Complex
	' tangent of complex argument
	ztan = div(zsin(vx),zcos(vx))
End Function

'---------------------------------------------------------------------
Function zatn (vx As Complex) As Complex
	' arctangent of complex argument
	' atn(z) = asin(z/sqr(z^2+1))
	zatn = zasin(div(vx,ComplexSqrt(plus(mult(vx,vx),AssignComplex(1,0)))))
End Function

'---------------------------------------------------------------------
Function zatn2 (vx As Complex, vy As Complex) As Complex
	' atan2 of 2 complex arguments, atan2 by definition ignores the imaginary parts of its arguments
	zatn2.re = atn2(vx.re, vy.re)
	zatn2.im = 0
End Function

'---------------------------------------------------------------------

Function zexp (vx As Complex) As Complex
       zexp.re = Exp(vx.re)*Cos(vx.im)
       zexp.im = Exp(vx.re)*Sin(vx.im)
End Function
'---------------------------------------------------------------------

Function zsinh (vx As Complex) As Complex
       zsinh.re = rsinh(vx.re)*Cos(vx.im)
       zsinh.im = rcosh(vx.re)*Sin(vx.im)
End Function
'---------------------------------------------------------------------

Function zasinh (vx As Complex) As Complex
	Dim ztmp As Complex
	' z = log(z+sqrt(1+z^2))
	ztmp = zlog(plus(vx,ComplexSqrt(plus(AssignComplex(1,0),mult(vx,vx)))))
	zasinh.re = ztmp.re
	zasinh.im = ztmp.im
End Function
'---------------------------------------------------------------------

Function zcosh (vx As Complex) As Complex
        zcosh.re = rcosh(vx.re)*Cos(vx.im)
        zcosh.im = rsinh(vx.re)*Sin(vx.im)
End Function
'---------------------------------------------------------------------

Function zacosh (vx As Complex) As Complex
	Dim ztmp As Complex
	' z = log(z+sqrt(-1+z^2))
	ztmp = zlog(plus(vx,ComplexSqrt(plus(AssignComplex(-1,0),mult(vx,vx)))))
	zacosh.re = ztmp.re
	zacosh.im = ztmp.im
End Function
'---------------------------------------------------------------------

Function ztanh (vx As Complex) As Complex
        Dim sum1 As Complex
        Dim sum2 As Complex
        Dim zone As Complex
        Dim zarg As Complex
	zarg.re = -2*vx.re
	zarg.im = -2*vx.im
        zone.re = 1.0
        zone.im = 0.0

        sum1 = minus(zone,zexp(zarg))
        sum2 = plus(zone,zexp(zarg))
        ztanh = div(sum1,sum2)
'        ztanh = div(zsinh(vx),zcosh(vx))
End Function
'---------------------------------------------------------------------

Function zcoth (vx As Complex) As Complex
        Dim sum1 As Complex
        Dim sum2 As Complex
        Dim zone As Complex
        Dim zarg As Complex
	zarg.re = -2*vx.re
	zarg.im = -2*vx.im
        zone.re = 1.0
        zone.im = 0.0

        sum1 = plus(zone,zexp(zarg))
        sum2 = minus(zone,zexp(zarg))
        zcoth = div(sum1,sum2)
'         zcoth = div(zcosh(vx),zsinh(vx))
End Function
'---------------------------------------------------------------------

Function rsinh (rx As Double) As Double
        rsinh = 0.5*(Exp(rx)-Exp(-rx))
End Function
'---------------------------------------------------------------------

Function rcosh (rx As Double) As Double
        rcosh = 0.5*(Exp(rx)+Exp(-rx))
End Function
'---------------------------------------------------------------------

Function rtanh (rx As Double) As Double
        rtanh = rsinh(rx) / rcosh(rx)
End Function
'---------------------------------------------------------------------

Function rcoth (rx As Double) As Double
        rcoth = rcosh(rx) / rsinh(rx)
End Function
'---------------------------------------------------------------------

Function neg (vx As Complex) As Complex
	Dim tmp As Complex
	tmp.re = -vx.re
	tmp.im = -vx.im
	neg = tmp
End Function

Function neg_MagPh (vx As ComplexMagPh) As ComplexMagPh
	Dim tmp As ComplexMagPh
	tmp.mag = vx.mag
	tmp.ph = vx.ph+Pi
	neg_MagPh = tmp
End Function

