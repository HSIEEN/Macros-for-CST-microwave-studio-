			zx = zatn2(zx1, zx2)
			zy = zatn2(zx1, zx2)
			zz = zatn2(zx1, zx2)

			dXReValues1(i) =  zx.re/Pi*180
			dXImValues1(i) =  zx.im/Pi*180
			dYReValues1(i) =  zy.re/Pi*180
			dYImValues1(i) =  zy.im/Pi*180
