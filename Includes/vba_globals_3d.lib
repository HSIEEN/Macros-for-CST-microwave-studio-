		MyFolder$(3)="Phase"
		myXLabel$(3)="Frequency"

		MyResult$(4)=".prs"
		MyFolder$(4)="Signal"
		myXLabel$(4)="Time"


	Dim myres$, myfol$, myfilepath$, myfilepattern$, myfilepath_short$, myext$, myext2$, myprobename$, myprobename_short$
	Dim iii As Integer

	myfilepath    = lib_modfile+"\Result"
