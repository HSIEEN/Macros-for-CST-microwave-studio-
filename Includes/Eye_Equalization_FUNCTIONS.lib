' 19-Apr-2018 imu: Cleaning up CTLE-related code, mostly debug code
' 13-Nov-2017 imu: Corrections in LFE and DFE to deal with very short signals. Added CTLE equalization.
' 15-Mar-2017 ube: dialogue cosmetics
' 11-Mar-2017 imu: correction in equalizedPulse_FFE  to deal with negative tap for the main cursor
' 17-Feb-2017 imu: added optional parameters related to the x-axis shift to the equalization functions (LFE, DFE)
' 02-Jan-2017 imu,ube: moved equalization related definitions and dialog routines into the lib
' 19-May-2016 imu: Changed uses to include, added additional parameters for the functions, for use as global lib
' 10-May-2016 imu: Added setting of sett_DFE.ntaps  and  sett_LFE.ntaps (only nonzero after they have been calculated once)
' 08-May-2016 imu: eliminated the plotting of the equalized signal - it can be done in the calling routine. It is otherwise very confusing, since it was always saved under the same name

' Type of equalization
Const EQTypesArray = Array("CTLE", "Transmitter_LFE", "Receiver_LFE", "Receiver_DFE")
Public Enum EqualizTypesEnum
	CTLE
	Trans_FFE
	Rec_LFE
	Rec_DFE
End Enum

Public Type eq_CTLE_settings
	isOn As Byte
	CTLE_Type As String
	R1 As Double
	R2 As Double
	R3 As Double
	C1 As Double
	C2 As Double
	Adc As Double
	fz As Double
	fp1 As Double
	fp2 As Double
	isAuto As Byte
End Type

Public Type eq_LFE_DFE_settings
	isOn As Byte
	npre As Long
	npost As Long
	method As String
	ntaps As Long
	taps() As Double
End Type

' Variables for equalization
Public EQ_Type As EqualizTypesEnum
Public sett_CTLE As eq_CTLE_settings
Public sett_LFE As eq_LFE_DFE_settings
Public sett_DFE As eq_LFE_DFE_settings

Function equalizedPulse_DFE(o1 As Object, pulse_len As Long, ByRef sett_DFE As eq_LFE_DFE_settings, Optional ByRef initshift As Double) As Object
	' An approximate version of DFE.
	Dim o2 As Object
	Dim iii As Long, jjj As Long
	Dim mat() As Double, sig_init() As Double

	Dim ntaps As Long, taps() As Double, tappos() As Long
	Dim npre As Long, npost As Long
	Dim matcurs() As Double, ycurs() As Double
	Dim tmpl As Long
	Dim dt As Double
	Dim nshifts As Long, tap As Long, k As Long
	Dim crtbit As Double
	Dim shift As Double

	shift = o1.gety(0)	' This could be a parameter, or initshift could be used instead of o1.gety(0)

	Dim cursor As Long
	cursor = o1.GetGlobalMaximum
	If (o1.getN - cursor) / o1.getN < 0.1 Then
		MsgBox "The input signal does not look like an appropriate pulse response. Please check your settings"
		Exit All
	End If

' ======= THIS SHOULD BE ENTERED BY THE USER
	npre = 0
	npost = sett_DFE.npost
	ntaps = npre+npost
' ======= THIS SHOULD BE ENTERED BY THE USER

	'zero_forcing(npre, npost, o1, pulse_len, taps)

	ReDim taps(0 To ntaps-1)
	ReDim matcurs(1 To ntaps, 1 To ntaps)
	ReDim ycurs(1 To ntaps)
	For iii = -npre+1 To npost
		tmpl = cursor + iii*pulse_len
		ycurs(ntaps-(iii+npre)+1)=o1.GetY(tmpl)-shift
	Next

	ReDim sett_DFE.taps(0 To ntaps-1)
	For iii = 0 To ntaps-1
		taps(iii) = ycurs(ntaps-iii)
		sett_DFE.taps(iii) = taps(iii)
	Next
	sett_DFE.ntaps = ntaps

	' ==============================
	Dim n As Long, m As Long, mn As Long

	Set o2 = o1.copy


	n = o1.getN-1
	m = ntaps	'actually, not needed here, the matrix gets too long. I only need a length of n
	mn = n'+m*pulse_len

	ReDim      mat(0 To mn)
	ReDim sig_init(0 To n)	'	ReDim sig_init(0 To mn)	' As in determine_eyeunwrapped_superposition

' Only for DFE
	' Initialize the matrix
	dt = o1.GetX(1)-o1.GetX(0)
	For iii = 0 To n
		sig_init(iii) = o1.GetY(iii)
		mat(iii) = sig_init(iii)'*taps(0)
	Next

	k = cursor + pulse_len/2
	For tap = 0 To ntaps-1
		crtbit = taps(tap)	'getABit(digseq, bits+1)
		For iii = k To min(k+pulse_len-1, o1.GetN-1)	' Now go through all time steps, but only until the end of the signal!
			mat(iii) = sig_init(iii)-crtbit       '*mat(iii) * sig_init(iii-k)
		Next
		k = k+pulse_len
		nshifts = nshifts+1
	Next

	Set o2 = o1.copy	'Result1D("")
	For iii = 0 To o1.GetN-1	'mn-1
		o2.SetXYDouble(iii, iii*dt, mat(iii))
	Next

	Set equalizedPulse_DFE = o2.Copy

	' Trick to estimate the shift due to the fact that this is only an approximate value of the DFE
	Dim tmpd As Double
	k = cursor + pulse_len/2*3
	If k<o1.GetN Then	' Make sure we do not go further than the length of the signal (could happen for short signals)
		If mat(k-1) < shift Then
			tmpd = mat(k-1)
		End If
	End If
	initshift = tmpd

End Function

Function equalizedPulse_FFE(o1 As Object, pulse_len As Long, ByRef sett_LFE As eq_LFE_DFE_settings, Optional ByRef initshift As Double) As Object
	' Use as follows: if the signal starts at zero, but only because a y-shift has been subtracted before, provide initshift as the signal's shift.
	'	After the execution of the routine, initshift will contain the scaled shift
	Dim o2 As Object
	Dim iii As Long, jjj As Long
	Dim mat() As Double, sig_init() As Double
	Dim shift As Double


	Dim ntaps As Long, taps() As Double, tappos() As Long
	Dim npre As Long, npost As Long
	Dim matcurs() As Double, ycurs() As Double
	Dim tmpl As Long

	Dim cursor As Long

' ======= THIS SHOULD BE ENTERED BY THE USER
	npre = sett_LFE.npre
	npost = sett_LFE.npost
	ntaps = npre+npost+1
' ======= THIS SHOULD BE ENTERED BY THE USER

	shift = -o1.gety(0)	' IMU 17.2.2017

	If sett_LFE.method = "ZFS" Then
		zero_forcing(npre, npost, o1, pulse_len, taps, shift)
	Else
		MMSE_taps(npre, npost, o1, pulse_len, taps, shift)
	End If

	If taps(npre) < 0 Then	' If the tap for the main cursor is negative, pulse would be inverted. Change signs of all taps
		For iii = 0 To ntaps-1
			taps(iii) = -taps(iii)
		Next
	End If

	ReDim sett_LFE.taps(0 To ntaps-1)
	For iii = 0 To ntaps-1
		sett_LFE.taps(iii) = taps(iii)
	Next
	sett_LFE.ntaps = ntaps

	Dim n As Long, m As Long, mn As Long

	Set o2 = o1.copy

	n = o1.getN-1
	m = ntaps	'4	'cst_seq_length-1
	mn = n+m*pulse_len

	ReDim      mat(0 To mn)
	ReDim sig_init(0 To n)	'	ReDim sig_init(0 To mn)	' As in determine_eyeunwrapped_superposition

	' Initialize the matrix
	For iii = 0 To n
		sig_init(iii) = o1.GetY(iii)
		mat(iii) = sig_init(iii)*taps(0)
'		mat(iii) = sig_init(iii)*taps(ntaps-1)
	Next

	' Iterate for all taps
	Dim nshifts As Long, tap As Long, k As Long
	Dim crtbit As Double

	nshifts = 1
	For tap = 1 To ntaps-1
		crtbit = taps(tap)	'getABit(digseq, bits+1)
'		crtbit = taps(ntaps-1-tap)	'getABit(digseq, bits+1)
		k = nshifts*pulse_len
'		For iii = k To k+n'(n_UIs)*pulse_len	'(n_UIs-5)*pulse_len	'n	'mn	'pulse_len*(bits-1) To n	' Now go through all time steps
		For iii = 0 To k+n	' Now go through all time steps
			Dim iiik As Long
			iiik = iii-k
			If iiik < 0 Then iiik = n-iiik-k
			mat(iii) = mat(iii) + crtbit * sig_init(iiik)
		Next
		nshifts = nshifts+1
	Next

	' Calculate the shift
	Dim tmpshift As Double, myval As Double
	tmpshift = initshift *taps(0)
	For tap=1 To ntaps-1
		iiik = n-tap-1
		If Abs(o1.getY(0)) < 1e-15 Then
			myval = o1.getY(iiik)+initshift
		Else
			myval = o1.getY(iiik)
		End If
		tmpshift = tmpshift+ taps(tap)*(myval)
	Next
	initshift = tmpshift

	Dim dt As Double
	dt = o1.GetX(1)-o1.GetX(0)

	Set o2 = Result1D("")
	o2.Initialize(n+1)	'mn)
	For iii = 0 To n	'mn-1
		o2.SetXYDouble(iii, iii*dt, mat(iii))
	Next

	Set equalizedPulse_FFE = o2.Copy

End Function

Sub zero_forcing(npre As Long, npost As Long, o1 As Object, pulse_len As Long, taps() As Double, Optional shift As Double)
	' Determine the taps through the zero forcing solution (ZFS) method
	' Own implementation based on explanations from the book ADVANCED SIGNAL INTEGRITY For HIGH-SPEED DIGITAL DESIGNS, by STEPHEN H. HALL and HOWARD L. HECK, John Wiley, 2009

	Dim matcurs() As Double, ycurs() As Double
	Dim iii As Long, jjj As Long
	Dim ntaps As Long
	Dim tmpl As Long
	Dim cursor As Long

	ntaps = npre + npost +1

	' Determine position of the maximum - this is the cursor
	cursor = o1.GetGlobalMaximum

	ReDim taps(0 To ntaps-1)
	ReDim matcurs(1 To ntaps, 1 To ntaps)
	ReDim ycurs(1 To ntaps)

	' Generate input samples matrix
	For iii = -npre To npost
		tmpl = cursor + iii*pulse_len
		ycurs(ntaps-(iii+npre))=o1.GetY(tmpl)+shift
	Next

	For jjj = 1 To ntaps
		matcurs(npost+1, jjj) = ycurs(jjj)
	Next
	For iii = npost To 1 Step -1
		For jjj = 1 To iii+1
			If jjj+1 <= ntaps Then matcurs(iii, jjj) = matcurs(iii+1,jjj+1)
		Next
	Next

	For iii = npost+2 To ntaps
		For jjj = iii-npost To ntaps
			matcurs(iii, jjj) = matcurs(iii-1,jjj-1)
		Next
	Next

	If IS_DEBUG = True Then
		Dim tmpstr As String
		tmpstr = ""
		For iii = 1 To ntaps
			For jjj = 1 To ntaps
				tmpstr = tmpstr + cstr(matcurs(iii,jjj)) + vbTab
			Next
			tmpstr = tmpstr + vbCrLf
		Next
		MsgBox tmpstr
		'display_real_mat(matcurs, ntaps, "matcurs ZFE" )
	End If

	Dim ytarget() As Double, cz_tmp() As Double, cz() As Double
	ReDim ytarget(1 To ntaps)
	ReDim cz_tmp(1 To ntaps)

	ytarget(npre+1) = 1
	If shift <> 0 Then ytarget(npre+1) = shift

	invmat (ntaps, matcurs)
	matrix_vector_mult(ntaps, matcurs, ytarget, cz_tmp)

	' Prepare normalization of coefficients
	Dim sumc As Double
	sumc = 0
	For iii = 1 To ntaps
		sumc = sumc + Abs(cz_tmp(iii))
	Next
	For iii = 0 To ntaps-1
		taps(iii) = cz_tmp(iii+1)/sumc
	Next
End Sub

Sub MMSE_taps(npre As Long, npost As Long, o1 As Object, pulse_len As Long, taps() As Double, Optional shift As Double)
	' Determine the taps through the Minimum mean square error (MMSE) method
	' Own implementation based on explanations from the book ADVANCED SIGNAL INTEGRITY For HIGH-SPEED DIGITAL DESIGNS, by STEPHEN H. HALL and HOWARD L. HECK, John Wiley, 2009

	Dim matcurs() As Double, ycurs() As Double
	Dim iii As Long, jjj As Long
	Dim ntaps As Long
	Dim tmpl As Long
	Dim cursor As Long
	Dim ytarget() As Double, cz_tmp() As Double, cz() As Double

	ntaps = npre + npost +1

	' Determine position of the maximum - this is the cursor
	cursor = o1.GetGlobalMaximum


	ReDim taps(0 To ntaps-1)
	ReDim matcurs(1 To ntaps, 1 To ntaps)
	ReDim ycurs(1 To ntaps)

	' Generate input samples matrix
	For iii = -npre To npost
		tmpl = cursor + iii*pulse_len
		ycurs(ntaps-(iii+npre))=o1.GetY(tmpl)+shift
	Next

	For jjj = 1 To ntaps
		matcurs(npost+1, jjj) = ycurs(jjj)
	Next
	For iii = npost To 1 Step -1
		For jjj = 1 To iii+1
			If jjj +1 <= ntaps Then matcurs(iii, jjj) = matcurs(iii+1,jjj+1)
		Next
	Next

	For iii = npost+2 To ntaps
		For jjj = iii-npost To ntaps
			matcurs(iii, jjj) = matcurs(iii-1,jjj-1)
		Next
	Next
		If IS_DEBUG = True Then display_real_mat(matcurs, ntaps, "matcurs MMSE" )

	Dim y() As Double
	ReDim y(1 To o1.GetN)
	For iii = 1 To o1.GetN
		y(iii) = o1.GetY(iii-1)
	Next

	Dim Rxx() As Double, Rxz() As Double
	ReDim Rxx(1 To ntaps, 1 To ntaps)
	ReDim Rxz(1 To ntaps, 1 To o1.GetN)
	Dim matcurs_T() As Double
	ReDim matcurs_T(1 To ntaps, 1 To ntaps)

	' Calculate x^T
	matrix_transpose(ntaps, ntaps, matcurs, matcurs_T)
		If IS_DEBUG Then display_real_mat(matcurs_T, ntaps, "matcurs_T" )

	' Calculate Rxx = x^t * x
	matrix_matrix_mult(ntaps, matcurs_T, matcurs, Rxx)
	' Calculate Rxz = ycurs = x^t * y
	ReDim ytarget(1 To ntaps)
	ReDim cz_tmp(1 To ntaps)
	ytarget(npre+1) = 1
	If shift <> 0 Then ytarget(npre+1) = shift

	matrix_vector_mult(ntaps, matcurs_T, ytarget, y)
		If IS_DEBUG Then display_real_mat(Rxx, ntaps, "Rxx" )

	invmat (ntaps, Rxx)
	matrix_vector_mult(ntaps, Rxx, y, cz_tmp)
	' Prepare normalization of coefficients
	Dim sumc As Double
	sumc = 0
	For iii = 1 To ntaps
		sumc = sumc + Abs(cz_tmp(iii))
	Next
	For iii = 0 To ntaps-1
		taps(iii) = cz_tmp(iii+1)/sumc
	Next

End Sub

Sub Equalization_OLD(o1 As Object, pulse_t As Long, UseEqualization As Boolean, sett_CTLE As eq_LFE_DFE_settings, sett_LFE As eq_LFE_DFE_settings, sett_DFE As eq_LFE_DFE_settings, ParentTreeName As String)

	Dim dt As Double, pulse_len As Long
	Dim o1init As Object
	Dim maxinit As Double, mininit As Double

	Set o1init = o1.copy
	maxinit = o1.GetY(o1.GetGlobalMaximum)
	mininit = o1.GetY(o1.GetGlobalMinimum)



		' Deal with the equalization
	' ============================
	If 1 = 1 Then
	dt = o1.GetX(1) -o1.getX(0)
	pulse_len = pulse_t / dt

	' Make sure dt fits to the pulse length
	Dim nsamples As Long
	'nsamples = o1.GetN / pulse_len
	'dt = pulse_t / pulse_len
	'o1.Resample To
	If UseEqualization = True Then
		If sett_CTLE.isOn = 0 And sett_LFE.isOn = 0 And sett_DFE.isOn = 0 Then
			ReportInformationToWindow "Equalization is on, but no equalization type has been selected. Continuing without equalization."
			UseEqualization = False
		End If

		If sett_CTLE.isOn = 1 Then
			' Code for CTLE
		End If

		If sett_LFE.isOn = 1 Then 	'EQ_Type = Trans_FFE Then
			' Transform the pulse response such that it contains the equalized pulse response
			Set o1 = equalizedPulse_FFE(o1, pulse_len, sett_LFE)
			If IS_DEBUG Then
				o1.Save ("pulseResponse_new_eq_FFE")
				o1.addToTree(ParentTreeName + "\Pulse Response - Time signals\pulseResponse_new equalized")
			End If
		End If

		If sett_DFE.isOn = 1 Then	'	EQ_Type = Rec_DFE Then
			' Transform the pulse response such that it contains the equalized pulse response
			Set o1 = equalizedPulse_DFE(o1, pulse_len, sett_DFE)
			If IS_DEBUG Then
				o1.Save ("pulseResponse_new_eq_DFE")
				o1.addToTree(ParentTreeName + "\Pulse Response - Time signals\pulseResponse_new equalized DFE")
			End If
		End If
	End If
	End If

	'If zero_lev <> 0 Then	' Update the zero level		' Commented out on 19.05.2016, for use as global function
		Dim maxfin As Double, minfin As Double, amplinit As Double, amplfin As Double, zerolev_diff As Double
		maxfin = o1.GetY(o1.GetGlobalMaximum)
		minfin = o1.GetY(o1.GetGlobalMinimum)

		amplinit = maxinit - mininit
		amplfin = maxfin-minfin

		zerolev_diff = (amplinit - amplfin) * 2	' Supposition that it is like this. IMU 21 Jul 2015
'		zero_lev = - zerolev_diff

	'End If

End Sub

Function DialogFunction_Equalize(DlgItem$, Action%, SuppValue?) As Boolean
