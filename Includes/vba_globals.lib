Sub Load_1D (lib_modfile As String, cst_runid As String)

Dim sResultName_tmp2 As String
Dim MyResult$(4), MyFolder$(4), myXLabel$(4)

MyResult$(1)=".rd1"
MyFolder$(1)="1D-Templates"
myXLabel$(1)=""

MyResult$(2)=".m1d"
MyFolder$(2)="MAFIA"
myXLabel$(2)=""

Dim myres$, myfol$, myfilepath$, myfilepattern$, myfilepath_short$, myext$, myext2$, sResultName_tmp$, sResultName_tmp_short$
Dim iii As Integer

For iii = 1 To 2

	myfilepath    = DirName(lib_modfile)
	myfilepattern = ShortName(lib_modfile) +  "^*" + MyResult$(iii)

	' Search for first result file
	sResultName_tmp = FindFirstFile(myfilepath , myfilepattern, False) 'See if a result exist

	While (sResultName_tmp <> "")
			myfilepath_short = ShortName(lib_modfile)
			sResultName_tmp_short = Right$((BaseName(sResultName_tmp)), (Len(BaseName(sResultName_tmp))-Len(myfilepath_short)-1))
			sResultName_tmp2 = DirName(lib_modfile) + "\" + myfilepath_short + "^" +sResultName_tmp_short +MyResult$(iii)

			'Add all result files to tree
			With ResultTree
					.Reset
					.Type "XYSignal"
					.Xlabel myXLabel$(iii)
					.Title sResultName_tmp_short
					.Name "1D Results\Comparison\" + MyFolder$(iii) + "\" + sResultName_tmp_short + "\" + cst_runid
					.File sResultName_tmp2
					.Add
			End With

		sResultName_tmp = FindNextFile
	Wend

Next iii

End Sub

'------------------------------------------------------------------------------------------------------
Sub SendEmail(EmailSubject As String, AttachFile As String)
	
	On Error GoTo NoOutlook
	
	Dim myAttachments As Object

    With CreateObject("Outlook.Application").CreateItem(0)
        .Subject = EmailSubject
        If Not (IsNull(AttachFile) Or IsEmpty(AttachFile)) Then
        	Set myAttachments = .Attachments
            myAttachments.Add AttachFile
        End If
        .Display
    End With
    
NoOutlook:
    
End Sub
'-----------------------------------------------------------------------------------------------------------------------------
Function bMWS As Boolean
	bMWS = (GetApplicationName="MWS")
End Function
'-----------------------------------------------------------------------------------------------------------------------------
Function bPS As Boolean
	bPS = (GetApplicationName="PS")
End Function
'-----------------------------------------------------------------------------------------------------------------------------
Function bEMS As Boolean
	bEMS = (GetApplicationName="EMS")
End Function
'-----------------------------------------------------------------------------------------------------------------------------
Function bMWS51 As Boolean
	bMWS51 = ( bMWS And (CDbl(Mid(GetApplicationVersion,9,3)) >= 5.1) ) Or _
		     ( bEMS And (CDbl(Mid(GetApplicationVersion,9,3)) >= 2.1) ) Or _
		       bPS
End Function
'-----------------------------------------------------------------------------------------------------------------------------
Function GetNormImpedance(sdsfilename As String, spomo As String) As Double

	On Error GoTo Imp_undefined
	GetAttr(sdsfilename)	' See if file exists; don't use Dir() !!
	On Error GoTo 0
	
	Dim spomo2 As String
	spomo2 = Replace(spomo,"(",",")
	spomo2 = Left(spomo2, Len(spomo2)-1)
	
	Dim icount As Integer
	icount = 0
	
	Dim cst_imped As Double
	Dim cst_line As String
	Dim cst_nitems As Integer
	Dim string_item(999) As String

	cst_imped = -1
	cst_line = GrepFirstPattern(sdsfilename, "normed    port#")
	While (cst_line <> "")
		icount = icount +1
		If InStr(cst_line, "port# "+spomo2+" ") >0 Then
			cst_nitems = CSTSplit (cst_line, string_item)
			cst_imped = RealVal(string_item(4))
			
			cst_line = GrepFirstPattern(sdsfilename, "norm flags")
			cst_nitems = CSTSplit (cst_line, string_item)			
			
			If (Left(string_item(icount+2),1)="0") Then
				' successful impedance found and norming flag is set
				GetNormImpedance = cst_imped
			Else
				' port is not normed
				GetNormImpedance = -1
			End If
			'   !!!!  jump completely out
			Exit Function
		End If
		cst_line = GrepNextPattern
	Wend

Imp_undefined: 
	GetNormImpedance = -1
End Function
'-----------------------------------------------------------------------------------------------------------------------------
'-----------------------------------------------------------------------------------------------------------------------------
' functions included for result templates
'-----------------------------------------------------------------------------------------------------------------------------
'---------------------------------------------------------------------------------------------------------------------------
Function FindListIndex(sListArray() As String, sItem As String) As Long

' -------------------------------------------------------------------------------------------------
' FindListIndex: This function determines the index of a given string in a given array.
'				 The function returns -1 if the array does not contain the desired string.
' -------------------------------------------------------------------------------------------------

	On Error GoTo ErrorLabel

	' Determine the dimension of the given array

	Dim nBound As Long, nIndex As Long
	nBound = UBound(sListArray())

	' Loop over all elements of the array and check whether an element is identical to
	' the searched string. If the string is found the function is exited and the
	' return value is assigned to the index of the element.

	For nIndex = 0 To nBound
		If (sListArray(nIndex) = sItem) Then
			FindListIndex = nIndex
			Exit Function
		End If
	Next nIndex

ErrorLabel:
	' If the execution comes here, either the searched item could not be found or
	' an error occured (e.g. the array is empty). In any case, the function returns
	' -1 to indicate the failure of the search.

	FindListIndex = -1
End Function
'---------------------------------------------------------------------------------------------------------------------------
Sub FillArray (sListArray() As String, sourceArray As Variant)

' -------------------------------------------------------------------------------------------------
' FillArray : This function copies all elements of a given array(even constant) into the sListArray
'             The function is useful in dialogues (especially for templates), which do not accept
'             constant arrays
' -------------------------------------------------------------------------------------------------

	Dim nBound As Long, nIndex As Long
	nBound = UBound(sourceArray)

	ReDim sListArray(nBound)
	
	For nIndex = 0 To nBound
		sListArray(nIndex)=sourceArray(nIndex)
	Next nIndex
	
End Sub
'---------------------------------------------------------------------------------------------------------------------------
Sub Append2Array (sListArray() As String, sourceArray As Variant)

' -------------------------------------------------------------------------------------------------
' Append2Array : This function appends all elements of a given array(even constant) into the sListArray
'             The function is useful in dialogues (especially for templates), which do not accept
'             constant arrays
' -------------------------------------------------------------------------------------------------

	Dim nBound As Long, nIndex As Long
	nBound = UBound(sourceArray)

	Dim nBound2 As Long

	On Error GoTo EmptyArray
		nBound2 = UBound(sListArray)
		On Error GoTo 0
		GoTo ProceedRedim

EmptyArray:
	nBound2 = 0

ProceedRedim:

	ReDim Preserve sListArray(nBound2 + nBound + 1)

	For nIndex = 0 To nBound
		sListArray(nBound2 + nIndex + 1) = sourceArray(nIndex)
	Next nIndex

End Sub
' -------------------------------------------------------------------------------------------------
Function NoForbiddenFilenameCharacters(s1 As String) As String

' -------------------------------------------------------------------------------------------------
' NoForbiddenFilenameCharacters : This function eliminates all characters from a string, which
'				are not allowed as filenames within CST Studios     ~^[]:,|*/\$"()
'				All these characters are just removed from the string.
'				The function is useful e.g. in ResultTemplates, whose name is identical to a filename.
' -------------------------------------------------------------------------------------------------

	Dim s2 As String

	s2 = s1

	s2 = Replace(s2,"~","")
	s2 = Replace(s2,"^","")
	' ============== begin of the brackets story []   ====================
	'ube/imu 23-jun-04  allow []
	'ube 22-dec-04  no, do not allow [], because of Make Archive cannot archive files with brackets  
	s2 = Replace(s2,"]",")")
	s2 = Replace(s2,"[","(")
	' ============== end of the brackets story []   ====================
	s2 = Replace(s2,":","")
	'ube 27-may-04  allow komma      s2 = Replace(s2,",","")
	s2 = Replace(s2,"|","")
	s2 = Replace(s2,"*","")
	s2 = Replace(s2,"/","")
	s2 = Replace(s2,"\","")
	s2 = Replace(s2,"$","")
	s2 = Replace(s2,"""","")
	'	s2 = Replace(s2,"(","")
	'	s2 = Replace(s2,")","")

	'ube/fmo 08-sep-08  do not allow semikolon, since copy paste from tables in this case does not work
	s2 = Replace(s2,";",",")

	NoForbiddenFilenameCharacters = s2

End Function

' -------------------------------------------------------------------------------------------------
Function dInterpolate_linear_x(lib_y As Double, lib_x0 As Double, lib_x1 As Double, lib_y0 As Double, lib_y1 As Double) As Double
' -------------------------------------------------------------------------------------------------
' dInterpolate_linear_x : calculates x at a given y-value from linear interpolation from neighboured points.
'				This function gives more accurate values, especially for a coarse definition range.
'
' 		linear function y = y0 + m*(x-x0)     with m=(y1-y0)/(x1-x0)
' -------------------------------------------------------------------------------------------------
	Dim lib_m As Double
	
	If lib_x0=lib_x1 Then
		dInterpolate_linear_x = lib_x0
	Else
		lib_m=(lib_y1-lib_y0)/(lib_x1-lib_x0)
		dInterpolate_linear_x = (lib_y-lib_y0)/lib_m + lib_x0
	End If
End Function

' -------------------------------------------------------------------------------------------------
Function dInterpolate_linear_y(lib_x As Double, lib_x0 As Double, lib_x1 As Double, lib_y0 As Double, lib_y1 As Double) As Double
' -------------------------------------------------------------------------------------------------
' dInterpolate_linear_y : calculates y at a given x-value from linear interpolation from neighboured points.
'				This function gives more accurate values, especially for a coarse definition range.
'
' 		linear function y = y0 + m*(x-x0)     with m=(y1-y0)/(x1-x0)
' -------------------------------------------------------------------------------------------------
	Dim lib_m As Double
	
	If lib_x0=lib_x1 Then
		' take mean value between y0 and y1
		dInterpolate_linear_y = 0.5*(lib_y0+lib_y1)
	Else
		lib_m=(lib_y1-lib_y0)/(lib_x1-lib_x0)
		dInterpolate_linear_y = lib_y0 + lib_m*(lib_x-lib_x0)
	End If
End Function
' -------------------------------------------------------------------------------------------------
Function bMathChar (s1 As String) As Boolean

	bMathChar = False

	If Len(s1) = 1 Then
		If ( s1="+" Or s1="-" Or s1="^" Or s1="*" Or s1="/" Or s1="\" Or s1="," Or _
			 s1="<" Or s1=">" Or s1="=" Or s1="(" Or s1=")" Or s1="&" Or s1=" " ) Then
			bMathChar = True
		End If
	End If

End Function
Function IsDigit_1_9(s1 As String) As Boolean

	IsDigit_1_9 = False

	If Len(s1) = 1 Then
		If ( s1="1" Or s1="2" Or s1="3" Or s1="4" Or s1="5" Or s1="6" Or _
			 s1="7" Or s1="8" Or s1="9" ) Then
			IsDigit_1_9 = True
		End If
	End If

End Function
' -------------------------------------------------------------------------------------------------
Function CST_ReplaceString (s1 As String, s2 As String) As String

	' this function is searching for all occurances of s2 within s1 and adds the string "_cst_tmp"
	' to each s2-string, if s2 is surrounded by only math. characters

	' This function is useful to avoid naming conflicts between A B C D x y ... in the Result Templates
	' and identical variables. The result templates variables are replaced by  A ==> A_cst_tmp

	' Thus even variable a can be used together with A.

	Dim i0 As Integer, i1 As Integer, islength As Integer, ilast As Integer
	Dim s3 As String
	Dim bReplace As Boolean

	i0=1
	islength = Len(s1)
	ilast = 0
	s3 = ""
	While True
		i1=InStr(i0,s1,s2)
		If (i1 = 0) Then Exit While

		bReplace = True
		If (i1 > 1) Then
			bReplace = bReplace And bMathChar(Mid$(s1,i1-1,1))
		End If
		If (i1 < islength) Then
			bReplace = bReplace And bMathChar(Mid$(s1,i1+1,1))
		End If
		If (bReplace) Then
			s3 = s3 + Mid$(s1,ilast+1,i1-ilast) + "_cst_tmp"
			ilast = i1
		End If
		i0=i1+1
	Wend

	If (ilast < islength) Then
		s3 = s3 + Mid$(s1,ilast+1,islength-ilast)
	End If

	CST_ReplaceString = s3

End Function
' -------------------------------------------------------------------------------------------------
Sub GetAll2D3DResults (sListArray() As String, n2D3DFields As Integer)

' -------------------------------------------------------------------------------------------------
' GetAll2D3DResults : This subroutine is collecting all available 2D/3D Results from the .res file
'
'	Before the simulation, all freq-monitors, modes, static, ... fields are collected/estimated
'
' -------------------------------------------------------------------------------------------------
	Dim aField(999) As String

	Dim cst_line As String
	Dim sfilename As String
	Dim icount As Integer, nIndex As Integer

	sfilename = GetProjectPath("Result") + "\Model.res"
	icount = 0
	If Dir$(sfilename) <> "" Then
		cst_line = GrepFirstPattern(sfilename, "2D/3D Results")
		While (cst_line <> "")
			aField(icount) = Mid$(Trim$(cst_line),15)
			icount  = icount + 1
			cst_line = GrepNextPattern
		Wend
	End If

	If (icount = 0) Then

		' no calculation has been performed so far, therefore take default list
		' different for MWS and EMS

		If (bMWS) Then

			' each monitor with excitation at port 1 (=> extension " [1]")
			' skip farfield and time domain monitors

			Dim sMoniName As String
			Dim bTakeIt As Boolean

			With Monitor
				For nIndex= 0 To .GetNumberOfMonitors-1

					bTakeIt = True
					sMoniName = .GetMonitorNameFromIndex(nIndex)

					Select Case	Mid(.GetMonitorTypeFromIndex(nIndex),1,8)

						Case "Farfield"

							bTakeIt = False

						Case "E-Field "

							sMoniName = "E-Field\" + sMoniName

						Case "H-Field "

							If (.GetMonitorDomainFromIndex(nIndex) <> "Time") Then

								' besides standard H-Field also take Surface Current

								aField(icount) = "Surface Current\" + sMoniName + " [1]"
								icount  = icount + 1

							End If

							sMoniName = "H-Field\" + sMoniName

						Case "Powerflo"

							sMoniName = "Power Flow\" + sMoniName

						Case "Loss den"

							sMoniName = "Power Loss Dens.\" + sMoniName

						Case "E-Energy"

							sMoniName = "El. Energy Dens.\" + sMoniName

						Case "H-Energy"

							sMoniName = "Mag. Energy Dens.\" + sMoniName

					End Select

					If (.GetMonitorDomainFromIndex(nIndex) = "Time") Then

						bTakeIt = False

					End If

					If bTakeIt Then

						aField(icount) = sMoniName + " [1]"
						icount  = icount + 1

					End If

				Next
			End With

			For nIndex= 1 To Solver.AKSGetNumberOfModes

				' also take for each mode

				aField(icount) = "Modes\Mode " + CStr(nIndex) + "\e"
				icount  = icount + 1
				aField(icount) = "Modes\Mode " + CStr(nIndex) + "\h"
				icount  = icount + 1
				aField(icount) = "Modes\Mode " + CStr(nIndex) + "\Surface Current"
				icount  = icount + 1

			Next
		End If

		If (bEMS or bPS) Then

			' in EMS take the static fields

			aField(icount) = "E-Field [Es]"
			icount  = icount + 1
			aField(icount) = "D-Field [Es]"
			icount  = icount + 1
			aField(icount) = "Potential [Es]"
			icount  = icount + 1
			aField(icount) = "E-Field [Js]"
			icount  = icount + 1
			aField(icount) = "Cond. Current Dens. [Js]"
			icount  = icount + 1
			aField(icount) = "Potential [Js]"
			icount  = icount + 1
			aField(icount) = "B-Field [Ms]"
			icount  = icount + 1
			aField(icount) = "H-Field [Ms]"
			icount  = icount + 1
			aField(icount) = "Material [Ms]"
			icount  = icount + 1
			aField(icount) = "Permanent Flux [Ms]"
			icount  = icount + 1

			if (not bPS) then
				aField(icount) = "Source Current Dens. [Ms]"
				icount  = icount + 1
	
				aField(icount) = "Temperature [Th]"
				icount  = icount + 1
	
				aField(icount) = "Heat Flow Density [Th]"
				icount  = icount + 1
	
				' once VBA-commands for FD-frequencies exist, also include those fields
	
				' EMS-FD Solver .GetNumberOfFrequencies
				' .GetCalculationFrequency (index)  , index = 0... .GetNumberOfFrequencies-1
	
				Dim dFrequency As Double
				Dim sFrequency As String
	
				Dim nFreq_LFSolver_CST As Integer
				Dim iFreq_CST As Integer
	
				nFreq_LFSolver_CST = LFSolver.GetNumberOfFrequencies
	
				For iFreq_CST = 0 To nFreq_LFSolver_CST-1
	
					dFrequency = LFSolver.GetCalculationFrequency(iFreq_CST)
	
					' MsgBox CStr(iFreq_CST) + ".  ==>   Frq = " + CStr(dFrequency)
	
					sFrequency = "[" + CStr(dFrequency) + "]"
	
					aField(icount) = "Source Current Dens." + sFrequency
					icount  = icount + 1
					aField(icount) = "Cond. Current Dens." + sFrequency
					icount  = icount + 1
					aField(icount) = "Total Current Dens." + sFrequency
					icount  = icount + 1
					aField(icount) = "D-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "E-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "B-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "H-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "El. Energy Dens. " + sFrequency
					icount  = icount + 1
					aField(icount) = "Mag. Energy Dens. " + sFrequency
					icount  = icount + 1
					aField(icount) = "El. Loss Dens. " + sFrequency
					icount  = icount + 1
	
				Next iFreq_CST
	
				If nFreq_LFSolver_CST = 0 Then
	
					' take 50 Hz as default
	
					dFrequency = 50
					sFrequency = "[" + CStr(dFrequency) + "]"
	
					aField(icount) = "Source Current Dens." + sFrequency
					icount  = icount + 1
					aField(icount) = "Cond. Current Dens." + sFrequency
					icount  = icount + 1
					aField(icount) = "Total Current Dens." + sFrequency
					icount  = icount + 1
					aField(icount) = "D-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "E-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "B-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "H-Field " + sFrequency
					icount  = icount + 1
					aField(icount) = "El. Energy Dens. " + sFrequency
					icount  = icount + 1
					aField(icount) = "Mag. Energy Dens. " + sFrequency
					icount  = icount + 1
					aField(icount) = "El. Loss Dens. " + sFrequency
					icount  = icount + 1
	
				End If

			End If

		End If

		If (bPS) Then

			' in PS additionally take the particle space charge and current fields

			aField(icount) = "Particle Current"
			icount  = icount + 1

			aField(icount) = "Particle Space Charge"
			icount  = icount + 1

		End If

	End If

	n2D3DFields = icount

	ReDim sListArray(n2D3DFields)

	For nIndex = 0 To n2D3DFields-1
		sListArray(nIndex)=aField(nIndex)
	Next nIndex

End Sub
Function bScalarField (sField As String) As Boolean

	If (InStr(sField,"Dens.")>0 And InStr(sField,"Current")=0) Or (InStr(sField,"Electron")>0)  Or (InStr(sField,"Potential")>0) Or (InStr(sField,"Temperature")>0) Or (InStr(sField,"Pressure")>0) Or (InStr(sField,"Space Charge")>0 Or (InStr(sField,"Material")>0)) Then
		bScalarField = True
	Else
		bScalarField = False
	End If

	' special handling for mech stress solver
	If (InStr(sField,"Force Dens.")>0) Then
		bScalarField = False
	End If
	If (InStr(sField,"Strain\")=1 Or InStr(sField,"Stress\")=1) Then
		bScalarField = True
	End If

End Function
Sub CST_AppendFile (sfile1 As String, sfile2 As String)

	' this subroutine appends file2 to file1 (file1 is modified)

	If Dir$(sfile1) = "" Or Dir$(sfile2) = "" Then

		' Nothing done, one of the files does not exist

	Else

		Dim sline_cst1 As String

		Open sfile1 For Append As #11
		Open sfile2 For Input As #12

			' now copy all lines of #12 to the end of #11

			While Not EOF(12)
				Line Input #12, sline_cst1
				Print #11, sline_cst1
			Wend

		Close #12
		Close #11

	End If

End Sub
Sub Handle_0D_Results  (lib_action As String, lib_extension As String, lib_0Dtype As String, _
						lib_targetdir1 As String, lib_modfile As String, lib_dXValue_now As Double, lib_cXLabelNow As String)

	' this subroutine can be used to collect and plot arbitrary 0D Results, written in a file
	' action=write  /  plot   available

	'
	' in this subroutine targetdir must not have a backslash at the end
	'
	Dim lib_targetdir As String
	lib_targetdir = lib_targetdir1

	If Right(lib_targetdir1,1)="\" Then lib_targetdir = Left(lib_targetdir1,Len(lib_targetdir1)-1)

	Dim s0Dtargetmain As String, istartname As Integer, ilenpattern As Integer
	Dim lib_searchpath As String, lib_searchpattern As String, lib_dummy As String
	Dim mysigname As String, sm0dfile As String, iLenM0dfile As Integer, s0DName As String

	s0Dtargetmain = lib_targetdir + "\0D_" + lib_0Dtype + "_"

	'
	' define parameters for file search
	'
	Select Case lib_action

		Case "write"

			lib_searchpath = DirName(lib_modfile)
			lib_searchpattern = ShortName(lib_modfile) + "^*" + lib_extension
			istartname = Len(lib_modfile) + 2

		Case "plot"

			lib_searchpath = DirName(s0Dtargetmain)
			lib_searchpattern = ShortName(s0Dtargetmain) + "*.txt"
			istartname = Len(s0Dtargetmain) + 1

	End Select

	ilenpattern = Len(lib_searchpath) + Len(lib_searchpattern)

	mysigname = FindFirstFile(lib_searchpath , lib_searchpattern, False)

	While (mysigname <> "")

		sm0dfile = lib_searchpath + "\" + mysigname
		iLenM0dfile = Len(sm0dfile)

		s0DName = Mid(sm0dfile, istartname, iLenM0dfile-ilenpattern)

		Select Case lib_action

			Case "write"

				Open s0Dtargetmain + s0DName + ".txt" For Append As #12
					lib_dummy = ""
					Open sm0dfile For Input As #44
						Line Input #44, lib_dummy
					Close #44
					Print #12, CStr(lib_dXValue_now) + "   " +  lib_dummy
				Close #12

			Case "plot"

				With ResultTree
					.Reset
					.Type "XYSignal"
					.Xlabel lib_cXLabelNow
					.Title s0DName
					.Title "" ' otherwise no multiplot possible
					.Name "0D Results\" + lib_0Dtype + "\" + s0DName
					.File sm0dfile
					.Add
				End With

		End Select

		mysigname = FindNextFile
	Wend

End Sub
Function SolidPointCoordinatesSTEP(sName As String, index As String, x As Double, y As Double, z As Double) As Boolean

	If ( Solid.GetPointCoordinates(sName, index, x, y, z) ) Then
		SolidPointCoordinatesSTEP = True
	Else
		SolidPointCoordinatesSTEP = False
	End If

	' If RestoreGlobalDataValue("Step\Chk1") <> "11" Then	SolidPointCoordinatesSTEP = False

End Function

Function CurvePointCoordinatesSTEP(cName As String, index As String, x As Double, y As Double, z As Double) As Boolean
	If ( Curve.GetPointCoordinates(cName, index, x, y, z) ) Then
		CurvePointCoordinatesSTEP = True
	Else
		CurvePointCoordinatesSTEP = False
	End If

	' If RestoreGlobalDataValue("Step\Chk2") <> "23" Then CurvePointCoordinatesSTEP = False

End Function
Sub RemoveFileHeader(sfile As String)

	' this subroutine removes the header lines of sfile1 (file1 is modified)

	If Dir$(sfile) = "" Then
		' Nothing done, file does not exist
	Else
		Dim sline_cst1 As String
		Dim sfile2 As String

		Dim string_item(30) As String
		Dim cst_nitems As Integer

		sfile2 = sfile+"_tmp"

		Open sfile2 For Output As #11
		Open sfile For Input As #12

		Line Input #12, sline_cst1	'discard first line

		Dim bHeaderLine As Boolean
		bHeaderLine = True

		While (Not EOF(12) And bHeaderLine)
			Line Input #12, sline_cst1
			bHeaderLine = (Len(sline_cst1) <= 2) Or (InStr(sline_cst1,"="))
		Wend

		If Not bHeaderLine Then
			cst_nitems = CSTSplit(sline_cst1, string_item)
			if (cst_nitems>2) then
				' the new 2010 clipboard format might contain 3 colums, because of angle
				Print #11, string_item(1) + "   " + string_item(2)
			Else
				Print #11, string_item(0) + "   " + string_item(1)
			End If
		End If

		While Not EOF(12)
			Line Input #12, sline_cst1
			cst_nitems = CSTSplit(sline_cst1, string_item)
			if (cst_nitems>2) then
				' the new 2010 clipboard format might contain 3 colums, because of angle
				Print #11, string_item(1) + "   " + string_item(2)
			Else
				Print #11, string_item(0) + "   " + string_item(1)
			End If
		Wend

		Close #12
		Close #11

		FileCopy sfile2, sfile

		Kill sfile2

	End If

End Sub
Sub SelectSolids(aSolidArray_LIB() As String, nSolids_LIB As Integer)

	Dim cst_button As Integer
	Dim cst_Operation As String
	Dim cst_index As Long
	Dim cst_iii As Long

	Dim cst_solid_select_count As Integer
	Dim cst_solid_unselect_count As Integer
	Dim cst_solid_select_name(999) As String
	Dim cst_solid_unselect_name(999) As String

	Dim cst_solid As String
	Dim bSelected As Boolean

	cst_solid_unselect_count = 0
	cst_solid_select_count = 0

	For cst_index = 1 To Solid.GetNumberOfShapes
		cst_solid = Solid.GetNameOfShapeFromIndex(cst_index-1)
		bSelected = False
		For cst_iii = 1 To nSolids_LIB
			If (cst_solid = aSolidArray_LIB(cst_iii-1)) Then
				bSelected = True
				Exit For
			End If
		Next cst_iii

		If bSelected Then
			cst_solid_select_count = cst_solid_select_count + 1
			cst_solid_select_name(cst_solid_select_count) = cst_solid
		Else
			cst_solid_unselect_count = cst_solid_unselect_count + 1
			cst_solid_unselect_name(cst_solid_unselect_count) = cst_solid
		End If
	Next


	Begin Dialog UserDialog 550,238,"Selected Solids" ' %GRID:10,7,1,1
		Text 20,7,120,14,"Unselected",.LabelSource
		ComboBox 20,21,200,189,cst_solid_unselect_name(),.Unselect_box
		PushButton 240,49,70,28,"=====>",.AddAll
		PushButton 240,84,70,28,"----->",.Add
		PushButton 240,119,70,28,"<-----",.Remove
		PushButton 240,154,70,28,"<=====",.RemoveAll
		Text 330,7,90,14,"Selected",.LabelTarget
		ComboBox 330,21,200,189,cst_solid_select_name(),.Select_box
		OKButton 20,210,90,21
		CancelButton 120,210,90,21
	End Dialog
	Dim dlg_Solid_CST As UserDialog

	cst_Operation = ""

	Do
		cst_button = Dialog(dlg_Solid_CST)

        Select Case cst_button
			Case -1		' OK
				cst_Operation = "OK"
				'
			Case 1		' ====> add all probes
				For cst_iii = 1 To cst_solid_unselect_count
					cst_solid_select_count = cst_solid_select_count + 1
					cst_solid_select_name(cst_solid_select_count) = cst_solid_unselect_name(cst_iii)
					cst_solid_unselect_name(cst_iii) = ""
				Next
				cst_solid_unselect_count = 0
				'
			Case 2		' ----> add only one probe
				cst_solid_select_count = cst_solid_select_count + 1
				cst_solid_select_name(cst_solid_select_count) = dlg_Solid_CST.Unselect_box
				For cst_iii = 1 To cst_solid_unselect_count
					If (cst_solid_unselect_name(cst_iii) = dlg_Solid_CST.unselect_box) Then
						cst_solid_unselect_name(cst_iii) = ""
						dlg_Solid_CST.unselect_box = ""
					ElseIf (dlg_Solid_CST.unselect_box = "") Then
						dlg_Solid_CST.unselect_box = cst_solid_unselect_name(cst_iii)
					End If
				Next
				'
			Case 3	' <----
				cst_solid_unselect_count = cst_solid_unselect_count + 1
				cst_solid_unselect_name(cst_solid_unselect_count) = dlg_Solid_CST.select_box
				For cst_iii = 1 To cst_solid_select_count
					If (cst_solid_select_name(cst_iii) = dlg_Solid_CST.select_box) Then
						cst_solid_select_name(cst_iii) = ""
						dlg_Solid_CST.select_box = ""
					ElseIf (dlg_Solid_CST.select_box = "") Then
						dlg_Solid_CST.select_box = cst_solid_select_name(cst_iii)
					End If
				Next
				'
			Case 4	' <====
				For cst_iii = 1 To cst_solid_select_count
					cst_solid_unselect_count = cst_solid_unselect_count + 1
					cst_solid_unselect_name(cst_solid_unselect_count) = cst_solid_select_name(cst_iii)
					cst_solid_select_name(cst_iii) = ""
				Next
				cst_solid_select_count = 0
				dlg_Solid_CST.Select_box = ""
				'
			Case Else		' Cancel
				cst_Operation = "Quit"
		End Select

	Loop Until (cst_Operation <> "")

	If cst_Operation = "OK" Then

		' only update external solid-array, if OK is pressed, Cancel leaves array unchanged

		nSolids_LIB = cst_solid_select_count

		If (nSolids_LIB > 0) Then
			ReDim aSolidArray_LIB(nSolids_LIB-1)

			For cst_iii = 1 To nSolids_LIB
				aSolidArray_LIB(cst_iii-1) = cst_solid_select_name(cst_iii)
			Next
		End If

	End If

End Sub
Function DRound (cst_calue As Double, ndigits As Integer) As Double

	' DRound is rounding a double value to ndigits

	Dim nFactor As Long
	nFactor = 10^ndigits

	If (cst_calue*nFactor <= 1e9) Then
		DRound = CDbl(CLng(cst_calue*nFactor))/nFactor
	Else
		' too big for type "Long"
		DRound = cst_calue
	End If

End Function
Function mwsversion4 As Boolean
	If InStr(getmwsversion,"V 3") > 0 Then
     mwsversion4 = False
    Else
     mwsversion4 = True
    End If 
End Function
Sub DrawXYZPickPoints (sFileCoordxyz As String, nMaxPicks As Long)

	If Dir$(sFileCoordxyz)="" Then Exit Sub

	SelectTreeItem "Components"
	Plot.Wireframe True
	Pick.ClearAllPicks

	Dim iLineCounter As Long, iLastLine As Long, dDiffID As Double, dNextID As Double
	Dim sLine_lib As String, string_item(30) As String, cst_nitems As Integer

	iLineCounter = 0

    Open sFileCoordxyz For Input As #11
		While Not EOF(11)
			Line Input #11, sLine_lib
			iLineCounter = iLineCounter + 1
		Wend
    Close #11

    iLastLine = iLineCounter
    '
    ' --- now pick up to nMaxPicks points, always take first and last point
    '
	dDiffID = CDbl(iLastLine)/nMaxPicks
	dNextID = 0.0

    Open sFileCoordxyz For Input As #11
		While Not EOF(11)
			Line Input #11, sLine_lib
			iLineCounter = iLineCounter + 1
			If (iLineCounter = iLastLine Or iLineCounter > dNextID) Then
				' pick this point
				cst_nitems = CSTSplit(sLine_lib, string_item)
				Pick.PickPointFromCoordinates string_item(0),string_item(1),string_item(2)

				dNextID = dNextID + dDiffID
			End If
		Wend
    Close #11

	Plot.Update

End Sub

Sub RemoveFirstChars(sfile As String, ichar As Integer)

	Dim itotal As Integer
	itotal = Len(sfile)

	sfile = Right$(sfile,itotal-ichar)

End Sub
Sub RemoveLastChars(sfile As String, ichar As Integer)

	Dim itotal As Integer
	itotal = Len(sfile)

	sfile = Left$(sfile,itotal-ichar)

End Sub
