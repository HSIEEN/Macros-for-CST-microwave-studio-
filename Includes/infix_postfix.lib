End Function

Function Log3D(Operand As Object) As Object
	' Calculate log(z) - natural log
	Dim i As Long
	Dim zx As Complex, zy As Complex, zz As Complex ' complex vector components
	Dim dXReValues() As Double, dXImValues() As Double, dYReValues() As Double, dYImValues() As Double, dZReValues() As Double, dZImValues() As Double

	If (Operand.GetResultObjectType() = "3D") Then
		dXReValues = Operand.GetArray("xre")
		dXImValues = Operand.GetArray("xim")
		dYReValues = Operand.GetArray("yre")
		dYImValues = Operand.GetArray("yim")
		dZReValues = Operand.GetArray("zre")
		dZImValues = Operand.GetArray("zim")

	    For i = 0 To Operand.GetLength() - 1
	    	zx.re = dXReValues(i)
			zx.im = dXImValues(i)
	    	zy.re = dYReValues(i)
			zy.im = dYImValues(i)
	    	zz.re = dZReValues(i)
			zz.im = dZImValues(i)

			zx = zlog(zx)
			zy = zlog(zy)
			zz = zlog(zz)

			dXReValues(i) =  zx.re
			dXImValues(i) =  zx.im
			dYReValues(i) =  zy.re
			dYImValues(i) =  zy.im
			dZReValues(i) =  zz.re
			dZImValues(i) =  zz.im
	    Next

		Operand.SetArray(dXReValues, "xre")
		Operand.SetArray(dXImValues, "xim")
		Operand.SetArray(dYReValues, "yre")
		Operand.SetArray(dYImValues, "yim")
		Operand.SetArray(dZReValues, "zre")
		Operand.SetArray(dZImValues, "zim")
	ElseIf (Operand.GetResultObjectType() = "1DC") Then
		' 1DC Implementation
		Set Log3D = Log1DC(Operand)
	Else
		ReportError("Log3D: Unknown operand type " & Operand.GetResultObjectType() & ". Please contact support.")
	End If

	Set Log3D = Operand
End Function

Function Log103D(Operand As Object) As Object
	' Calculate log_10(z)
	Dim oTmpObject As Object

	Set oTmpObject = Result1DComplex("")
	oTmpObject.AppendXY(0, 1/Log(10), 0)

	Log3D(Operand)
	ComplexScalarMult3D(Operand, oTmpObject)

	Set Log103D = Operand
End Function
