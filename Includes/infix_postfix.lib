Function Sqr1DC(Operand As Object) As Object
	' Calculate sqrt(z)
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = ComplexSqrt(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Sqr1DC = Operand
End Function

Function Min1DC(Operand As Object) As Object
	' Return minimum of re(z), result is a real value
	Dim i As Long

	Dim MinValue As Double
	Dim dYReValues() As Double, dYImValues() As Double

	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	MinValue = dYReValues(0)
	For i = 1 To Operand.GetN-1
		If dYReValues(i) < MinValue Then MinValue = dYReValues(i)
	Next
	For i = 0 To Operand.GetN-1
		dYReValues(i) = MinValue
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Min1DC = Operand
End Function

Function Max1DC(Operand As Object) As Object
	' Return maximum of re(z), result is a real value
	Dim i As Long

	Dim MaxValue As Double
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	MaxValue = dYReValues(0)

	For i = 1 To Operand.GetN-1

		If dYReValues(i) > MaxValue Then MaxValue = dYReValues(i)
	Next
	For i = 0 To Operand.GetN-1
		dYReValues(i) = MaxValue
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Max1DC = Operand
End Function

Function Mean1DC(Operand As Object) As Object
	' Calculate mean value of re(z), result is a real value
	Dim i As Long, nSamples As Long
	Dim dYReValues() As Double, dYImValues() As Double

	nSamples = Operand.GetN()
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	If (nSamples>0) Then
		Dim MeanValue As Double
		MeanValue = 0
		For i = 0 To nSamples-1
			 MeanValue = MeanValue + dYReValues(i)
		Next
		MeanValue = MeanValue/nSamples
	Else
		ReportWarning("Mean1DC: Input object contains no data, cannot calculate mean.")
		MeanValue = lib_rundef
	End If
	For i = 0 To nSamples-1
		dYReValues(i) = MeanValue
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Mean1DC = Operand
End Function

Function MinMag1DC(Operand As Object) As Object
	' Return minimum of abs(z), result is a real value
	Dim i As Long

	Dim MinValue As Double, dCurrentAbs As Double
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	MinValue = Sqr(dYReValues(0)^2+Operand.GetYIm(0)^2)
	For i = 1 To Operand.GetN-1
		dCurrentAbs = Sqr(dYReValues(i)^2+dYImValues(i)^2)
		If dCurrentAbs < MinValue Then MinValue = dCurrentAbs
	Next
	For i = 0 To Operand.GetN-1
		dYReValues(i) = MinValue
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set MinMag1DC = Operand
End Function

Function MaxMag1DC(Operand As Object) As Object
	' Return maximum of abs(z), result is a real value
	Dim i As Long

	Dim MaxValue As Double, dCurrentAbs As Double
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	MaxValue = Sqr(dYReValues(0)^2+Operand.GetYIm(0)^2)
	For i = 1 To Operand.GetN-1
		dCurrentAbs = Sqr(dYReValues(i)^2+dYImValues(i)^2)
		If dCurrentAbs > MaxValue Then MaxValue = dCurrentAbs
	Next
	For i = 0 To Operand.GetN-1
		dYReValues(i) = MaxValue
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set MaxMag1DC = Operand
End Function

Function MeanMag1DC(Operand As Object) As Object
	' Calculate mean of abs(z), result is a real value
	Dim i As Long

	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	If (Operand.GetN()>0) Then
		Dim MeanValue As Double
		MeanValue = 0
		For i = 0 To Operand.GetN-1
			 MeanValue = MeanValue + Sqr(dYReValues(i)^2+dYImValues(i)^2)
		Next
		MeanValue = MeanValue/Operand.GetN()
	Else
		ReportWarning("Mean1DC: Input object contains no data, cannot calculate mean.")
		MeanValue = lib_rundef
	End If
	For i = 0 To Operand.GetN-1
		dYReValues(i) = MeanValue
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set MeanMag1DC = Operand
End Function

Function Abscissa1DC(Operand As Object) As Object
	' Return the x-axis of a 1DC curve
	Dim dXValues() As Double
	dXValues = Operand.GetArray("x")
	Operand.Initialize(UBound(dXValues)+1)
	Operand.SetArray(dXValues, "x")
	Operand.SetArray(dXValues, "yre")
	Set Abscissa1DC = Operand
End Function

Function Sgn1DC(Operand As Object) As Object
	' Calculate signum(z)
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		If absolute(z) <> 0 Then
			z = divsc(z, absolute(z))
		End If
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Sgn1DC = Operand
End Function

Function UnitStep1DC(Operand As Object) As Object
	' Calculate Heaviside step function(z)
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		' No unique definition exists for complex argument. Used here: Discard imaginary part
		z.re = dYReValues(i)
		If z.re < 0 Then
			z.re=0
		ElseIf z.re = 0 Then
			z.re = 1/2
		Else
			z.re=1
		End If
		dYReValues(i) = z.re
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set UnitStep1DC = Operand
End Function

Function Sinh1DC(Operand As Object) As Object
	' Calculate Sinh(z), z in rad
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = zsinh(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Sinh1DC = Operand
End Function

Function Asinh1DC(Operand As Object) As Object
	' Calculate Asinh(z), z in rad
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = zasinh(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Asinh1DC = Operand
End Function

Function Cosh1DC(Operand As Object) As Object
	' Calculate Cosh(z), z in rad
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = zcosh(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Cosh1DC = Operand
End Function

Function Acosh1DC(Operand As Object) As Object
	' Calculate Acosh(z), z in rad
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = zacosh(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Acosh1DC = Operand
End Function

Function Derivative1DC(Operand As Object, Order As Object) As Object
	' Calculate the derivative with respect to x iteratively until Order=0
	Dim i As Long, nSamples As Long
	Dim nOrder As Long, oNextOrder As Object
	Dim dXValues() As Double, dYReValues() As Double, dYImValues() As Double
	Dim dYReValues1() As Double, dYImValues1() As Double

	nSamples = Operand.GetN()
	nOrder = Order.GetYRe(0)
	If nOrder = 0 Then
		Set Derivative1DC = Operand
		Exit Function
	End If
	dXValues = Operand.GetArray("x")
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	ReDim dYReValues1(UBound(dYReValues))
	ReDim dYImValues1(UBound(dYImValues))

	dYReValues1(0) = (dYReValues(1)-dYReValues(0))/(dXValues(1)-dXValues(0))
	dYImValues1(0) = (dYImValues(1)-dYImValues(0))/(dXValues(1)-dXValues(0))
	For i = 1 To nSamples-2
		dYReValues1(i) = (dYReValues(i+1)-dYReValues(i-1))/(dXValues(i+1)-dXValues(i-1))
		dYImValues1(i) = (dYImValues(i+1)-dYImValues(i-1))/(dXValues(i+1)-dXValues(i-1))
	Next
	dYReValues1(nSamples-1) = (dYReValues(nSamples-1)-dYReValues(nSamples-2))/(dXValues(nSamples-1)-dXValues(nSamples-2))
	dYImValues1(nSamples-1) = (dYImValues(nSamples-1)-dYImValues(nSamples-2))/(dXValues(nSamples-1)-dXValues(nSamples-2))

	Operand.SetArray(dXValues, "x")
	Operand.SetArray(dYReValues1, "yre")
	Operand.SetArray(dYImValues1, "yim")

	If (nOrder > 1) Then
		nOrder = nOrder - 1
		Set oNextOrder = Result1DComplex("")
		oNextOrder.AppendXYDouble(0, nOrder, 0)
		Set Operand = Derivative1DC(Operand, oNextOrder)
	End If

	Set Derivative1DC = Operand
End Function

Function Integral1DC(Operand As Object) As Object
	' Calculate the integral dx of Operand (result is a single number)
	Dim dYReValues() As Double, dYImValues() As Double
	Dim i As Long, nSamples As Long, dIntegralRe As Double, dIntegralIm As Double

	Set Operand = CumulativeIntegral1DC(Operand)
	nSamples = Operand.GetN()
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	dIntegralRe = dYReValues(nSamples-1)
	dIntegralIm = dYImValues(nSamples-1)
	For i = 0 To nSamples-1
		dYReValues(i) = dIntegralRe
		dYImValues(i) = dIntegralIm
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Integral1DC = Operand
End Function

Function CumulativeIntegral1DC(Operand As Object) As Object
	' Calculate the integral dx of Operand (result is a function of x)

	Dim i As Long, nSamples As Long
	Dim dXValues() As Double, dYReValues() As Double, dYImValues() As Double
	Dim dIntegralRe() As Double, dIntegralIm() As Double
	Dim dAverageStep As Double, bIsEquidistant As Boolean

	nSamples = Operand.GetN()
	If (nSamples < 2) Then
		Set CumulativeIntegral1DC = Operand
		For i = 0 To nSamples-1
			CumulativeIntegral1DC.SetYRe(i) = 0
			CumulativeIntegral1DC.SetYim(i) = 0
		Next
		Exit Function
	End If
	dXValues = Operand.GetArray("x")
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	bIsEquidistant = True
	' Check if equidistant
	dAverageStep = (dXValues(nSamples-1)-dXValues(0))/(nSamples-1)
	For i = 0 To nSamples-2
		If Abs(dXValues(i+1)-dXValues(i)-dAverageStep) > 1e-6 Then
			bIsEquidistant = False
			Exit For
		End If
	Next

	ReDim dIntegralRe(nSamples-1)
	ReDim dIntegralIm(nSamples-1)
	dIntegralRe(0) = 0
	dIntegralIm(0) = 0
	If bIsEquidistant Then ' use Simpson's rule
		For i = 2 To nSamples-1 STEP 2
			dIntegralRe(i) = dIntegralRe(i-2) + (dXValues(i)-dXValues(i-2))/6*(dYReValues(i)+4*dYReValues(i-1)+dYReValues(i-2))
			dIntegralRe(i-1) = (dIntegralRe(i) + dIntegralRe(i-2))/2
			dIntegralIm(i) = dIntegralIm(i-2) + (dXValues(i)-dXValues(i-2))/6*(dYImValues(i)+4*dYImValues(i-1)+dYImValues(i-2))
			dIntegralIm(i-1) = (dIntegralIm(i) + dIntegralIm(i-2))/2
		Next
		If ((nSamples Mod 2) = 0) Then ' add last point using trapezoidal rule
			dIntegralRe(nSamples-1) = dIntegralRe(nSamples-2) + (dXValues(nSamples-1)-dXValues(nSamples-2))*(dYReValues(nSamples-1)+dYReValues(nSamples-2))/2
			dIntegralIm(nSamples-1) = dIntegralIm(nSamples-2) + (dXValues(nSamples-1)-dXValues(nSamples-2))*(dYImValues(nSamples-1)+dYImValues(nSamples-2))/2
		End If
	Else ' use trapezoidal rule
		For i = 1 To nSamples-1
			dIntegralRe(i) = dIntegralRe(i-1) + (dXValues(i)-dXValues(i-1))*(dYReValues(i)+dYReValues(i-1))/2
			dIntegralIm(i) = dIntegralIm(i-1) + (dXValues(i)-dXValues(i-1))*(dYImValues(i)+dYImValues(i-1))/2
		Next
	End If

	Operand.SetArray(dIntegralRe, "yre")
	Operand.SetArray(dIntegralIm, "yim")
	Set CumulativeIntegral1DC = Operand

End Function

Function Sum1DC(Operand As Object) As Object
	' Calculate the unweighted sum of all y values (result is a single number)
	Dim dYReValues() As Double, dYImValues() As Double
	Dim i As Long, nSamples As Long, dSumRe As Double, dSumIm As Double

	nSamples = Operand.GetN()
	ReDim dYReValues(nSamples - 1)
	ReDim dYImValues(nSamples - 1)

	Set Operand = CumulativeSum1DC(Operand)
	dSumRe = Operand.GetYRe(Operand.GetN() - 1)
	dSumIm = Operand.GetYIm(Operand.GetN() - 1)

	For i = 0 To nSamples-1
		dYReValues(i) = dSumRe
		dYImValues(i) = dSumIm
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Sum1DC = Operand
End Function

Function CumulativeSum1DC(Operand As Object) As Object
	' Calculate the unweighted cumulative sum of all y values

	Dim i As Long, nSamples As Long
	Dim dXValues() As Double, dYReValues() As Double, dYImValues() As Double
	Dim dSumRe() As Double, dSumIm() As Double

	nSamples = Operand.GetN()
	dXValues = Operand.GetArray("x")
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	ReDim dSumRe(nSamples - 1)
	ReDim dSumIm(nSamples - 1)
	dSumRe(0) = dYReValues(0)
	dSumIm(0) = dYImValues(0)
	For i = 1 To nSamples - 1
		dSumRe(i) = dSumRe(i - 1) + dYReValues(i)
		dSumIm(i) = dSumIm(i - 1) + dYImValues(i)
	Next

	Operand.SetArray(dSumRe, "yre")
	Operand.SetArray(dSumIm, "yim")
	Set CumulativeSum1DC = Operand

End Function

Function BooleanNot1DC(Operand1 As Object) As Object

	' Assume that Operand1 represents a Boolean where Im=0 and Re>0.5 represents TRUE, Re<=0.5 represents FALSE
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim i As Long

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")

	For i = 0 To UBound(dYReValues1)
		dYReValues1(i) = IIf(dYReValues1(i) > 0.5, 0, 1)
		dYImValues1(i) = 0
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set BooleanNot1DC = Operand1

End Function

Function Equal1DC(Operand1 As Object, Operand2 As Object) As Object

	' Return '1' wherever Operand1 = Operand2, '0' elsewhere
	Dim oTolerance As Object
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim i As Long

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")

	For i = 0 To UBound(dYReValues1)
		' allow 1e-9 for real and imag as tolerance to compensate for numerical error; equivalent to circle of radius 1.41e-9
		dYReValues1(i) = 1e-9
		dYImValues1(i) = 1e-9
	Next

	Set oTolerance = Result1DComplex("")
	oTolerance.Initialize(UBound(dYReValues1) + 1)

	oTolerance.SetArray(dYReValues1, "yre")
	oTolerance.SetArray(dYImValues1, "yim")

	Set Equal1DC = EqualWithTolerance1DC(Operand1, Operand2, oTolerance)

End Function

Function EqualWithTolerance1DC(Operand1 As Object, Operand2 As Object, Operand3 As Object) As Object

	' Return '1' wherever Operand1 = Operand2, '0' elsewhere
	' Operand3 serves as a tolerance threshold. If Operand1 is within a circle of radius Abs(Operand3) around Operand2, equality is satisfied
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim dXValues2() As Double, dYReValues2() As Double, dYImValues2() As Double
	Dim dXValues3() As Double, dYReValues3() As Double, dYImValues3() As Double
	Dim i As Long
	Dim dDistance As Double, dRadius As Double, dLength1 As Double, dLength2 As Double, dMaxLength As Double

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")
	dYReValues3 = Operand3.GetArray("yre")
	dYImValues3 = Operand3.GetArray("yim")

	For i = 0 To UBound(dYReValues1)
		' determine max length of the two vectors
		dLength1 = Sqr(dYReValues1(i)^2 + dYImValues1(i)^2)
		dLength2 = Sqr(dYReValues2(i)^2 + dYImValues2(i)^2)
		dMaxLength = IIf(dLength1 > dLength2, dLength1, dLength2)
		dDistance = Sqr((dYReValues2(i) - dYReValues1(i))^2 + (dYImValues2(i) - dYImValues2(i))^2)
		dRadius = Sqr(dYReValues3(i)^2 + dYImValues3(i)^2)
		' radius to be used as a relative quantity
		dYReValues1(i) = IIf(dDistance/dMaxLength <= dRadius, 1, 0)
		dYImValues1(i) = 0
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set EqualWithTolerance1DC = Operand1

End Function

Function NotEqual1DC(Operand1 As Object, Operand2 As Object) As Object

	' A shortcut for !=
	Set NotEqual1DC = BooleanNot1DC(Equal1DC(Operand1, Operand2))

End Function

Function Greater1DC(Operand1 As Object, Operand2 As Object) As Object

	' Return '1' wherever Operand1 > Operand2, '0' elsewhere; use Abs() for complex numbers
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim dXValues2() As Double, dYReValues2() As Double, dYImValues2() As Double
	Dim i As Long
	Dim bIsComplex As Boolean
	Dim dAbs1 As Double, dAbs2 As Double

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")

	' Check if input values are complex
	bIsComplex = False
	For i = 0 To UBound(dYReValues1)
		If (dYReValues1(i) = 0) Then
			If (dYImValues1(i) > 1e-9) Then
				' ReportInformation("Re1 = 0 and Im1 > 1e-9")
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues1(i)/dYReValues1(i) > 1e-6) Then
			' ReportInformation("Re1 <> 0 and Im1/Re1 > 1e-6")
			bIsComplex = True
			Exit For
		End If
		If (dYReValues2(i) = 0) Then
			If (dYImValues2(i) > 1e-9) Then
				' ReportInformation("Re2 = 0 and Im2 > 1e-9")
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues2(i)/dYReValues2(i) > 1e-6) Then
			' ReportInformation("Re2 <> 0 and Im2/Re2 > 1e-6")
			bIsComplex = True
			Exit For
		End If
	Next

	For i = 0 To UBound(dYReValues1)
		If bIsComplex Then
			dAbs1 = Sqr(dYReValues1(i)^2 + dYImValues1(i)^2)
			dAbs2 = Sqr(dYReValues2(i)^2 + dYImValues2(i)^2)
		Else
			dAbs1 = dYReValues1(i)
			dAbs2 = dYReValues2(i)
		End If
		dYReValues1(i) = IIf(dAbs1 > dAbs2, 1, 0)
		dYImValues1(i) = 0
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Greater1DC = Operand1

End Function

Function GreaterOrEqual1DC(Operand1 As Object, Operand2 As Object) As Object

	' Return '1' wherever Operand1 >= Operand2, '0' elsewhere; use Abs() for complex numbers
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim dXValues2() As Double, dYReValues2() As Double, dYImValues2() As Double
	Dim i As Long
	Dim bIsComplex As Boolean
	Dim dAbs1 As Double, dAbs2 As Double

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")

	' Check if input values are complex
	bIsComplex = False
	For i = 0 To UBound(dYReValues1)
		If (dYReValues1(i) = 0) Then
			If (dYImValues1(i) > 1e-9) Then
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues1(i)/dYReValues1(i) > 1e-6) Then
			bIsComplex = True
			Exit For
		End If
		If (dYReValues2(i) = 0) Then
			If (dYImValues2(i) > 1e-9) Then
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues2(i)/dYReValues2(i) > 1e-6) Then
			bIsComplex = True
			Exit For
		End If
	Next

	For i = 0 To UBound(dYReValues1)
		If bIsComplex Then
			dAbs1 = Sqr(dYReValues1(i)^2 + dYImValues1(i)^2)
			dAbs2 = Sqr(dYReValues2(i)^2 + dYImValues2(i)^2)
		Else
			dAbs1 = dYReValues1(i)
			dAbs2 = dYReValues2(i)
		End If
		dYReValues1(i) = IIf(dAbs1 >= dAbs2, 1, 0)
		dYImValues1(i) = 0
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set GreaterOrEqual1DC = Operand1

End Function

Function Less1DC(Operand1 As Object, Operand2 As Object) As Object

	' Return '1' wherever Operand1 < Operand2, '0' elsewhere; use Abs() for complex numbers
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim dXValues2() As Double, dYReValues2() As Double, dYImValues2() As Double
	Dim i As Long
	Dim bIsComplex As Boolean
	Dim dAbs1 As Double, dAbs2 As Double

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")

	' Check if input values are complex
	bIsComplex = False
	For i = 0 To UBound(dYReValues1)
		If (dYReValues1(i) = 0) Then
			If (dYImValues1(i) > 1e-9) Then
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues1(i)/dYReValues1(i) > 1e-6) Then
			bIsComplex = True
			Exit For
		End If
		If (dYReValues2(i) = 0) Then
			If (dYImValues2(i) > 1e-9) Then
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues2(i)/dYReValues2(i) > 1e-6) Then
			bIsComplex = True
			Exit For
		End If
	Next

	For i = 0 To UBound(dYReValues1)
		If bIsComplex Then
			dAbs1 = Sqr(dYReValues1(i)^2 + dYImValues1(i)^2)
			dAbs2 = Sqr(dYReValues2(i)^2 + dYImValues2(i)^2)
		Else
			dAbs1 = dYReValues1(i)
			dAbs2 = dYReValues2(i)
		End If
		dYReValues1(i) = IIf(dAbs1 < dAbs2, 1, 0)
		dYImValues1(i) = 0
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Less1DC = Operand1

End Function

Function LessOrEqual1DC(Operand1 As Object, Operand2 As Object) As Object

	' Return '1' wherever Operand1 <= Operand2, '0' elsewhere; use Abs() for complex numbers
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim dXValues2() As Double, dYReValues2() As Double, dYImValues2() As Double
	Dim i As Long
	Dim bIsComplex As Boolean
	Dim dAbs1 As Double, dAbs2 As Double

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")

	' Check if input values are complex
	bIsComplex = False
	For i = 0 To UBound(dYReValues1)
		If (dYReValues1(i) = 0) Then
			If (dYImValues1(i) > 1e-9) Then
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues1(i)/dYReValues1(i) > 1e-6) Then
			bIsComplex = True
			Exit For
		End If
		If (dYReValues2(i) = 0) Then
			If (dYImValues2(i) > 1e-9) Then
				bIsComplex = True
				Exit For
			End If
		ElseIf (dYImValues2(i)/dYReValues2(i) > 1e-6) Then
			bIsComplex = True
			Exit For
		End If
	Next

	For i = 0 To UBound(dYReValues1)
		If bIsComplex Then
			dAbs1 = Sqr(dYReValues1(i)^2 + dYImValues1(i)^2)
			dAbs2 = Sqr(dYReValues2(i)^2 + dYImValues2(i)^2)
		Else
			dAbs1 = dYReValues1(i)
			dAbs2 = dYReValues2(i)
		End If
		dYReValues1(i) = IIf(dAbs1 <= dAbs2, 1, 0)
		dYImValues1(i) = 0
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set LessOrEqual1DC = Operand1

End Function

Function IIF1DC(Operand1 As Object, Operand2 As Object, Operand3 As Object) As Object

	' Operand1 represents a Boolean object with values > 0.5 representing True and <= representing False (ideally 1 and 0)
	' Depending upon the value of Operand1, return either value of Operand2 or Operand3
	Dim dXValues1() As Double, dYReValues1() As Double, dYImValues1() As Double
	Dim dXValues2() As Double, dYReValues2() As Double, dYImValues2() As Double
	Dim dXValues3() As Double, dYReValues3() As Double, dYImValues3() As Double
	Dim i As Long

	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")
	dYReValues3 = Operand3.GetArray("yre")
	dYImValues3 = Operand3.GetArray("yim")

	For i = 0 To UBound(dYReValues1)
		dYReValues1(i) = IIf(dYReValues1(i) > 0.5, dYReValues2(i), dYReValues3(i))
		dYImValues1(i) = IIf(dYReValues1(i) > 0.5, dYImValues2(i), dYImValues3(i))
	Next

	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set IIF1DC = Operand1

End Function

Function Modulo1DC(Operand1 As Object, Operand2 As Object) As Object
	' Calculate Operand1 Mod Operand2. For complex numbers, Operand1/Operand2 is calculated in a complex manner.
	' Then, mod is calculated for real and imaginary parts separately
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	Dim dYReValues2() As Double, dYImValues2() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")
	' r = a - b.*floor(a./b)
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z2.re = dYReValues2(i)
		z2.im = dYImValues2(i)
		If ((z2.re = 0) And (z2.im = 0)) Then
			z.re = z.re
			z.im = z.im
		Else
			z = div(z1, z2)
			z.re = Int(z.re)
			z.im = Int(z.im)
			z = minus(z1, mult(z2, z))
		End If
		dYReValues1(i) = z.re
		dYImValues1(i) = z.im
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Modulo1DC = Operand1
End Function

Function Remainder1DC(Operand1 As Object, Operand2 As Object) As Object
	' Calculate Operand1 Rem Operand2. For complex numbers, Operand1/Operand2 is calculated in a complex manner.
	' Then, rem is calculated for real and imaginary parts separately
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	Dim dYReValues2() As Double, dYImValues2() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")
	' r = a - b.*fix(a./b)
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z2.re = dYReValues2(i)
		z2.im = dYImValues2(i)
		If ((z2.re = 0) And (z2.im = 0)) Then
			z.re = -lib_rundef
			z.im = -lib_rundef
		Else
			z = div(z1, z2)
			z.re = Fix(z.re)
			z.im = Fix(z.im)
			z = minus(z1, mult(z2, z))
		End If
		dYReValues1(i) = z.re
		dYImValues1(i) = z.im
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Remainder1DC = Operand1
End Function

Function Round1DC(Operand1 As Object, Operand2 As Object) As Object
	' Round re and im of Operand1 to the number of digits specified by the real part of Operand2
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	Dim dYReValues2() As Double, dYImValues2() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	' dYImValues2 = Operand2.GetArray("yim")
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z2.re = dYReValues2(i)
		' z2.im = dYImValues2(i)
		If (z2.re < 0) Then ReportWarningToWindow("Mix Template Results: Second argument of Round(#,#) needs to be larger than zero. Please check your settings.") ' Only report as warning to make sure it will be displayed in message box. Otherwise, error might get caught by wrap-around VBA engine and not displayed to user
		z.re = Round(z1.re, z2.re)
		z.im = Round(z1.im, z2.re)
		dYReValues1(i) = z.re
		dYImValues1(i) = z.im
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Round1DC = Operand1
End Function

Function Floor1DC(Operand1 As Object) As Object
	' Round re and im of Operand1 to the number of digits specified by the real part of Operand2
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z.re = Int(z1.re)
		z.im = Int(z1.im)
		dYReValues1(i) = z.re
		dYImValues1(i) = z.im
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Floor1DC = Operand1
End Function

Function Ceiling1DC(Operand1 As Object) As Object
	' Round re and im of Operand1 to the number of digits specified by the real part of Operand2
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z.re = Int(z1.re) + 1
		z.im = Int(z1.im) + 1
		dYReValues1(i) = z.re
		dYImValues1(i) = z.im
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Ceiling1DC = Operand1
End Function

' --- 3D Functions start here ---

Function DotProduct3D(Operand1 As Object, Operand2 As Object) As Object

	Dim dRealSum As Double, dImagSum As Double

	Operand1.DotProduct(Operand2, dRealSum, dImagSum)
	Set DotProduct3D = Operand1

End Function

Function VectorProduct3D(Operand1 As Object, Operand2 As Object) As Object

	Operand1.VectorProd(Operand2)
	Set VectorProduct3D = Operand1

End Function

Function ComponentProduct3D(Operand1 As Object, Operand2 As Object) As Object

	' Multiplies each component in Operand1 with each corresponding component in Operand2
	Dim i As Long, iMax As Long
	Dim oResult As Object, oInput1 As Object, oInput2 As Object
	Dim dX1Re() As Double, dX1Im() As Double, dY1Re() As Double, dY1Im() As Double, dZ1Re() As Double, dZ1Im() As Double
	Dim dX2Re() As Double, dX2Im() As Double, dY2Re() As Double, dY2Im() As Double, dZ2Re() As Double, dZ2Im() As Double
	Dim dXRe() As Double, dXIm() As Double, dYRe() As Double, dYIm() As Double, dZRe() As Double, dZIm() As Double

	If (Operand1.IsScalar And Operand2.IsScalar) Then
		Set oResult = Operand1
		dX1Re = Operand1.GetArray("xre")
		dX2Re = Operand2.GetArray("xre")
		iMax = UBound(dX1Re)
		If iMax <> UBound(dX2Re) Then ReportError("Error during field component multiplication. Input fields need to be of identical size.")
		dXRe = dX1Re

		If Operand1.IsComplex Then
			dX1Im = Operand1.GetArray("xim")
			dXIm = dX1Im
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i) - dX1Im(i) * dX2Im(i)
					dXIm(i) = dX1Im(i) * dX2Re(i) + dX1Re(i) * dX2Im(i)
				Next
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i)
					dXIm(i) = dX1Im(i) * dX2Re(i)
				Next
			End If
			oResult.SetArray(dXRe, "xre")
			oResult.SetArray(dXIm, "xim")
		Else
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dXIm = dX2Im
				For i = 0 To iMax
					dXRe(i) = dX2Re(i) * dX1Re(i)
					dXIm(i) = dX2Im(i) * dX1Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dXIm, "xim")
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
			End If
		End If
	ElseIf (Not(Operand1.IsScalar) And Not(Operand2.IsScalar)) Then
		' Both are vectors
		Set oResult = Operand1
		dX1Re = Operand1.GetArray("xre")
		dX2Re = Operand2.GetArray("xre")
		dY1Re = Operand1.GetArray("yre")
		dY2Re = Operand2.GetArray("yre")
		dZ1Re = Operand1.GetArray("zre")
		dZ2Re = Operand2.GetArray("zre")
		iMax = UBound(dX1Re)
		If iMax <> UBound(dX2Re) Then ReportError("Error during field component multiplication. Input fields need to be of identical size.")
		dXRe = dX1Re
		dYRe = dY1Re
		dZRe = dZ1Re

		If Operand1.IsComplex Then
			dX1Im = Operand1.GetArray("xim")
			dY1Im = Operand1.GetArray("yim")
			dZ1Im = Operand1.GetArray("zim")
			dXIm = dX1Im
			dYIm = dY1Im
			dZIm = dZ1Im
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dY2Im = Operand2.GetArray("yim")
				dZ2Im = Operand2.GetArray("zim")
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i) - dX1Im(i) * dX2Im(i)
					dXIm(i) = dX1Im(i) * dX2Re(i) + dX1Re(i) * dX2Im(i)
					dYRe(i) = dY1Re(i) * dY2Re(i) - dY1Im(i) * dY2Im(i)
					dYIm(i) = dY1Im(i) * dY2Re(i) + dY1Re(i) * dY2Im(i)
					dZRe(i) = dZ1Re(i) * dZ2Re(i) - dZ1Im(i) * dZ2Im(i)
					dZIm(i) = dZ1Im(i) * dZ2Re(i) + dZ1Re(i) * dZ2Im(i)
				Next
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i)
					dXIm(i) = dX1Im(i) * dX2Re(i)
					dYRe(i) = dY1Re(i) * dY2Re(i)
					dYIm(i) = dY1Im(i) * dY2Re(i)
					dZRe(i) = dZ1Re(i) * dZ2Re(i)
					dZIm(i) = dZ1Im(i) * dZ2Re(i)
				Next
			End If
			oResult.SetArray(dXRe, "xre")
			oResult.SetArray(dXIm, "xim")
			oResult.SetArray(dYRe, "yre")
			oResult.SetArray(dYIm, "yim")
			oResult.SetArray(dZRe, "zre")
			oResult.SetArray(dZIm, "zim")
		Else
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dY2Im = Operand2.GetArray("yim")
				dZ2Im = Operand2.GetArray("zim")
				dXIm = dX2Im
				dYIm = dY2Im
				dZIm = dZ2Im
				For i = 0 To iMax
					dXRe(i) = dX2Re(i) * dX1Re(i)
					dXIm(i) = dX2Im(i) * dX1Re(i)
					dYRe(i) = dY2Re(i) * dY1Re(i)
					dYIm(i) = dY2Im(i) * dY1Re(i)
					dZRe(i) = dZ2Re(i) * dZ1Re(i)
					dZIm(i) = dZ2Im(i) * dZ1Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dXIm, "xim")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dYIm, "yim")
				oResult.SetArray(dZRe, "zre")
				oResult.SetArray(dZIm, "zim")
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i)
					dYRe(i) = dY1Re(i) * dY2Re(i)
					dZRe(i) = dZ1Re(i) * dZ2Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dZRe, "zre")
			End If
		End If
	Else ' One is scalar, one is vector - make oInput1 the vector
		If Operand1.IsScalar Then
			Set oInput1 = Operand2
			Set oInput2 = Operand1
		Else
			Set oInput1 = Operand1
			Set oInput2 = Operand2
		End If
		Set oResult = oInput1

		dX1Re = oInput1.GetArray("xre")
		dY1Re = oInput1.GetArray("yre")
		dZ1Re = oInput1.GetArray("zre")
		dX2Re = oInput2.GetArray("xre")
		iMax = UBound(dX1Re)
		If iMax <> UBound(dX2Re) Then ReportError("Error during field component multiplication. Input fields need to be of identical size.")
		dXRe = dX1Re
		dYRe = dY1Re
		dZRe = dZ1Re

		If oInput1.IsComplex Then
			dX1Im = oInput1.GetArray("xim")
			dY1Im = oInput1.GetArray("yim")
			dZ1Im = oInput1.GetArray("zim")
			dXIm = dX1Im
			dYIm = dY1Im
			dZIm = dZ1Im
			If oInput2.IsComplex Then
				dX2Im = oInput2.GetArray("xim")
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i) - dX1Im(i) * dX2Im(i)
					dXIm(i) = dX1Im(i) * dX2Re(i) + dX1Re(i) * dX2Im(i)
					dYRe(i) = dY1Re(i) * dX2Re(i) - dY1Im(i) * dX2Im(i)
					dYIm(i) = dY1Im(i) * dX2Re(i) + dY1Re(i) * dX2Im(i)
					dZRe(i) = dZ1Re(i) * dX2Re(i) - dZ1Im(i) * dX2Im(i)
					dZIm(i) = dZ1Im(i) * dX2Re(i) + dZ1Re(i) * dX2Im(i)
				Next
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i)
					dXIm(i) = dX1Im(i) * dX2Re(i)
					dYRe(i) = dY1Re(i) * dX2Re(i)
					dYIm(i) = dY1Im(i) * dX2Re(i)
					dZRe(i) = dZ1Re(i) * dX2Re(i)
					dZIm(i) = dZ1Im(i) * dX2Re(i)
				Next
			End If
			oResult.SetArray(dXRe, "xre")
			oResult.SetArray(dXIm, "xim")
			oResult.SetArray(dYRe, "yre")
			oResult.SetArray(dYIm, "yim")
			oResult.SetArray(dZRe, "zre")
			oResult.SetArray(dZIm, "zim")
		Else
			If oInput2.IsComplex Then
				dX2Im = oInput2.GetArray("xim")
				dXIm = dX2Im
				dYIm = dX2Im
				dZIm = dX2Im
				For i = 0 To iMax
					dXRe(i) = dX2Re(i) * dX1Re(i)
					dXIm(i) = dX2Im(i) * dX1Re(i)
					dYRe(i) = dX2Re(i) * dY1Re(i)
					dYIm(i) = dX2Im(i) * dY1Re(i)
					dZRe(i) = dX2Re(i) * dZ1Re(i)
					dZIm(i) = dX2Im(i) * dZ1Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dXIm, "xim")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dYIm, "yim")
				oResult.SetArray(dZRe, "zre")
				oResult.SetArray(dZIm, "zim")
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) * dX2Re(i)
					dYRe(i) = dY1Re(i) * dX2Re(i)
					dZRe(i) = dZ1Re(i) * dX2Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dZRe, "zre")
			End If
		End If
	End If


End Function

Function ComponentDivision3D(Operand1 As Object, Operand2 As Object) As Object

	' Divide each component in Operand1 by each corresponding component in Operand2
	' To-Do: How to resolve division by 0, especially locally, for example in PEC areas

	Dim i As Long, iMax As Long
	Dim oResult As Object, oInput1 As Object, oInput2 As Object
	Dim dX1Re() As Double, dX1Im() As Double, dY1Re() As Double, dY1Im() As Double, dZ1Re() As Double, dZ1Im() As Double
	Dim dX2Re() As Double, dX2Im() As Double, dY2Re() As Double, dY2Im() As Double, dZ2Re() As Double, dZ2Im() As Double
	Dim dXRe() As Double, dXIm() As Double, dYRe() As Double, dYIm() As Double, dZRe() As Double, dZIm() As Double
	Dim dXAbs As Double, dYAbs As Double, dZAbs As Double

	If (Operand1.IsScalar And Operand2.IsScalar) Then
		Set oResult = Operand1
		dX1Re = Operand1.GetArray("xre")
		dX2Re = Operand2.GetArray("xre")
		iMax = UBound(dX1Re)
		If iMax <> UBound(dX2Re) Then ReportError("Error during field component multiplication. Input fields need to be of identical size.")
		dXRe = dX1Re

		If Operand1.IsComplex Then
			dX1Im = Operand1.GetArray("xim")
			dXIm = dX1Im
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				For i = 0 To iMax
					dXAbs = dX2Re(i)^2 + dX2Im(i)^2
					dXRe(i) = (dX1Re(i) * dX2Re(i) + dX1Im(i) * dX2Im(i)) / dXAbs
					dXIm(i) = (dX1Im(i) * dX2Re(i) - dX1Re(i) * dX2Im(i)) / dXAbs
				Next
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) / dX2Re(i)
					dXIm(i) = dX1Im(i) / dX2Re(i)
				Next
			End If
			oResult.SetArray(dXRe, "xre")
			oResult.SetArray(dXIm, "xim")
		Else
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dXIm = dX2Im
				For i = 0 To iMax
					dXAbs = dX2Re(i)^2 + dX2Im(i)^2
					dXRe(i) = dX1Re(i) * dX2Re(i) / dXAbs
					dXIm(i) = - dX1Re(i) * dX2Im(i) / dXAbs
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dXIm, "xim")
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) / dX2Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
			End If
		End If
	ElseIf (Not(Operand1.IsScalar) And Not(Operand2.IsScalar)) Then
		' Both are vectors
		Set oResult = Operand1
		dX1Re = Operand1.GetArray("xre")
		dX2Re = Operand2.GetArray("xre")
		dY1Re = Operand1.GetArray("yre")
		dY2Re = Operand2.GetArray("yre")
		dZ1Re = Operand1.GetArray("zre")
		dZ2Re = Operand2.GetArray("zre")
		iMax = UBound(dX1Re)
		If iMax <> UBound(dX2Re) Then ReportError("Error during field component multiplication. Input fields need to be of identical size.")
		dXRe = dX1Re
		dYRe = dY1Re
		dZRe = dZ1Re

		If Operand1.IsComplex Then
			dX1Im = Operand1.GetArray("xim")
			dY1Im = Operand1.GetArray("yim")
			dZ1Im = Operand1.GetArray("zim")
			dXIm = dX1Im
			dYIm = dY1Im
			dZIm = dZ1Im
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dY2Im = Operand2.GetArray("yim")
				dZ2Im = Operand2.GetArray("zim")
				For i = 0 To iMax
					dXAbs = dX2Re(i)^2 + dX2Im(i)^2
					dXRe(i) = (dX1Re(i) * dX2Re(i) + dX1Im(i) * dX2Im(i)) / dXAbs
					dXIm(i) = (dX1Im(i) * dX2Re(i) - dX1Re(i) * dX2Im(i)) / dXAbs
					dYAbs = dY2Re(i)^2 + dY2Im(i)^2
					dYRe(i) = (dY1Re(i) * dY2Re(i) + dY1Im(i) * dY2Im(i)) / dYAbs
					dYIm(i) = (dY1Im(i) * dY2Re(i) - dY1Re(i) * dY2Im(i)) / dYAbs
					dZAbs = dZ2Re(i)^2 + dZ2Im(i)^2
					dZRe(i) = (dZ1Re(i) * dZ2Re(i) + dZ1Im(i) * dZ2Im(i)) / dZAbs
					dZIm(i) = (dZ1Im(i) * dZ2Re(i) - dZ1Re(i) * dZ2Im(i)) / dZAbs
				Next
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) / dX2Re(i)
					dXIm(i) = dX1Im(i) / dX2Re(i)
					dYRe(i) = dY1Re(i) / dY2Re(i)
					dYIm(i) = dY1Im(i) / dY2Re(i)
					dZRe(i) = dZ1Re(i) / dZ2Re(i)
					dZIm(i) = dZ1Im(i) / dZ2Re(i)
				Next
			End If
			oResult.SetArray(dXRe, "xre")
			oResult.SetArray(dXIm, "xim")
			oResult.SetArray(dYRe, "yre")
			oResult.SetArray(dYIm, "yim")
			oResult.SetArray(dZRe, "zre")
			oResult.SetArray(dZIm, "zim")
		Else
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dY2Im = Operand2.GetArray("yim")
				dZ2Im = Operand2.GetArray("zim")
				dXIm = dX2Im
				dYIm = dY2Im
				dZIm = dZ2Im
				For i = 0 To iMax
					dXAbs = dX2Re(i)^2 + dX2Im(i)^2
					dXRe(i) = dX1Re(i) * dX2Re(i) / dXAbs
					dXIm(i) = - dX1Re(i) * dX2Im(i) / dXAbs
					dYAbs = dY2Re(i)^2 + dY2Im(i)^2
					dYRe(i) = dY1Re(i) * dY2Re(i) / dYAbs
					dYIm(i) = - dY1Re(i) * dY2Im(i) / dYAbs
					dZAbs = dZ2Re(i)^2 + dZ2Im(i)^2
					dZRe(i) = dZ1Re(i) * dZ2Re(i) / dZAbs
					dZIm(i) = - dZ1Re(i) * dZ2Im(i) / dZAbs
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dXIm, "xim")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dYIm, "yim")
				oResult.SetArray(dZRe, "zre")
				oResult.SetArray(dZIm, "zim")
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) / dX2Re(i)
					dYRe(i) = dY1Re(i) / dY2Re(i)
					dZRe(i) = dZ1Re(i) / dZ2Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dZRe, "zre")
			End If
		End If
	ElseIf Operand1.IsScalar Then ' Only division of vector/scalar makes sense
		ReportError("Error during field division. Division of scalar by vector is not defined.")
	Else
		Set oResult = Operand1

		dX1Re = Operand1.GetArray("xre")
		dY1Re = Operand1.GetArray("yre")
		dZ1Re = Operand1.GetArray("zre")
		dX2Re = Operand2.GetArray("xre")
		iMax = UBound(dX1Re)
		If iMax <> UBound(dX2Re) Then ReportError("Error during field component multiplication. Input fields need to be of identical size.")
		dXRe = dX1Re
		dYRe = dY1Re
		dZRe = dZ1Re

		If Operand1.IsComplex Then
			dX1Im = Operand1.GetArray("xim")
			dY1Im = Operand1.GetArray("yim")
			dZ1Im = Operand1.GetArray("zim")
			dXIm = dX1Im
			dYIm = dY1Im
			dZIm = dZ1Im
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				For i = 0 To iMax
					dXAbs = dX2Re(i)^2 + dX2Im(i)^2
					dXRe(i) = (dX1Re(i) * dX2Re(i) + dX1Im(i) * dX2Im(i)) / dXAbs
					dXIm(i) = (dX1Im(i) * dX2Re(i) - dX1Re(i) * dX2Im(i)) / dXAbs
					dYRe(i) = (dY1Re(i) * dX2Re(i) + dY1Im(i) * dX2Im(i)) / dXAbs
					dYIm(i) = (dY1Im(i) * dX2Re(i) - dY1Re(i) * dX2Im(i)) / dXAbs
					dZRe(i) = (dZ1Re(i) * dX2Re(i) + dZ1Im(i) * dX2Im(i)) / dXAbs
					dZIm(i) = (dZ1Im(i) * dX2Re(i) - dZ1Re(i) * dX2Im(i)) / dXAbs
				Next
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) / dX2Re(i)
					dXIm(i) = dX1Im(i) / dX2Re(i)
					dYRe(i) = dY1Re(i) / dX2Re(i)
					dYIm(i) = dY1Im(i) / dX2Re(i)
					dZRe(i) = dZ1Re(i) / dX2Re(i)
					dZIm(i) = dZ1Im(i) / dX2Re(i)
				Next
			End If
			oResult.SetArray(dXRe, "xre")
			oResult.SetArray(dXIm, "xim")
			oResult.SetArray(dYRe, "yre")
			oResult.SetArray(dYIm, "yim")
			oResult.SetArray(dZRe, "zre")
			oResult.SetArray(dZIm, "zim")
		Else
			If Operand2.IsComplex Then
				dX2Im = Operand2.GetArray("xim")
				dXIm = dX2Im
				dYIm = dX2Im
				dZIm = dX2Im
				For i = 0 To iMax
					dXAbs = dX2Re(i)^2 + dX2Im(i)^2
					dXRe(i) = (dX1Re(i) * dX2Re(i)) / dXAbs
					dXIm(i) = (- dX1Re(i) * dX2Im(i)) / dXAbs
					dYRe(i) = (dY1Re(i) * dX2Re(i)) / dXAbs
					dYIm(i) = (- dY1Re(i) * dX2Im(i)) / dXAbs
					dZRe(i) = (dZ1Re(i) * dX2Re(i)) / dXAbs
					dZIm(i) = (- dZ1Re(i) * dX2Im(i)) / dXAbs
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dXIm, "xim")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dYIm, "yim")
				oResult.SetArray(dZRe, "zre")
				oResult.SetArray(dZIm, "zim")
			Else
				For i = 0 To iMax
					dXRe(i) = dX1Re(i) / dX2Re(i)
					dYRe(i) = dY1Re(i) / dX2Re(i)
					dZRe(i) = dZ1Re(i) / dX2Re(i)
				Next
				oResult.SetArray(dXRe, "xre")
				oResult.SetArray(dYRe, "yre")
				oResult.SetArray(dZRe, "zre")
			End If
		End If
	End If

End Function

Function ComplexPower3D(Operand1 As Object, Operand2 As Object) As Object

	' Raise Operand1 to the complex power of Operand2
	' Operand1 expected to be Result3D or R1DC, Operand2 of Type Result1DComplex
	Dim sObjectType As String

	sObjectType = Operand1.GetResultObjectType

	Select Case sObjectType
		Case "1DC"
			Operand1.ZthPower(Operand2)
		Case "3D"
			If (Operand2.GetYIm(0) <> 0) Then ReportWarning("Mix 3D: Complex powers not yet implemented. Imaginary part will be ignored.")
			Operand1.Pow(Operand2.GetYRe(0))
	End Select

	Set ComplexPower3D = Operand1

End Function

Function ComplexScalarDiv3D(Operand1 As Object, Operand2 As Object) As Object

	' Divide Operand1 by Operand2
	' Operand1 expected to be Result3D or R1DC, Operand2 of Type Result1DComplex
	Dim oTempObject As Object
	Dim sObjectType As String

	sObjectType = Operand1.GetResultObjectType

	Select Case sObjectType
		Case "1DC"
			Operand1.ComponentDiv(Operand2)
		Case "3D"
			Set oTempObject = GetRes1DComplexFrom1DCNumeric(1,0)
			oTempObject.ComponentDiv(Operand2)
			ComplexScalarMult3D(Operand1, oTempObject)
	End Select

	Set ComplexScalarDiv3D = Operand1

End Function

Function ComplexScalarMult3D(Operand1 As Object, Operand2 As Object) As Object

	' Complex scalar multiplication; Operand1 should be the 3D field or R1DC, Operand2 a complex number, type Result1DComplex
	Dim oTempObject As Object
	Dim sOperand1Type As String, sOperand2Type As String
	Dim localOperand1 As Object, localOperand2 As Object

	sOperand1Type = Operand1.GetResultObjectType
	sOperand2Type = Operand2.GetResultObjectType

	' If one of the two operands is of type 3D, it should be first
	If ((sOperand1Type = "3D") And (sOperand2Type = "3D")) Then
		ReportError("ComplexScalarMult3D: Operands must not be both of type 3D. Please contact support.")
	ElseIf (sOperand2Type = "3D") Then
		Set localOperand1 = Operand2
		sOperand2Type = sOperand1Type
		Set localOperand2 = Operand1
		sOperand1Type = "3D"
	Else
		Set localOperand1 = Operand1
		Set localOperand2 = Operand2
	End If

	Select Case sOperand1Type
		Case "1DC"
			localOperand1.ComponentMult(localOperand2)
		Case "3D"
			If (Abs(localOperand2.GetYIm(0)) <= 1e-12 * (Abs(localOperand2.GetYRe(0)) + Abs(localOperand2.GetYIm(0)))) Then
				localOperand1.ScalarMult(localOperand2.GetYRe(0))
			ElseIf (localOperand2.GetYRe(0) = 0) Then
				If localOperand1.IsScalar() Then
					ReportError("ComplexScalarMult3D: Multiplication of a scalar field with a complex number is currently not supported. Please contact support.")
				End If
				Set oTempObject = localOperand1.Copy()
				localOperand1.ScalarMult3(0,0,0)
				' real part becomes imaginary part
				localOperand1.Combine(oTempObject, localOperand2.GetYIm(0), 3, 0)
				localOperand1.Combine(oTempObject, localOperand2.GetYIm(0), 4, 1)
				localOperand1.Combine(oTempObject, localOperand2.GetYIm(0), 5, 2)
				' imaginary part becomes -real part
				localOperand1.Combine(oTempObject, -localOperand2.GetYIm(0), 0, 3)
				localOperand1.Combine(oTempObject, -localOperand2.GetYIm(0), 1, 4)
				localOperand1.Combine(oTempObject, -localOperand2.GetYIm(0), 2, 5)
			Else
				If localOperand1.IsScalar() Then
					ReportError("ComplexScalarMult3D: Multiplication of a scalar field with a complex number is currently not supported. Please contact support.")
				End If
				Set oTempObject = localOperand1.Copy()
				localOperand1.ScalarMult3(0,0,0)
				' Product of two complex numbers: Re1*Re2 + Im1*Im2 + j * (Re1+Im2 - Im1*Re2)
				' real part stays real part
				localOperand1.Combine(oTempObject, localOperand2.GetYRe(0), 0, 0)
				localOperand1.Combine(oTempObject, localOperand2.GetYRe(0), 1, 1)
				localOperand1.Combine(oTempObject, localOperand2.GetYRe(0), 2, 2)
				' imaginary part stays imaginary part
				localOperand1.Combine(oTempObject, localOperand2.GetYRe(0), 3, 3)
				localOperand1.Combine(oTempObject, localOperand2.GetYRe(0), 4, 4)
				localOperand1.Combine(oTempObject, localOperand2.GetYRe(0), 5, 5)
				' real part becomes imaginary part
				localOperand1.Combine(oTempObject, localOperand2.GetYIm(0), 3, 0)
				localOperand1.Combine(oTempObject, localOperand2.GetYIm(0), 4, 1)
				localOperand1.Combine(oTempObject, localOperand2.GetYIm(0), 5, 2)
				' imaginary part becomes -real part
				localOperand1.Combine(oTempObject, -localOperand2.GetYIm(0), 0, 3)
				localOperand1.Combine(oTempObject, -localOperand2.GetYIm(0), 1, 4)
				localOperand1.Combine(oTempObject, -localOperand2.GetYIm(0), 2, 5)
			End If
	End Select

	' Set Operand1 to localOperand1, then set the function return value
	Set Operand1 = localOperand1
	Set ComplexScalarMult3D = Operand1

End Function

Function ComplexScalarMultByComp3D(Operand1 As Object, Operand2 As Object, Operand3 As Object, Operand4 As Object) As Object

	' Complex scalar multiplication by component; Operand1 should be the 3D field, Operand2-4 are complex numbers, type Result1DComplex
	Dim oTempObject As Object

	If ((Operand2.GetYIm(0) = 0) And (Operand3.GetYIm(0) = 0) And (Operand4.GetYIm(0) = 0)) Then
		Operand1.ScalarMult3(Operand2.GetYRe(0), Operand3.GetYRe(0), Operand4.GetYRe(0))
	Else
		Set oTempObject = Operand1.Copy()
		Operand1.ScalarMult3(0,0,0)
		' real part stays real part
		If (Operand2.GetYRe(0) <> 0) Then Operand1.Combine(oTempObject, Operand2.GetYRe(0), 0, 0)
		If (Operand3.GetYRe(0) <> 0) Then Operand1.Combine(oTempObject, Operand3.GetYRe(0), 1, 1)
		If (Operand4.GetYRe(0) <> 0) Then Operand1.Combine(oTempObject, Operand4.GetYRe(0), 2, 2)
		' imaginary part stays imaginary part
		If (Operand2.GetYRe(0) <> 0) Then Operand1.Combine(oTempObject, Operand2.GetYRe(0), 3, 3)
		If (Operand3.GetYRe(0) <> 0) Then Operand1.Combine(oTempObject, Operand3.GetYRe(0), 4, 4)
		If (Operand4.GetYRe(0) <> 0) Then Operand1.Combine(oTempObject, Operand4.GetYRe(0), 5, 5)
		' real part becomes imaginary part
		If (Operand2.GetYIm(0) <> 0) Then Operand1.Combine(oTempObject, Operand2.GetYIm(0), 3, 0)
		If (Operand3.GetYIm(0) <> 0) Then Operand1.Combine(oTempObject, Operand3.GetYIm(0), 4, 1)
		If (Operand4.GetYIm(0) <> 0) Then Operand1.Combine(oTempObject, Operand4.GetYIm(0), 5, 2)
		' imaginary part becomes -real part
		If (Operand2.GetYIm(0) <> 0) Then Operand1.Combine(oTempObject, -Operand2.GetYIm(0), 0, 3)
		If (Operand3.GetYIm(0) <> 0) Then Operand1.Combine(oTempObject, -Operand3.GetYIm(0), 1, 4)
		If (Operand4.GetYIm(0) <> 0) Then Operand1.Combine(oTempObject, -Operand4.GetYIm(0), 2, 5)
	End If
	Set ComplexScalarMultByComp3D = Operand1

End Function

Function Real3D(Operand As Object) As Object

	Dim oTempObject As Object, i As Long

	' Initialize empty object
	Set oTempObject = Operand.Copy()

	Operand.ScalarMult3(0, 0, 0)
	' Copy x/y/z real to real
	For i = 0 To 2
		Operand.Combine(oTempObject, 1, i, i)
	Next

	Set Real3D = Operand

End Function

Function Imag3D(Operand As Object) As Object

	Dim oTempObject As Object, i As Long

	Set oTempObject = Operand.Copy()

	Operand.ScalarMult3(0, 0, 0)
	' Copy x/y/z imag to real
	For i = 0 To 2
		Operand.Combine(oTempObject, 1, i, i+3)
	Next

	Set Imag3D = Operand

End Function

Function ExtractX3D(Operand As Object) As Object

	Dim oTempObject As Object

	Set oTempObject = Operand.Copy()

    Operand.ScalarMult3 0,0,0 'Set all to 0
	Operand.Combine(oTempObject, 1, 0, 0)
	Operand.Combine(oTempObject, 1, 3, 3)

	Set ExtractX3D = Operand

End Function

Function ExtractY3D(Operand As Object) As Object

	Dim oTempObject As Object

	Set oTempObject = Operand.Copy()

    Operand.ScalarMult3 0,0,0 'Set all to 0
	Operand.Combine(oTempObject, 1, 1, 1)
	Operand.Combine(oTempObject, 1, 4, 4)

	Set ExtractY3D = Operand

End Function

Function ExtractZ3D(Operand As Object) As Object

	Dim oTempObject As Object

	Set oTempObject = Operand.Copy()

    Operand.ScalarMult3 0,0,0 'Set all to 0
	Operand.Combine(oTempObject, 1, 2, 2)
	Operand.Combine(oTempObject, 1, 5, 5)

	Set ExtractZ3D = Operand

End Function

Function ConstVectorField3D(Operand As Object, dXConst As Object, dYConst As Object, dZConst As Object) As Object

	' Create a constant vector field with x/y/z components
	' Operand is a reference object to determine dimension of return field

	Dim i As Long
	Dim dXReValues() As Double, dXImValues() As Double, dYReValues() As Double, dYImValues() As Double, dZReValues() As Double, dZImValues() As Double

	dXReValues = Operand.GetArray("xre")
	dXImValues = Operand.GetArray("xim")
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	dZReValues = Operand.GetArray("zre")
	dZImValues = Operand.GetArray("zim")

    For i = 0 To Operand.GetLength() - 1
		dXReValues(i) =  dXConst.GetYRe(0)
		dXImValues(i) =  dXConst.GetYIm(0)
		dYReValues(i) =  dYConst.GetYRe(0)
		dYImValues(i) =  dYConst.GetYIm(0)
		dZReValues(i) =  dZConst.GetYRe(0)
		dZImValues(i) =  dZConst.GetYIm(0)
    Next

	Operand.SetArray(dXReValues, "xre")
	Operand.SetArray(dXImValues, "xim")
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Operand.SetArray(dZReValues, "zre")
	Operand.SetArray(dZImValues, "zim")

	Set ConstVectorField3D = Operand

End Function

Function ConstScalarField3D(Operand As Object, dConst As Object) As Object

	' Create a constant complex scalar field
	' Operand is a reference object to determine dimension of return field

	Dim i As Long
	Dim dReValues() As Double, dImValues() As Double

	dReValues = Operand.GetArray("xre")
    For i = 0 To Operand.GetLength() - 1
		dReValues(i) =  dConst.GetYRe(0)
    Next
	Operand.SetArray(dReValues, "xre")

	If (Operand.IsComplex()) Then
	   	dImValues = Operand.GetArray("xim")
	    For i = 0 To Operand.GetLength() - 1
			dImValues(i) =  dConst.GetYIm(0)
	    Next
		Operand.SetArray(dImValues, "xim")
	End If

	Set ConstScalarField3D = Operand

End Function

Function Sqr3D(Operand As Object) As Object

	Dim dTempXObject As Object, dTempYObject As Object, dTempZObject As Object
	Dim dTempArrayXRe() As Double, dTempArrayXIm() As Double, dTempArrayYRe() As Double, dTempArrayYIm() As Double, dTempArrayZRe() As Double, dTempArrayZIm() As Double

	If (Operand.GetResultObjectType() = "3D") Then
		Operand.Pow(0.5)
		Set Sqr3D = Operand
	ElseIf (Operand.GetResultObjectType() = "1DC") Then
		' 1DC Implementation
		Set Sqr3D = Sqr1DC(Operand)
	Else
		ReportError("Sqr3D: Unknown operand type " & Operand.GetResultObjectType() & ". Please contact support.")
	End If

End Function

Function MagnitudeByComponent3D(Operand As Object) As Object

	Dim oTempObject As Object, nLength As Long, i As Long, nX As Long, nY As Long, nZ As Long
	Dim dX1Re As Double, dY1Re As Double, dZ1Re As Double, dX1Im As Double, dY1Im As Double, dZ1Im As Double
	Dim dAmpX As Double, dAmpY As Double, dAmpZ As Double

	nLength = Operand.GetLength()
	For i =  0 To nLength-1
		Operand.GetDataFromIndex i, dX1Re, dY1Re, dZ1Re, dX1Im, dY1Im, dZ1Im

		dAmpX = Sqr((dX1Re^2 + dX1Im^2))
		dAmpY = Sqr((dY1Re^2 + dY1Im^2))
		dAmpZ = Sqr((dZ1Re^2 + dZ1Im^2))

		Operand.SetXRe i, dAmpX
		Operand.SetYRe i, dAmpY
		Operand.SetZRe i, dAmpZ
		Operand.SetXIm i, 0
		Operand.SetYIm i, 0
		Operand.SetZIm i, 0
	Next

	Set MagnitudeByComponent3D = Operand

End Function

Function Sin3D(Operand As Object) As Object
	' Calculate sin(z), z in rad
	Dim i As Long
	Dim zx As Complex, zy As Complex, zz As Complex ' complex vector components
	Dim dXReValues() As Double, dXImValues() As Double, dYReValues() As Double, dYImValues() As Double, dZReValues() As Double, dZImValues() As Double

	If (Operand.GetResultObjectType() = "3D") Then
		dXReValues = Operand.GetArray("xre")
		dXImValues = Operand.GetArray("xim")
		dYReValues = Operand.GetArray("yre")
		dYImValues = Operand.GetArray("yim")
		dZReValues = Operand.GetArray("zre")
		dZImValues = Operand.GetArray("zim")

	    For i = 0 To Operand.GetLength() - 1
	    	zx.re = dXReValues(i)
			zx.im = dXImValues(i)
	    	zy.re = dYReValues(i)
			zy.im = dYImValues(i)
	    	zz.re = dZReValues(i)
			zz.im = dZImValues(i)

			zx = zsin(zx)
			zy = zsin(zy)
			zz = zsin(zz)

			dXReValues(i) =  zx.re
			dXImValues(i) =  zx.im
			dYReValues(i) =  zy.re
			dYImValues(i) =  zy.im
			dZReValues(i) =  zz.re
			dZImValues(i) =  zz.im
	    Next

		Operand.SetArray(dXReValues, "xre")
		Operand.SetArray(dXImValues, "xim")
		Operand.SetArray(dYReValues, "yre")
		Operand.SetArray(dYImValues, "yim")
		Operand.SetArray(dZReValues, "zre")
		Operand.SetArray(dZImValues, "zim")
	ElseIf (Operand.GetResultObjectType() = "1DC") Then
		' 1DC Implementation
		Set Sin3D = Sin1DC(Operand)
	Else
		ReportError("Sin3D: Unknown operand type " & Operand.GetResultObjectType() & ". Please contact support.")
	End If

	Set Sin3D = Operand
End Function

Function SinD3D(Operand As Object) As Object
