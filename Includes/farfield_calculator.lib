	Dim dListValues() As Double
	Dim n_phi As Long, n_theta As Long
	
	Select Case nThetaOrPhiConst
		Case 1 ' constant theta
			' Check that EndAngle >= StartAngle+cst_degree
			If (dangEnd-dangStart < dStepSize) Then
				dangEnd = dangStart+dStepSize
				ReportWarningToWindow("PhiEnd has been automatically increased to PhiStart+stepsize")
			End If

			If (FFC_RunFFListCalculation(oSelSP, selected_ffname, tf_type, freq_time, bFFapprox, _
					dDistance, sCoordinateSystemType, dangConst, dangConst, dangStart, dangEnd, dStepSize, _
					sCalculationParameters, n_theta, n_phi)  <= 0) Then
				ReportError("Farfield result list contains no values. Please contact your local support team.")
			End If
		Case 2 ' constant phi
			' Check that EndAngle >= StartAngle+cst_degree
			If (dangEnd-dangStart < dStepSize) Then
				dangEnd = dangStart+dStepSize
				ReportWarningToWindow("ThetaEnd has been automatically increased to ThetaStart+stepsize")
			End If

			If (FFC_RunFFListCalculation(oSelSP, selected_ffname, tf_type, freq_time, bFFapprox, _
					dDistance, sCoordinateSystemType, dangStart, dangEnd, dangConst, dangConst, dStepSize, _
					sCalculationParameters, n_theta, n_phi)  <= 0) Then
				ReportError("Farfield result list contains no values. Please contact your local support team.")
			End If
	End Select
	dListValues = oSelSP.FarfieldCalculator.GetList(sMode, sCompString)

	FFC_Max_SubRange = Max_Lib(dListValues)
End Function

Function FFC_Min_SolidAngle(oSelSP As Object, selected_ffname As String, tf_type As String, freq_time As Double, bFFapprox As Boolean, dDistance As Double, sCoordinateSystemType As String, dthetaStart As Double, dthetaEnd As Double, dphiStart As Double, dphiEnd As Double, dStepSize As Double, sMode As String, sCompString As String, sCalculationParameters As String) As Double
	Dim dListValues() As Double
	Dim n_phi As Long, n_theta As Long
	
	' Check that EndAngle >= StartAngle+cst_degree
	If (dthetaEnd-dthetaStart < dStepSize) Then
		dthetaEnd = dthetaStart+dStepSize
		ReportWarningToWindow("ThetaEnd has been automatically increased to ThetaStart+stepsize")
	End If
	If (dphiEnd-dphiStart < dStepSize) Then
		dphiEnd = dphiStart+dStepSize
		ReportWarningToWindow("PhiEnd has been automatically increased to PhiStart+stepsize")
	End If

	If (FFC_RunFFListCalculation(oSelSP, selected_ffname, tf_type, freq_time, bFFapprox, _
	      dDistance, sCoordinateSystemType, dthetaStart, dthetaEnd, dphiStart, dphiEnd, dStepSize, _
		  sCalculationParameters, n_theta, n_phi)  <= 0) Then
		ReportError("Farfield result list contains no values. Please contact your local support team.")
	End If

	dListValues = oSelSP.FarfieldCalculator.GetList(sMode, sCompString)

	FFC_Min_SolidAngle = Min_Lib(dListValues)
End Function

Function FFC_Max_SolidAngle(oSelSP As Object, selected_ffname As String, tf_type As String, freq_time As Double, bFFapprox As Boolean, dDistance As Double, sCoordinateSystemType As String, dthetaStart As Double, dthetaEnd As Double, dphiStart As Double, dphiEnd As Double, dStepSize As Double, sMode As String, sCompString As String, sCalculationParameters As String) As Double
	Dim dListValues() As Double
	Dim n_phi As Long, n_theta As Long
	
	' Check that EndAngle >= StartAngle+cst_degree
	If (dthetaEnd-dthetaStart < dStepSize) Then
		dthetaEnd = dthetaStart+dStepSize
		ReportWarningToWindow("ThetaEnd has been automatically increased to ThetaStart+stepsize")
	End If
	If (dphiEnd-dphiStart < dStepSize) Then
		dphiEnd = dphiStart+dStepSize
		ReportWarningToWindow("PhiEnd has been automatically increased to PhiStart+stepsize")
	End If

	If (FFC_RunFFListCalculation(oSelSP, selected_ffname, tf_type, freq_time, bFFapprox, _
	      dDistance, sCoordinateSystemType, dthetaStart, dthetaEnd, dphiStart, dphiEnd, dStepSize, _
		  sCalculationParameters, n_theta, n_phi)  <= 0) Then
		ReportError("Farfield result list contains no values. Please contact your local support team.")
	End If

	dListValues = oSelSP.FarfieldCalculator.GetList(sMode, sCompString)

	FFC_Max_SolidAngle = Max_Lib(dListValues)
End Function

Sub FFC_ComputePhaseCenter (oSelSP As Object, selected_ffname As String, dfrq_now As Double, bFFapprox As Boolean, dDistance As Double, sPhaseCenterComponent As String, sPhaseCenterPlane As String, sPhaseCenterAngularLimit As String)
	Dim ff_distance As Double
	If (bFFapprox) Then
		' Farfield
		ff_distance = 0
	Else
		' Nearfield
		ff_distance = dDistance
	End If
	Dim ff_freq As Double
	ff_freq = 0
	If oSelSP.FarfieldCalculator.IsBroadbandMonitor(selected_ffname) Then
		ff_freq = dfrq_now
	End If
	oSelSP.FarfieldCalculator.CalculatePhaseCenter(selected_ffname, sPhaseCenterComponent, sPhaseCenterPlane, sPhaseCenterAngularLimit, ff_distance, ff_freq)
End Sub

Sub FFC_ComputeMainLobe (oSelSP As Object, selected_ffname As String, tf_type As String, freq_time As Double, bFFapprox As Boolean, dDistance As Double)
	Dim ff_distance As Double	
	If (bFFapprox) Then
		' Farfield
		ff_distance = 0
	Else
		' Nearfield
		ff_distance = dDistance
	End If

	oSelSP.FarfieldCalculator.CalculateMainlobe(selected_ffname, ff_distance, tf_type, freq_time)
End Sub

Function FFC_AverageValue (oSelSP As Object, selected_ffname As String, tf_type As String, freq_time As Double, bFFapprox As Boolean, dDistance As Double, sCoordinateSystemType As String, dthetaStart As Double, dthetaEnd As Double, dphiStart As Double, dphiEnd As Double, dStepSize As Double, sMode As String, sCompString As String, sCalculationParameters As String) As Double
	' Check that EndAngle >= StartAngle+cst_degree
	If (dthetaEnd-dthetaStart < dStepSize) Then
		dthetaEnd = dthetaStart+2*dStepSize
		ReportWarningToWindow("ThetaEnd has been automatically increased to ThetaStart+2*stepsize")
	End If
	If (dphiEnd-dphiStart < dStepSize) Then
		dphiEnd = dphiStart+2*dStepSize
		ReportWarningToWindow("PhiEnd has been automatically increased to PhiStart+2*stepsize")
	End If

	Dim dthetaValues() As Double, dphiValues() As Double, dyValues() As Double
	Dim dthetaValues_full() As Double, dphiValues_full() As Double, dyValues_full() As Double
	Dim componentSum As Double, solidAngleArea As Double
	Dim sIntegrationMethod As String
	sIntegrationMethod = "Boole"

	Dim i As Long, j As Long, n_phi As Long, n_theta As Long

	If (FFC_RunFFListCalculation(oSelSP, selected_ffname, tf_type, freq_time, bFFapprox, _
	      dDistance, sCoordinateSystemType, dthetaStart, dthetaEnd, dphiStart, dphiEnd, dStepSize, _
		  sCalculationParameters, n_theta, n_phi)  <= 0) Then
		ReportError("Farfield result list contains no values. Please contact your local support team.")
	End If

	ReDim dthetaValues(n_theta-1)
	ReDim dphiValues(n_phi-1)
	ReDim dyValues(n_theta-1, n_phi-1)

	dthetaValues_full = oSelSP.FarfieldCalculator.GetList(sMode, "Point_T")
	dphiValues_full = oSelSP.FarfieldCalculator.GetList(sMode, "Point_P")
	dyValues_full = oSelSP.FarfieldCalculator.GetList(sMode, sCompString)

	For i = 0 To n_theta-1
		dthetaValues(i) = dthetaValues_full(i*n_phi)*(Pi/180)
	Next
	For j = 0 To n_phi-1
		dphiValues(j) = dphiValues_full(j)*(Pi/180)
	Next
	For i=0 To n_theta-1
		For j = 0 To n_phi-1
			dyValues(i,j) = dyValues_full(i*n_phi+j)*Sin(dthetaValues(i)) ' include Jacobian here
		Next
	Next i
	componentSum = Integrate2D_LIB(dthetaValues(), dphiValues(), dyValues(), sIntegrationMethod)

	For i=0 To n_theta-1
		For j = 0 To n_phi-1
			dyValues(i,j) = Sin(dthetaValues(i)) ' include Jacobian here
		Next
	Next i
	solidAngleArea = Integrate2D_LIB(dthetaValues(), dphiValues(), dyValues(), sIntegrationMethod)
	' ReportInformationToWindow(CStr(Timer()-dStartTime) & ": " & CStr(solidAngleArea))

	FFC_AverageValue = componentSum/solidAngleArea
End Function

Function FFC_FFIntegral (oSelSP As Object, selected_ffname As String, tf_type As String, freq_time As Double, bFFapprox As Boolean, dDistance As Double, sCoordinateSystemType As String, dthetaStart As Double, dthetaEnd As Double, dphiStart As Double, dphiEnd As Double, dStepSize As Double, sMode As String, sCompString As String, sCalculationParameters As String) As Double
	' Check that EndAngle >= StartAngle+cst_degree
	If (dthetaEnd-dthetaStart < dStepSize) Then
		dthetaEnd = dthetaStart+2*dStepSize
		ReportWarningToWindow("ThetaEnd has been automatically increased to ThetaStart+2*stepsize")
	End If
	If (dphiEnd-dphiStart < dStepSize) Then
		dphiEnd = dphiStart+2*dStepSize
		ReportWarningToWindow("PhiEnd has been automatically increased to PhiStart+2*stepsize")
	End If

	Dim dthetaValues() As Double, dphiValues() As Double, dyValues() As Double
	Dim dthetaValues_full() As Double, dphiValues_full() As Double, dyValues_full() As Double
	Dim sIntegrationMethod As String
	sIntegrationMethod = "Boole"

	Dim i As Long, j As Long, n_phi As Long, n_theta As Long

	If (FFC_RunFFListCalculation(oSelSP, selected_ffname, tf_type, freq_time, bFFapprox, _
	      dDistance, sCoordinateSystemType, dthetaStart, dthetaEnd, dphiStart, dphiEnd, dStepSize, _
		  sCalculationParameters, n_theta, n_phi)  <= 0) Then
		ReportError("Farfield result list contains no values. Please contact your local support team.")
	End If

	ReDim dthetaValues(n_theta-1)
	ReDim dphiValues(n_phi-1)
	ReDim dyValues(n_theta-1, n_phi-1)

	dthetaValues_full = oSelSP.FarfieldCalculator.GetList(sMode, "Point_T")
	dphiValues_full = oSelSP.FarfieldCalculator.GetList(sMode, "Point_P")
	dyValues_full = oSelSP.FarfieldCalculator.GetList(sMode, sCompString)

	For i = 0 To n_theta-1
		dthetaValues(i) = dthetaValues_full(i*n_phi)*(Pi/180)
	Next
	For j = 0 To n_phi-1
		dphiValues(j) = dphiValues_full(j)*(Pi/180)
	Next
	For i=0 To n_theta-1
		For j = 0 To n_phi-1
			dyValues(i,j) = dyValues_full(i*n_phi+j)*Sin(dthetaValues(i)) ' include Jacobian here
		Next
	Next i

	FFC_FFIntegral = Integrate2D_LIB(dthetaValues(), dphiValues(), dyValues(), sIntegrationMethod)
End Function

Function FFC_RadEfficiency(oSelSP As Object, selected_ffname As String, dfrq_now As Double, bDS As Boolean) As Double
	Dim dFF_freq As Double
	Dim dRadEff As Double, dSysRadEff As Double
	dFF_freq = 0
	If oSelSP.FarfieldCalculator.IsBroadbandMonitor(selected_ffname) Then
		dFF_freq = dfrq_now
	End If
	dSysRadEff = oSelSP.FarfieldCalculator.GetSystemRadiationEfficiency(selected_ffname, dFF_freq)
	dRadEff = oSelSP.FarfieldCalculator.GetRadiationEfficiency(selected_ffname, dFF_freq)
	If (bDS) Then
		FFC_RadEfficiency = dSysRadEff
		If (FFC_RadEfficiency <= 0) Then
			ReportWarning("Farfield Template: System efficiency is less than or equal to zero. As a fallback, efficiency will be calculated without system information.")
			FFC_RadEfficiency = dRadEff
		End If
	Else
		If ( dSysRadEff > 0) Then
			ReportInformation("Farfield Template: System information exists but is not considered for efficiency calculation. Please define this template in the 'Schematic' tab to include system information.")
		End If
		FFC_RadEfficiency = dRadEff
	End If
End Function

Function FFC_TotEfficiency(oSelSP As Object, selected_ffname As String, dfrq_now As Double, bDS As Boolean) As Double
	Dim dFF_freq As Double
	Dim dTotEff As Double, dSysTotEff As Double
	dFF_freq = 0
	If oSelSP.FarfieldCalculator.IsBroadbandMonitor(selected_ffname) Then
		dFF_freq = dfrq_now
	End If
	dSysTotEff = oSelSP.FarfieldCalculator.GetSystemTotalEfficiency(selected_ffname, dFF_freq)
	dTotEff = oSelSP.FarfieldCalculator.GetTotalEfficiency(selected_ffname, dFF_freq)
	If (bDS) Then
		FFC_TotEfficiency = dSysTotEff
		If (FFC_TotEfficiency <= 0) Then
			ReportWarning("Farfield Template: System efficiency is less than or equal to zero. As a fallback, efficiency will be calculated without system information.")
			FFC_TotEfficiency = dTotEff
		End If
	Else
		If ( dSysTotEff > 0) Then
			ReportInformation("Farfield Template: System information exists but is not considered for efficiency calculation. Please define this template in the 'Schematic' tab to include system information.")
		End If
		FFC_TotEfficiency = dTotEff
	End If
End Function

Function FFC_PowerRatioSolidAngle(oSelSP As Object, selected_ffname As String, tf_type As String, freq_time As Double, dDistance As Double, sCoordinateSystemType As String, dthetaStart As Double, dthetaEnd As Double, dphiStart As Double, dphiEnd As Double, dStepSize As Double, sCompString As String) As Double	
	Dim dPowerInSolidAngle As Double, dTotalPower As Double
	' Return "1" if full sphere and Abs component is requested
	If ((Abs(dthetaEnd-dthetaStart-180)<1e-6) And (Abs(dphiEnd-dphiStart-360)<1e-6) And _
			((sCompString = "Abs") Or _
				((UBound(Split(sCompString, " ")) = 1) And (LCase(Right(sCompString, 4)) = " abs") ))) Then
		FFC_PowerRatioSolidAngle = 1.
	Else
		oSelSP.FarfieldCalculator.SetScaleLinear(True)
		dPowerInSolidAngle = FFC_FFIntegral(oSelSP, selected_ffname, tf_type, freq_time, True, dDistance, sCoordinateSystemType, dthetaStart, dthetaEnd, dphiStart, dphiEnd, dStepSize, "PField", sCompString, "farfield")
		dTotalPower = FFC_FFIntegral(oSelSP, selected_ffname, tf_type, freq_time, True, dDistance, sCoordinateSystemType, 0., 180., 0., 360., dStepSize, "PField", sCoordinateSystemType & " abs", "farfield")
		FFC_PowerRatioSolidAngle = dPowerInSolidAngle/dTotalPower
	End If
End Function

Function FFC_TotalACS(oSelSP As Object, selected_ffname As String, dfrq_now As Double, sRCSUnit As String) As Double
	Dim dFF_freq As Double
	dFF_freq = 0
	If oSelSP.FarfieldCalculator.IsBroadbandMonitor(selected_ffname) Then
		dFF_freq = dfrq_now
	End If
	FFC_TotalACS = oSelSP.FarfieldCalculator.GetTotalACS(selected_ffname, dFF_freq, sRCSUnit)
End Function

Function FFC_TotalRCS(oSelSP As Object, selected_ffname As String, dfrq_now As Double, sRCSUnit As String) As Double
	Dim dFF_freq As Double
	dFF_freq = 0
	If oSelSP.FarfieldCalculator.IsBroadbandMonitor(selected_ffname) Then
		dFF_freq = dfrq_now
	End If
	FFC_TotalRCS = oSelSP.FarfieldCalculator.GetTotalRCS(selected_ffname, dFF_freq, sRCSUnit)
End Function