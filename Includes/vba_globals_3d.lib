Function GetMaterialFoldersAndNames_LIB(Optional sLocatedInMaterialFolder As String, Optional sMaterialType As String) As Variant
	' oSelectedSP is determined here again in addition to the calls in Evaluate0D/1D/...
	' This ensures that the lib remains compatible with old templates that do not store a script setting "SPName"
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	' This function parses all material entries and returns the folders as well as the materials it found
	' The user may restrict the materials listed to materials in a certain folder or of a certain type

	' Inputs:
	'	Optional sLocatedInMaterialFolder As String	:	Only materials in this folder will be included in sMaterialList;
	'													if no folder is given, this value defaults to "" and only materials in the main
	'													material folder will be listed. Use "CST_ALLFOLDERS" to list all materials in all folders
	'	Optional sMaterialType As String			:	If this string is not empty, only materials of the given type will be listed;
	'													if no type is given, this value defaults to "" and all materials will be listed.
	' Output/Return values:
	'	GetMaterialFoldersAndNames_LIB As Variant	:	An array of two elements, first element is a string array containing the folder list,
	'													second element is a string array containing the list of material names

	Dim nMaterials As Long, i As Long, j As Long
	Dim sMaterialList() As String, sMaterialFolderList() As String
	Dim sSplitMaterialEntry() As String, sFoundMaterialName As String, sFoundMaterialFolder As String, sFoundMaterialType As String

	If ((sLocatedInMaterialFolder="<Main folder>") Or (sLocatedInMaterialFolder = "")) Then
		sLocatedInMaterialFolder = ""
	' Append "/" if none at the end
	ElseIf (Mid(sLocatedInMaterialFolder, Len(sLocatedInMaterialFolder),1) = "/") Then
		sLocatedInMaterialFolder = sLocatedInMaterialFolder
	Else
		sLocatedInMaterialFolder = sLocatedInMaterialFolder + "/"
	End If

	ReDim sMaterialFolderList(0)
	sMaterialFolderList(0) = "<Main folder>"
	ReDim sMaterialList(0)
	nMaterials = oSelectedSP.Material.GetNumberOfMaterials
	For i = 0 To nMaterials-1
		sSplitMaterialEntry = Split(oSelectedSP.Material.GetNameOfMaterialFromIndex(i),"/")
		sFoundMaterialName = sSplitMaterialEntry(UBound(sSplitMaterialEntry))
		sFoundMaterialType = oSelectedSP.Material.GetTypeOfMaterial(oSelectedSP.Material.GetNameOfMaterialFromIndex(i))
		If (((sMaterialType<>"") And (sFoundMaterialType<>sMaterialType)) _
			Or (sFoundMaterialName = "air_0")) Then
			' Do nothing if type is no match or if material is "air_0"
		Else
			' Determine material folder and go from there
			sFoundMaterialFolder = ""
			If (UBound(sSplitMaterialEntry) > 0) Then
				For j = 0 To UBound(sSplitMaterialEntry)-1
					sFoundMaterialFolder = sFoundMaterialFolder + sSplitMaterialEntry(j) + IIf(j=UBound(sSplitMaterialEntry),"","/")
				Next j
				' See if folder is already in list
				For j = 0 To UBound(sMaterialFolderList)
					If sFoundMaterialFolder = sMaterialFolderList(j) Then Exit For
				Next j
				If j = UBound(sMaterialFolderList)+1 Then ' loop above finished, a new folder was found
					ReDim Preserve sMaterialFolderList(UBound(sMaterialFolderList)+1)
					sMaterialFolderList(UBound(sMaterialFolderList)) = sFoundMaterialFolder
				End If
			End If

			' If the current folder matched sLocatedInMaterialFolder or if all folder are selected, add material to list
			If ((sLocatedInMaterialFolder = "CST_ALLFOLDERS") _
				Or (sLocatedInMaterialFolder = sFoundMaterialFolder))Then
				ReDim Preserve sMaterialList(UBound(sMaterialList)+1)
				sMaterialList(UBound(sMaterialList)) = sFoundMaterialName
			End If

		End If
	Next

	GetMaterialFoldersAndNames_LIB = Array(sMaterialFolderList,sMaterialList)
End Function


''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' Function GetAllSelectedShapes_LIB
' Returns number of selected shapes and fills dynamic string array 
' "sSelectedShapes" with names of selected shapes (according to solid
' object convention)
''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
Function GetAllSelectedShapes_LIB(sSelectedShapes() As String, Optional bPreferShapes As Boolean = True) As Long
	' oSelectedSP is determined here again...
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	' Declare...
	Dim lRunInd1       As Long
	Dim lRunInd2       As Long
	Dim lNumSelShapes  As Long
	Dim lNumSelEntries As Long
	Dim sShapes()      As String
	Dim sComponents()  As String
	Dim sCurrSelection As String
	Dim sCurrShape     As String
	Dim bComponents    As Boolean
	Dim lShapeIndex    As Long
	Dim lCompIndex     As Long
	Dim sCompBaseDir   As String

	' Initialize
	bComponents    = False  ' Starting assumption - no components are selected...
	lNumSelEntries = oSelectedSP.GetNumberOfSelectedTreeItems()
	ReDim sShapes(oSelectedSP.Solid.GetNumberOfShapes())
	ReDim sComponents(lNumSelEntries)
	lShapeIndex  = 0
	lCompIndex   = 0
	sCompBaseDir = "Components"

	If lNumSelEntries = 0 Then
		ReDim sShapes(0)
		ReDim sComponents(0)
	ElseIf lNumSelEntries = 1 Then
		sCurrSelection = oSelectedSP.GetSelectedTreeItem()
		' Check special case that components base directory is selected (this means there is only one tree selection...)
		If sCurrSelection = sCompBaseDir then
			' all shapes should be selected...
			lShapeIndex = oSelectedSP.Solid.GetNumberOfShapes()
			For lRunInd1 = 0 To lShapeIndex-1 Step 1
				sShapes(lRunInd1) = oSelectedSP.Solid.GetNameOfShapeFromIndex(lRunInd1)
			Next lRunInd1
		Else
			lRunInd2       = ShapeComponentOrOther_LIB(sCurrSelection)
			If lRunInd2 = 0 Then
				' Selection is a shape...
				ReDim sShapes(0)
				sShapes(0)  = Convert2ShapeName_LIB(sCurrSelection)
				lShapeIndex = 1
			ElseIf lRunInd2 = 1 Then
				ReDim sComponents(0)
				sComponents(0) = Convert2ComponentName_LIB(sCurrSelection)
				bComponents = True
				lCompIndex  = 1
			ElseIf lRunInd2 = 2 Then
				If bPreferShapes Then ' in case of naming conflict, take shape
					ReDim sShapes(0)
					sShapes(0)  = Convert2ShapeName_LIB(sCurrSelection)
					lShapeIndex = 1
				Else
					ReDim sComponents(0)
					sComponents(0) = Convert2ComponentName_LIB(sCurrSelection)
					bComponents = True
					lCompIndex  = 1
				End If
			End If
		End If
	Else
		' There is more then one tree entry selected / go through selection in tree...
		' First selected treeitem
		sCurrSelection = oSelectedSP.GetSelectedTreeItem()
		lRunInd2       = ShapeComponentOrOther_LIB(sCurrSelection)
		If lRunInd2 = 0 Then
			sShapes(lShapeIndex) = Convert2ShapeName_LIB(sCurrSelection)
			lShapeIndex          = lShapeIndex + 1
		ElseIf lRunInd2 = 1 Then
			sComponents(lCompIndex) = Convert2ComponentName_LIB(sCurrSelection)
			lCompIndex              = lCompIndex + 1
			bComponents             = True
		ElseIf lRunInd2 = 2 Then
			If bPreferShapes Then ' in case of naming conflict, take shape
				sShapes(lShapeIndex) = Convert2ShapeName_LIB(sCurrSelection)
				lShapeIndex          = lShapeIndex + 1
			Else
				sComponents(lCompIndex) = Convert2ComponentName_LIB(sCurrSelection)
				lCompIndex              = lCompIndex + 1
				bComponents             = True
			End If
		End If

		' Now take care of the rest of the selected treeitems
		For lRunInd1 = 2 To lNumSelEntries STEP 1
			sCurrSelection = oSelectedSP.GetNextSelectedTreeItem()
			lRunInd2       = ShapeComponentOrOther_LIB(sCurrSelection)
			If lRunInd2 = 0 Then
				sShapes(lShapeIndex) = Convert2ShapeName_LIB(sCurrSelection)
				lShapeIndex          = lShapeIndex + 1
			ElseIf lRunInd2 = 1 Then
				sComponents(lCompIndex) = Convert2ComponentName_LIB(sCurrSelection)
				lCompIndex              = lCompIndex + 1
				bComponents             = True
			ElseIf lRunInd2 = 2 Then
				If bPreferShapes Then ' in case of naming conflict, take shape
					sShapes(lShapeIndex) = Convert2ShapeName_LIB(sCurrSelection)
					lShapeIndex          = lShapeIndex + 1
				Else
					sComponents(lCompIndex) = Convert2ComponentName_LIB(sCurrSelection)
					lCompIndex              = lCompIndex + 1
					bComponents             = True
				End If
			End If
		Next lRunInd1
	End If

	' At this point all selected treeitems of interest have been assigned to either sShapes or sComponents
	' Next, go through all shapes and check if they are part of the selected components
	' Shapes cannot come up twice, since selecting a component in the tree containing a shape will automatically remove the explicit selection of that shape...
	If bComponents Then
		' First, trim components array
		ReDim Preserve sComponents(lCompIndex-1)
		For lRunInd1 = 0 To oSelectedSP.Solid.GetNumberOfShapes()-1 STEP 1
			sCurrShape = oSelectedSP.Solid.GetNameOfShapeFromIndex(lRunInd1)
			For lRunInd2 = 0 To UBound(sComponents) STEP 1
				If Left(sCurrShape, Len(sComponents(lRunInd2))) = sComponents(lRunInd2) Then
					' shape must be part of component - add to array, increase index and exit for loop
					sShapes(lShapeIndex) = sCurrShape
					lShapeIndex          = lShapeIndex + 1
					Exit For
				End If
			Next lRunInd2
		Next lRunInd1
	End If

	' At this point all selected shapes should have been processed - trim shape array
	If lShapeIndex > 0 Then
		ReDim Preserve sShapes(lShapeIndex-1)
		ReDim sSelectedShapes(lShapeIndex-1)
		For lRunInd1 = 0 To UBound(sShapes) STEP 1
			sSelectedShapes(lRunInd1) = sShapes(lRunInd1)
		Next lRunInd1
	Else
		ReDim sSelectedShapes(0)
	End If

	GetAllSelectedShapes_LIB = lShapeIndex
End Function


'''''''''''''''''''''''''''''''''''''''''''''''''''''
' Function ShapeComponentOrOther_LIB
' Accepts treeitem (in ResultTree style) and returns:
' 0 if shape exists with that name but no component
' 1 if component exists with that name, but no shape
' 2 if a shape and a component with that name exist
' 3 otherwise.
'''''''''''''''''''''''''''''''''''''''''''''''''''''
Private Function ShapeComponentOrOther_LIB(sTreeSelection As String) As Integer
	' oSelectedSP is determined here again...
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	Dim lReturnvalue   As Integer
	Dim sCompBaseName  As String
	Dim sShapeName     As String
	Dim sComponentName As String
	Dim bIsComponent   As Boolean
	Dim bIsShape       As Boolean
	Dim lRunIndex      As Long

	sCompBaseName = "Components\"
	bIsComponent  = False
	bIsShape      = False

	' Initialize...
	lReturnvalue = 3

	If Len(sTreeSelection) > Len(sCompBaseName) then
		If Left(sTreeSelection, Len(sCompBaseName)) = sCompBaseName then
			' Treeitem present in Components section of tree.
			' Switch to naming convention that would be used for components
			sComponentName = Replace(Right(sTreeSelection, Len(sTreeSelection)-Len(sCompBaseName)), "\", "/")
			If oSelectedSP.Component.DoesExist(sComponentName) Then
				bIsComponent = True
			End if
			' Switch to naming convention as used in the Solid object...
			lRunIndex = InStrRev(sComponentName, "/")
			If lRunIndex > 0 Then
				sShapeName = Mid(sComponentName, 1, lRunIndex - 1) & Replace(sComponentName, "/", ":", lRunIndex)
				If oSelectedSP.Solid.DoesExist(sShapeName) Then
					bIsShape = True
				End If
			End If
			If bIsComponent And bIsShape Then
				lReturnvalue = 2
			ElseIf bIsComponent Then
				lReturnvalue = 1
			ElseIf bIsShape Then
				lReturnvalue = 0
			End If
		End If
	End If

	ShapeComponentOrOther_LIB = lReturnvalue
End Function


'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' Function Convert2ShapeName_LIB
' Converts string to a format consistent with the Solid object,
' assuming a tree item in a format consisten with the
' ResultTree object.
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
Private Function Convert2ShapeName_LIB(sTreeName As String) As String
	' oSelectedSP is determined here again...
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	' Declare...
	Dim sCompBaseName  As String
	Dim sShapeName     As String
	Dim lRunIndex      As Long

	' Initialize...
	sCompBaseName = "Components\"

	sShapeName = Replace(Right(sTreeName, Len(sTreeName)-Len(sCompBaseName)), "\", "/")
	lRunIndex = InStrRev(sShapeName, "/")
	sShapeName = Mid(sShapeName, 1, lRunIndex - 1) & Replace(sShapeName, "/", ":", lRunIndex)

	Convert2ShapeName_LIB = sShapeName
End Function


'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' Function Convert2ComponentName_LIB
' Converts string to a format consistent with the Component object,
' assuming a tree item in a format consisten with the ' ResultTree
' object.
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
Private Function Convert2ComponentName_LIB(sTreeName As String) As String
	' oSelectedSP is determined here again...
	Dim sSelectedSPName As String
	sSelectedSPName = GetScriptSetting("SPName", "")
	If oSelectedSP Is Nothing Then Set oSelectedSP = GetSimulationProjectByName_LIB(sSelectedSPName)

	' Declare...
	Dim sCompBaseName  As String
	Dim sComponentName As String

	' Initialize...
	sCompBaseName = "Components\"

	sComponentName = Replace(Right(sTreeName, Len(sTreeName)-Len(sCompBaseName)), "\", "/")
	Convert2ComponentName_LIB = sComponentName
End Function
