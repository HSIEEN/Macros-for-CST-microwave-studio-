'
' This library provides functions in particular for the result template "Template Type Conversions"
'
' Please note:
' ============
'  1) Newly added functions should always end with "_LIB" to indicate they are located in a library
'  2) adding this lib requires adding of the template_conversions.lib
'			include "template_conversions.lib"
'			include "template_results.lib"
'  3) to function in standalone DS, Option explicit has to be disabled/deleted
'
'
' Version history:
'
' ================================================================================================
' Copyright 2014-2023 Dassault Systemes Deutschland GmbH
' ================================================================================================
' History of Changes
' ----------------------------------------------------------------------------------------------------------------------------------------------------------
' 11-Nov-2022 set: Only call DS.GetTreeNameScriptSetting when it is available (in DS context)
' 11-Jun-2020 fsr: Truncated anticipated results when total number of results reaches 65534
' 31-Jan-2020 fsr: Always trim any unused entries from result arrays generated by GetListOfAnticipatedResults_LIB()
' 12-Nov-2018 fsr: Performance improvements for filling tree results and anticipated results (by default now limited to 100 ports)
' 23-Oct-2018 fsr: Fixed FillResultList for 2D/3D and Farfield results in 'DS for ...' environments
' 30-Jul-2018 fsr: Improved filter function documentation; filter now uses tagged separators, e.g. #+ instead of +, to avoid naming conflicts
' 30-Mar-2018 fsr: FillResultList now also uses ResultTree.GetTreeResults for 2D/3D and farfield results, instead deprecated GetNextTreeResult_LIB
' 10-Feb-2018 fsr: Added reference impedances to list of anticipated results
' 11-May-2017 fsr: Fixed type filter for tree entries in FillFillResultList
' 14-Feb-2017 fsr: FillResultList now uses ResultTree.GetTreeResults instead of VBA implementation
' 02-Dec-2016 mwi: Corrected anticipated result entries for TRK, split WAK, TRK, PIC to ensure only showing relevant entries here
' 08-Sep-2016 fsr: Fixed potential infinite loops in IsIncluded_LIB when more than 1 wildcard was used in filter
' 04-May-2016 fsr: Improved filter behavior for template class & type filtering
' 19-Apr-2016 fsr: Allow M1D templates (not just the 1D results it creates) to show up so they can be selected for continued "Multiple" processing
' 01-Mar-2016 fsr: Allow 3D results to show up in "DS for" environment types
' 11-Dec-2015 fsr: Changed tree folder for anticipated Eigenmode results from "Frequency" to "Mode Frequencies"
' 09-Apr-2015 fsr: 2D/3D result list was empty if only 1 result was present
' 25-Mar-2015 fsr: Filter includes are now case insensitive; excludes remain case sensitive; improved 2D/3D/FF filtering in DS tree
' 19-Mar-2015 fsr: Replace DSResultFolder only once (important now that DS results from SPs are available); generalized FillResultList; fixed name filter
' 08-Oct-2014 fsr: New functions: FillResultsList and GetListOfAnticipatedResults
' ----------------------------------------------------------------------------------------------------------------------------------------------------------
'
'
' ----------------------------------- FillResultList and GetListOfAnticipatedResults --------------------------

Sub FillResultList_LIB(ByRef sTemplateNameList() As String, ByRef sTemplateTypeList() As String, sName As String, _
						sIncludedTypes As String, _
						ByRef sIncludedNames As String, _
						sIncludedClasses As String, _
						Optional sListOfSelectionSettings As String, _
						Optional sListOfSelectionTypeSettings As String)

	' For backwards compatibility
	FillResultList1D2D3DFF_LIB(sTemplateNameList, sTemplateTypeList, sName, _
								sIncludedTypes & "-2D3D-FF-2d3dresult-farfield", sIncludedNames, sIncludedClasses, _
								sListOfSelectionSettings, sListOfSelectionTypeSettings)

End Sub

Sub FillResultList1D2D3DFF_LIB(ByRef sTemplateNameList() As String, ByRef sTemplateTypeList() As String, sName As String, _
								sIncludedTypes As String, _
								ByRef sIncludedNames As String, _
								sIncludedClasses As String, _
								Optional sListOfSelectionSettings As String, _
								Optional sListOfSelectionTypeSettings As String)

	' This subroutine accepts 2 arrays (sTemplateNameList and sTemplateTypeList) and adds results
	' sName: The name of the current template; needed to avoid self-listing
	' sIncludedTypes: Use to select or block specific types.
	' sIncludedNames: Use to select or block specific names.
	' sIncludedClasses: Use to select or block specific classes (TEMPLATE/TREE/ANTICIPATED).
	' sListOfSelectionSettings: A list of script settings that have result names stored. Separated by pipe |
	' sListOfSelectionTypeSettings: A list of script settings that have result types stored. Separated by pipe |
	' For all sIncluded: Use "ALL" for all, or a list of items preceded by '+', e.g.: "+1D+0D". To block, use 'ALL' and a list of items preceded by '-', e.g.: "ALL-1D-0D".
	' Similarly, '*' and '/' to include results that contain the followed text but are not necessarily identical. For example "*port" would include everything that contains 'port'

	Dim icount As Long, istart As Long, i As Long, j As Long
	Dim aRTemplateName_Local() As String, aRTemplateType_Local() As String
	Dim sResultName As String, sTemplateType As String, sTemplateName As String, sTemplateFolder As String, sTempString As String
	Dim sTreeResultPathList As Variant, sTreeResultTypeList As Variant, sTreeResultFileNameList As Variant, sTreeResultInfoList As Variant, nResults As Long
	Dim sTreeResultPath As String, sTreeResultType As String, sTreeResultFileName As String
	Dim sArrayOfSelectionSettings() As String, sArrayOfSelectionTypeSettings() As String, sSelectionSetting As String
	Dim sListOfExpectedResults() As String ' A 2D array containing name and type of expected results
	Dim bIsDSEnvironment As Boolean, bIsDSForEnvironment As Boolean
	Dim oTreeObjectToCall As Object
	Dim dStartTime As Double

	dStartTime = Timer()

	bIsDSEnvironment = (Left(GetApplicationName, 2) = "DS")
	bIsDSForEnvironment = (Left(GetApplicationName, 6) = "DS for")
	
	If (bIsDSEnvironment) Then
		Set oTreeObjectToCall = DSResultTree
	Else
		Set oTreeObjectToCall = Resulttree
	End If

	icount = 0
	ReDim aRTemplateName_Local(icount)
	ReDim aRTemplateType_Local(icount)
	aRTemplateName_Local(0) = "Unselected"
	aRTemplateType_Local(0) = "Undefined"

	' Add current selections to list, no matter if they exists or not. This way, there will be no issues with opening dialog when selected item is deleted.
	If (sListOfSelectionSettings <> "") Then
		sArrayOfSelectionSettings = Split(sListOfSelectionSettings, "|")
		sArrayOfSelectionTypeSettings = Split(sListOfSelectionTypeSettings, "|")

		For i = 0 To UBound(sArrayOfSelectionSettings)
			If bIsDSEnvironment Then
				sSelectionSetting = Replace(DS.GetTreeNameScriptSetting(sArrayOfSelectionSettings(i), ""),DSResultFolder_LIB + "\", "", 1, 1)
			Else
				sSelectionSetting = GetScriptSetting(sArrayOfSelectionSettings(i), "")
			End If
			If ((sSelectionSetting <> "") And (sSelectionSetting <> "Unselected")) Then
				icount = icount + 1
				ReDim Preserve aRTemplateName_Local(icount)
				ReDim Preserve aRTemplateType_Local(icount)
				aRTemplateName_Local(icount) = sSelectionSetting
				aRTemplateType_Local(icount) = GetScriptSetting(sArrayOfSelectionTypeSettings(i), "")
			End If
		Next
	End If

	istart = icount
	If IsIncluded_LIB("TEMPLATE", sIncludedClasses) Then
		' Add result templates and a header, if they exist
		ResetTemplateIterator()
		If GetNextTemplate(sResultName,sTemplateType,sTemplateName,sTemplateFolder) Then
			icount = icount + 1
			ReDim Preserve aRTemplateName_Local(icount)
			ReDim Preserve aRTemplateType_Local(icount)
			aRTemplateName_Local(icount) = "---------- RESULT TEMPLATES ----------"
			aRTemplateType_Local(icount) = "VOID"
		End If
		ResetTemplateIterator()
		While GetNextTemplate(sResultName,sTemplateType,sTemplateName,sTemplateFolder)
			If ((sResultName <> sName) And IsIncluded_LIB(sTemplateType, sIncludedTypes)) Then
				If ((Left(sTemplateType, 1) <> "M") And IsIncluded_LIB(sResultName, sIncludedNames)) Then
						icount = icount + 1
						ReDim Preserve aRTemplateName_Local(icount)
						ReDim Preserve aRTemplateType_Local(icount)
						aRTemplateName_Local(icount) = sResultName
						aRTemplateType_Local(icount) = sTemplateType
				Else
					' template type "multiple"
					If ((InStr(sIncludedTypes, "-MultipleFolder") = 0) And IsIncluded_LIB(sResultName, sIncludedNames)) Then
						' Unless excluded, the M*D template will show up and can be used
						' used as a folder to treat all results created by the M*D template
						icount = icount + 1
						ReDim Preserve aRTemplateName_Local(icount)
						ReDim Preserve aRTemplateType_Local(icount)
						aRTemplateName_Local(icount) = sResultName
						aRTemplateType_Local(icount) = sTemplateType
					End If
					' Remove 'M' for the actual results in the folder
					sTemplateType = Replace(sTemplateType, "M", "", 1, 1)
					If (InStr(sIncludedTypes, "-MultipleTables") = 0) Then
						sTempString = GetFirstTableResult(sResultName)
						While (sTempString <> "")
							If IsIncluded_LIB(sTempString, sIncludedNames) Then
								' Add all the results created by M*D to the list; set the type to *D.
								icount  = icount + 1
								ReDim Preserve aRTemplateName_Local(icount)
								ReDim Preserve aRTemplateType_Local(icount)
								aRTemplateName_Local(icount) = sTempString
								aRTemplateType_Local(icount) = sTemplateType
							End If
							' ReportInformationToWindow(sTempString & " : " & sTemplateType)
							sTempString = GetNextTableResult(sResultName)
						Wend
					End If
				End If
			End If
		Wend
	   	ResetTemplateIterator() ' needs to be reset for "GetLastResult1DComplex" to work further below
	   	If (icount = istart + 1) Then
			icount = istart ' Dial back by one to remove first/header entry if it is the only entry
			ReDim Preserve aRTemplateName_Local(icount)
			ReDim Preserve aRTemplateType_Local(icount)
	   	End If
	End If
	' ReportInformationToWindow("Templates after: " + CStr(Timer()-dStartTime) +"secs")
	' dStartTime = Timer()

	istart = icount
	If IsIncluded_LIB("TREE", sIncludedClasses) Then
		' Add header
		icount  = icount + 1
		ReDim Preserve aRTemplateName_Local(icount)
		ReDim Preserve aRTemplateType_Local(icount)
		aRTemplateName_Local(icount) = "---------- RESULTS IN TREE ----------"
		aRTemplateType_Local(icount) = "VOID"

	   	' Add tree results and a header, if they exist
	   	' Meta types: 1DRES, 2D3D, FF can only be excluded
		If (InStr(sIncludedTypes, "-1DRES")=0) Then
			nResults = oTreeObjectToCall.GetTreeResults(IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB), "0D/1D recursive", "filetype0D1D", sTreeResultPathList, sTreeResultTypeList, sTreeResultFileNameList, sTreeResultInfoList)

			For i = 0 To nResults - 1
		    	If IsIncluded_LIB(sTreeResultInfoList(i), sIncludedTypes) Then
		    		If IsIncluded_LIB(sTreeResultPathList(i), sIncludedNames) Then
						icount  = icount + 1
						ReDim Preserve aRTemplateName_Local(icount)
						ReDim Preserve aRTemplateType_Local(icount)
						' Only replace if ResultFolder is at beginning of sTreeResultPath
						If InStr(sTreeResultPathList(i),IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB))=1 Then
							aRTemplateName_Local(icount) = Replace(sTreeResultPathList(i), IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB)+"\", "", 1, 1)
						Else
							aRTemplateName_Local(icount) = sTreeResultPathList(i)
						End If
						aRTemplateType_Local(icount) = sTreeResultInfoList(i)
					End If
				Else
					' Do nothing, ignore type "unknown"
				End If
			Next
		End If
		If (InStr(sIncludedTypes, "-2D3D")=0) Then
			If bIsDSForEnvironment Then Set oTreeObjectToCall = Resulttree ' 3D results should be grabbed from 3D tree, even in 'DS for' environment
			nResults = oTreeObjectToCall.GetTreeResults("2D/3D Results", "2D/3D recursive", "", sTreeResultPathList, sTreeResultTypeList, sTreeResultFileNameList, sTreeResultInfoList)

			For i = 0 To nResults - 1
		    	'If IsIncluded_LIB(sTreeResultInfoList(i), sIncludedTypes) Then ' deactivated, currently no further subdivision of types
		    		If IsIncluded_LIB(sTreeResultPathList(i), sIncludedNames) Then
						icount  = icount + 1
						ReDim Preserve aRTemplateName_Local(icount)
						ReDim Preserve aRTemplateType_Local(icount)
						' Only replace if ResultFolder is at beginning of sTreeResultPath
						If InStr(sTreeResultPath,IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB))=1 Then
							aRTemplateName_Local(icount) = Replace(sTreeResultPathList(i), IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB)+"\", "", 1, 1)
						Else
							aRTemplateName_Local(icount) = sTreeResultPathList(i)
						End If
						aRTemplateType_Local(icount) = "2d3dresult"
					End If
				'Else
					' Do nothing, ignore type "unknown"
				'End If
		    Next
		    If bIsDSForEnvironment Then Set oTreeObjectToCall = DSResultTree ' switch back to original result tree object
		End If
		If (InStr(sIncludedTypes, "-FF")=0) Then
			If bIsDSForEnvironment Then Set oTreeObjectToCall = Resulttree ' FF results should be grabbed from 3D tree, even in 'DS for' environment
			nResults = oTreeObjectToCall.GetTreeResults("Farfields", "farfield", "", sTreeResultPathList, sTreeResultTypeList, sTreeResultFileNameList, sTreeResultInfoList)

			For i = 0 To nResults - 1
		    	'If IsIncluded_LIB(sTreeResultInfoList(i), sIncludedTypes) Then ' deactivated, currently no further subdivision of types
		    		If IsIncluded_LIB(sTreeResultPathList(i), sIncludedNames) Then
						icount  = icount + 1
						ReDim Preserve aRTemplateName_Local(icount)
						ReDim Preserve aRTemplateType_Local(icount)
						' Only replace if ResultFolder is at beginning of sTreeResultPath
						If InStr(sTreeResultPath,IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB))=1 Then
							aRTemplateName_Local(icount) = Replace(sTreeResultPathList(i), IIf(bIsDSEnvironment, DSResultFolder_LIB, MWSResultFolder_LIB)+"\", "", 1, 1)
						Else
							aRTemplateName_Local(icount) = sTreeResultPathList(i)
						End If
						aRTemplateType_Local(icount) = "farfield"
					End If
				'Else
					' Do nothing, ignore type "unknown"
				'End If
		    Next
		    If bIsDSForEnvironment Then Set oTreeObjectToCall = DSResultTree ' switch back to original result tree object
		End If
	    'ReportInformationToWindow(sTreeResultPath)
	   	ResetTreeResultIterator_LIB()
	   	If (icount = istart + 1) Then
			icount = istart ' Dial back by one to remove first/header entry if it is the only entry
			ReDim Preserve aRTemplateName_Local(icount)
			ReDim Preserve aRTemplateType_Local(icount)
	   	End If
	End If
	' ReportInformationToWindow("Tree entries after: " + CStr(Timer()-dStartTime) +"secs")
	' dStartTime = Timer()

	istart = icount
	If IsIncluded_LIB("ANTICIPATED", sIncludedClasses) Then
		If (icount >= 65534) Then
			ReportInformation("Omitting anticipated results since the total number of results already exceeds 65534.")
		Else
		   	' Add list of possible results at bottom
			sListOfExpectedResults = GetListOfAnticipatedResults_LIB
			If sListOfExpectedResults(0,0) = "" Then
				' Do nothing
			Else
				icount  = icount + 1
				ReDim Preserve aRTemplateName_Local(UBound(aRTemplateName_Local) + UBound(sListOfExpectedResults, 2) + 2)
				ReDim Preserve aRTemplateType_Local(UBound(aRTemplateName_Local))
				aRTemplateName_Local(icount) = "---------- ANTICIPATED RESULTS ----------"
				aRTemplateType_Local(icount) = "VOID"
				For i = 0 To UBound(sListOfExpectedResults, 2)
					If IsIncluded_LIB(sListOfExpectedResults(1, i), sIncludedTypes) Then
			    		If IsIncluded_LIB(sListOfExpectedResults(0, i), sIncludedNames) Then
							icount  = icount + 1
							aRTemplateName_Local(icount) = sListOfExpectedResults(0, i)
							aRTemplateType_Local(icount) = sListOfExpectedResults(1, i)
							If (icount >= 65534) Then
								ReportInformation("Truncating number of anticipated results since the total number of results reached its maximum possible value.")
								Exit For
							End If
						End If
					End If
				Next
			End If
		   	If (icount = istart + 1) Then
				icount = istart ' Dial back by one to remove first/header entry if it is the only entry
		   	End If
		   	' Trim any unused slots from the arrays; needs to be done in every case here since array length is not built one by one as in cases above, but as determined by UBound(sListOfExpectedResults)
			ReDim Preserve aRTemplateName_Local(icount)
			ReDim Preserve aRTemplateType_Local(icount)
		End If
	End If
	' ReportInformationToWindow("Anticipated after: " + CStr(Timer()-dStartTime) +"secs")
	' dStartTime = Timer()

	' Return arrays
	sTemplateNameList = aRTemplateName_Local
	sTemplateTypeList = aRTemplateType_Local

End Sub

Function IsIncluded_LIB(sQuery As String, sFilter As String) As Boolean

	' Determines if 'sQuery' satisfies the rules provided by 'sFilter'
	' sFilter has the following general format:
	' 	ALL		: includes everything, but this can be reduced by explicitly excluding certain types; should be at beginning of sFilter
	'	#-Example: excludes 'Example'
	'	#+Example: explicitly includes 'Example'. Would overrule a -Example.
	'   #/Example: excludes everything that contains 'example', case independent
	'   #*Example: includes everything that contains 'example', case independent
	' For example: 'ALL-type1' would include everything except for type1, '+type1' would only include type1 and nothing else

	Dim nPosition As Long, sTestString As String, sTestChar As String
	Dim sListOfSeparators As String, sListOfSeparatorsWithTags As String
	Dim i As Long

	sListOfSeparators = "-+*/"
	sListOfSeparatorsWithTags = ""
	For i = 1 To Len(sListOfSeparators)
		sListOfSeparatorsWithTags = sListOfSeparatorsWithTags & "#" & Mid(sListOfSeparators, i, 1)
	Next
	' ReportInformationToWindow(sListOfSeparatorsWithTags)
	' Old templates are using separators without # tag. This can cause problems if separators are part of the query, e.g., 'S-Parameters'
	' Therefore, use # tag to signal separator. For bwc, re-tag all separators in sFilter if no tags are found and first char is a separator.
	If (InStr(sFilter, "#") < 1) Then
		For i = 1 To Len(sListOfSeparators)
			sFilter = Replace(sFilter, Mid(sListOfSeparators, i, 1), "#" & Mid(sListOfSeparators, i, 1))
		Next
	End If

	' ReportInformationToWindow(sFilter)
	If ((Left(sFilter, 3) <> "ALL") And (InStr(sListOfSeparatorsWithTags, Left(sFilter, 2)) = 0)) Then
		ReportWarning("template_results.lib:IsIncluded_LIB: Could not read filter format. Filter should start with ALL, #-, #+, #/, or #*")
		IsIncluded_LIB = False
		Exit Function
	End If

	If (sFilter = "ALL") Then
	    IsIncluded_LIB = True
	    Exit Function
	ElseIf (Left(sFilter, 3) = "ALL") Then
		' Assume included for now
		IsIncluded_LIB = True
		' Go through all items that potentially could exclude sQuery
		sTestString = "#-" & sQuery
		nPosition = InStr(sFilter, sTestString)
		While (nPosition > 0)
			' If char after #-sQuery is #-,#+,#*,or end of string, sQuery is excluded.
			nPosition = nPosition + Len(sTestString)
			If (nPosition > Len(sFilter)) Then
				IsIncluded_LIB = False
				' ReportInformationToWindow(sQuery & " is excluded in " & sFilter)
				Exit Function
			ElseIf (InStr(sListOfSeparatorsWithTags, Mid(sFilter, nPosition, 2)) > 0) Then
				IsIncluded_LIB = False
				' ReportInformationToWindow(sQuery & " is excluded in " & sFilter)
				Exit Function
			Else
				' search for next match, starting at new nPosition
				nPosition = InStr(nPosition, sFilter, sTestString)
			End If
		Wend
		' / can be used as a filter, less strict than -.
		sTestString = ""
		nPosition = InStr(sFilter, "#/") + 2
		While (nPosition > 2)
			While ((nPosition <= Len(sFilter)) And (InStr(sListOfSeparatorsWithTags, Mid(sFilter, nPosition, 2)) = 0))
				sTestString = sTestString & Mid(sFilter, nPosition, 1)
				nPosition = nPosition + 1
			Wend
			' ReportInformationToWindow(sQuery & " - " & sTestString)
			If (InStr(LCase(sQuery), LCase(sTestString)) > 0) Then
				IsIncluded_LIB = False
				' ReportInformationToWindow(sQuery & " is excluded by filter in " & sFilter)
				Exit Function
			Else
				' search for next /, starting at new nPosition
				nPosition = InStr(nPosition, sFilter, "#/") + 2
			End If
			' Reset test string
			sTestString = ""
		Wend
	Else
		' Look for positives
		' Assume nothing included for now
		IsIncluded_LIB = False
		' Go through all items that potentially could exclude sQuery
		sTestString = "#+" & sQuery
		nPosition = InStr(sFilter, sTestString)
		While (nPosition > 0)
			' If char after +sQuery is -,+,*,or end of string, sQuery is included.
			nPosition = nPosition + Len(sTestString)
			If (nPosition > Len(sFilter)) Then
				IsIncluded_LIB = True
				' ReportInformationToWindow(sQuery & " is included in " & sFilter)
				Exit Function
			ElseIf (InStr(sListOfSeparatorsWithTags, Mid(sFilter, nPosition, 2)) > 0) Then
				IsIncluded_LIB = True
				' ReportInformationToWindow(sQuery & " is included in " & sFilter)
				Exit Function
			Else
				' search for next match, starting at new nPosition
				nPosition = InStr(nPosition, sFilter, sTestString)
			End If
		Wend
		' * can be used as a filter, less strict than +.
		sTestString = ""
		nPosition = InStr(sFilter, "#*") + 2
		While (nPosition > 2)
			While ((nPosition <= Len(sFilter)) And (InStr(sListOfSeparatorsWithTags, Mid(sFilter, nPosition, 2)) = 0))
				sTestString = sTestString & Mid(sFilter, nPosition, 1)
				nPosition = nPosition + 1
			Wend
			' ReportInformationToWindow(sQuery & " - " & sTestString)
			If (InStr(LCase(sQuery), LCase(sTestString)) > 0) Then
				IsIncluded_LIB = True
				' ReportInformationToWindow(sQuery & " is included by filter in " & sFilter)
				Exit Function
			Else
				' search for next *, starting at new nPosition
				nPosition = InStr(nPosition, sFilter, "#*") + 2
			End If
			' Reset test string
			sTestString = ""
		Wend
	End If

End Function

Function GetListOfAnticipatedResults_LIB() As Variant

	' Returns a list of expected solver results; currently, time signals and S-Parameters only
	Dim nPorts As Long, nMaxModes As Long, i As Long, j As Long, m As Long, n As Long
	Dim sPortNumberArray() As String, nModes() As Long
	' Dim nNumberOfFieldResults As Long, s2D3DFields() As String
	Dim sListOfExpectedResults() As String

	' Start with an empty list
	ReDim sListOfExpectedResults(1,0)
	sListOfExpectedResults(0,0) = ""
	GetListOfAnticipatedResults_LIB = sListOfExpectedResults
	If (Left(GetApplicationName, 2) = "DS") Then ' return an empty list
		Exit Function
	End If

	' Determine the total number of ports first and reset the enumberation to the beginning of the
	' ports list.

	' Use CallByName to avoid problems with DS (no Port object)
	nPorts = CallByName(Port, "StartPortNumberIteration", vbMethod)
	If (nPorts > 100) Then
		If (RestoreGlobalDataValue("MaxAnticipatedPortsLIB") = "") Then
			ReportInformation("template_results::GetListOfAnticipatedResults:: Limiting number of anticipated results to the first 100 ports. If more anticipated results are needed, please store a global data value with name 'MaxAnticipatedPortsLIB' and the corresponding value. Please note that this may slow down opening certain templates.")
			nPorts = 100
		Else
			nPorts = Evaluate(RestoreGlobalDataValue("MaxAnticipatedPortsLIB"))
			ReportInformation("template_results::GetListOfAnticipatedResults:: Limiting number of anticipated results to the first " & CStr(nPorts) & " ports as specified by the global data value 'MaxAnticipatedPortsLIB'. Please note that this may slow down opening certain templates.")
		End If
	End If

	If nPorts > 0 Then
		' Make the port number array large enough to hold all port numbers
		ReDim sPortNumberArray(nPorts-1)

		' Now loop over all ports and add the ports to the array
		If (CallByName(Solver, "ArePortsSubsequentlyNamed", vbMethod)) Then
			For i = 0 To UBound(sPortNumberArray)
				sPortNumberArray(i) = CStr(i + 1)
			Next i
		Else
			For i = 0 To UBound(sPortNumberArray)
				sPortNumberArray(i) = CStr(CallByName(Port, "GetNextPortNumber", vbMethod))
			Next i
		End If

		' now handle Floquet ports
		If (CallByName(FloquetPort, "IsPortAtZmin", vbMethod)) Then
			ReDim Preserve sPortNumberArray(UBound(sPortNumberArray)+1)
			sPortNumberArray(UBound(sPortNumberArray)) = "Zmin"
		End If

		If (CallByName(FloquetPort, "IsPortAtZmax", vbMethod)) Then
			ReDim Preserve sPortNumberArray(UBound(sPortNumberArray)+1)
			sPortNumberArray(UBound(sPortNumberArray)) = "Zmax"
		End If

		ReDim nModes(UBound(sPortNumberArray))
		nMaxModes = 1

		For i = 0 To UBound(sPortNumberArray)
			Select Case sPortNumberArray(i)
				Case "Zmin", "Zmax"
					' start with Floquet Port handling
					CallByName(FloquetPort,"Port", vbMethod, sPortNumberArray(i))
					nModes(i) = CallByName(FloquetPort,"GetNumberOfModesConsidered", vbMethod)
				Case Else
					If (CallByName(Port,"GetType", vbMethod, sPortNumberArray(i)) <> "Waveguide") Then
						nModes(i) = 1
					Else
						' Determine the number of modes for the currently selected port and fill the mode array
						nModes(i) = CallByName(Port, "GetNumberOfModes", vbMethod, sPortNumberArray(i))
						If nModes(i) > nMaxModes Then nMaxModes = nModes(i)
					End If
			End Select
		Next

		' store name and type in this list
		ReDim sListOfExpectedResults(1,0)

		' Time signals Format for single modes only: Sm,n. If multiple modes: Sm(a),n(b)
		If nMaxModes = 1 Then
			' Time signals
			For i = 0 To UBound(sPortNumberArray)
				AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Port signals\i"+sPortNumberArray(i), "real")
				For j = 0 To UBound(sPortNumberArray)
					AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Port signals\o"+sPortNumberArray(i)+","+sPortNumberArray(j), "real")
				Next
			Next
			' S-Paras
			If (GetApplicationName() = "MWS") Then
				For i = 0 To UBound(sPortNumberArray)
					For j = 0 To UBound(sPortNumberArray)
						AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "S-Parameters\S"+sPortNumberArray(i)+","+sPortNumberArray(j), "complex")
					Next
				Next
			End If
			' Reference impedances
			For i = 0 To UBound(sPortNumberArray)
				AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Reference Impedance\ZRef "+sPortNumberArray(i)+"(1)", "complex")
			Next
		Else
			' Time signals
			For i = 0 To UBound(sPortNumberArray)
				For m = 1 To nModes(i)
					AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Port signals\i"+sPortNumberArray(i)+"("+CStr(m)+")", "real")
				Next
				For j = 0 To UBound(sPortNumberArray)
					For m = 1 To nModes(i)
						For n = 1 To nModes(j)
							AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Port signals\o"+sPortNumberArray(i)+"("+CStr(m)+")"+","+sPortNumberArray(j)+"("+CStr(n)+")", "real")
						Next
					Next
				Next
			Next
			' S-Paras
			If (GetApplicationName() = "MWS") Then
				For i = 0 To UBound(sPortNumberArray)
					For j = 0 To UBound(sPortNumberArray)
						For m = 1 To nModes(i)
							For n = 1 To nModes(j)
								AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "S-Parameters\S"+sPortNumberArray(i)+"("+CStr(m)+")"+","+sPortNumberArray(j)+"("+CStr(n)+")", "complex")
							Next
						Next
					Next
				Next
			End If
			' Reference impedances
			For i = 0 To UBound(sPortNumberArray)
				For m = 1 To nModes(i)
					AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Reference Impedance\ZRef "+sPortNumberArray(i)+"("+CStr(m)+")", "complex")
				Next
			Next
		End If
	ElseIf (GetApplicationName() = "MWS") Then ' no ports, could be Eigenmode result
		ReDim sListOfExpectedResults(1, 2)
		For i = 0 To UBound(sListOfExpectedResults, 2)
			sListOfExpectedResults(0,i) = "Mode Frequencies\Mode "+CStr(i+1)
			sListOfExpectedResults(1,i) = "real0D" ' type
		Next
	End If

	' PS specific results
	If (GetApplicationName() = "PS") Then
        Select Case GetSolverType

            Case "PT Tracking"
                ' gun iteration convergence
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Convergence\Gun Iteration Charge Accuracy", "real")
                ' particle source information
                Const sSourceQuantities = Array("Charge", "Current", "Perveance")
                Dim iSourceQuantity As Long
                For iSourceQuantity = LBound(sSourceQuantities) To UBound(sSourceQuantities)
                    For i = 0 To CallByName(ParticleSource, "GetNumberOfParticleSources", vbMethod)-1
                        AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Particle Sources\" + sSourceQuantities(iSourceQuantity) + " vs. Iteration\" + CallByName(ParticleSource, "GetNameofParticleSource", vbMethod, CStr(i)), "real")
                    Next
                Next
                ' collision / emission info
                Const sDirections = Array("Collision", "Emission")
                Const sCollEmQuantities = Array("Power", "Energy", "Charge", "Current", "Particles")
                Dim iDirection As Long, iCollEmQuantity As Long
                For iDirection = LBound(sDirections) To UBound(sDirections)
                    For iCollEmQuantity = LBound(sCollEmQuantities) To UBound(sCollEmQuantities)

                        AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Total " + sDirections(iDirection) + " Information\" + sCollEmQuantities(iCollEmQuantity) + "\[Background]: Boundary", "real0D")
                        For i = 0 To CallByName(Solid, "GetNumberOfShapes", vbMethod)-1
                            AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Total " + sDirections(iDirection) + " Information\" + sCollEmQuantities(iCollEmQuantity) + "\" + Replace(CallByName(Solid, "GetNameOfShapeFromIndex", vbMethod, CStr(i)), ":", ": "), "real0D")
                        Next
                    Next
                Next

            Case "PT PIC"
                ' Solver Statistics
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Solver Statistics [PIC]\Particle vs. Time", "real")
                ' Power
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Power\Wave-Particle Power Transfer", "real")
                ' Emission Information
                For i = 0 To CallByName(ParticleSource, "GetNumberOfParticleSources", vbMethod)-1
                    AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Emission Information\Power\[Sources]\"+Replace(CallByName(ParticleSource, "GetNameofParticleSource", vbMethod, CStr(i)), ":", "\"), "real")
                    AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Emission Information\Current\[Sources]\"+Replace(CallByName(ParticleSource, "GetNameofParticleSource", vbMethod, CStr(i)), ":", "\"), "real")
                Next
                For i = 0 To CallByName(Solid, "GetNumberOfShapes", vbMethod)-1
                    AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Emission Information\Power\[SEE]\"+Replace(CallByName(Solid, "GetNameOfShapeFromIndex", vbMethod, CStr(i)), ":", "\"), "real")
                    AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Emission Information\Current\[SEE]\"+Replace(CallByName(Solid, "GetNameOfShapeFromIndex", vbMethod, CStr(i)), ":", "\"), "real")
                Next
                ' Collision Information
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Collision Information\Power\[Background]\Background", "real")
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Collision Information\Current\[Background]\Background", "real")
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Collision Information\Power\[Background]\Boundary", "real")
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Collision Information\Current\[Background]\Boundary", "real")
                For i = 0 To CallByName(Solid, "GetNumberOfShapes", vbMethod)-1
                    AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Collision Information\Power\"+Replace(CallByName(Solid, "GetNameOfShapeFromIndex", vbMethod, CStr(i)), ":", "\"), "real")
                    AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Collision Information\Current\"+Replace(CallByName(Solid, "GetNameOfShapeFromIndex", vbMethod, CStr(i)), ":", "\"), "real")
                Next

            Case "PT Wakefields"
                ' field energy vs. time
                AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, "Energy\Energy [pb]", "real")
                ' No access to number of beams and beam names via VBA --> no further entries here
        End Select
	End If

	' Add fields to the list - can't do this here, GetAll2D3DResults is in vba_globals_3d.lib, which is not included in all templates. This would break some templates, such as 'Mix Template Results'
	'GetAll2D3DResults(s2D3DFields, nNumberOfFieldResults)
	'For i = 0 To nNumberOfFieldResults - 1
	'	AddEntryToListOfAnticipatedResults_LIB(sListOfExpectedResults, s2D3DFields(i), "2d3dresult")
	'Next

	' Return the full list
	GetListOfAnticipatedResults_LIB = sListOfExpectedResults

End Function

Sub AddEntryToListOfAnticipatedResults_LIB(ByRef sListOfExpectedResults() As String, sResultName As String, sResultType As String)
    sListOfExpectedResults(0,UBound(sListOfExpectedResults,2)) = sResultName
    sListOfExpectedResults(1,UBound(sListOfExpectedResults,2)) = sResultType
    ReDim Preserve sListOfExpectedResults(1, UBound(sListOfExpectedResults,2)+1)
End Sub

