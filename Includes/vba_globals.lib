'--------------------------------------------------------------------------------------------
Function GetSpiceDouble(value As String) As Double

	' Spice has a special convention for exponential number (without E)
	' e.g.  1.2345+007   instead of 1.2345E+007
	' GetSpiceDouble = 12345000, 
	' GetDouble (=Evaluate) would not work : 8.2345

	'	MsgBox CStr(GetSpiceDouble("1.2345+007"))

	Dim index As Long
	index = InStrRev(value, "+")
	If (index = 0) Then index = InStrRev(value, "-")
	If (index > 1) Then
		If (Mid(value, index-1, 1) <> "E" And Mid(value, index-1, 1) <> "e") Then
			value = Left(value, index-1) + "E" + Mid(value, index)
		End If
	End If

	Dim cst_separator    As String								'<<<<<<<<<<
	cst_separator    = Mid$(CStr(0.5), 2, 1)					'<<<<<<<<<<<

	' 06-aug-2004 ube/cwe: GetSpiceDouble: changed CVar to CDbl (now CVar had problems, see also 13-Nov-2003)
	GetSpiceDouble   = CDbl(Replace(value, ".", cst_separator))	'<<<<<<<<<<<

	'GetSpiceDouble = CVar(Replace(value, ".", ","))

End Function
'--------------------------------------------------------------------------------------------
Function GetDouble(lib_Text As Variant) As Double

	GetDouble = RealVal(lib_Text)

End Function
'---------------------------------------------------------------------
Function RealVal(lib_Text As Variant) As Double

  Dim sText As String
  sText = CStr(lib_Text)
  
  If sText = "" Then
    RealVal = 0
  Else
    RealVal = Evaluate(CStr(lib_Text))
  End If

' known problem does not work in France	
'	If (CDbl("0.5") > 1) Then
'		' komma needed instead of point 
'		RealVal = CDbl(Replace(CStr(lib_Text), ".", ","))
'	Else
'                On Error Resume Next
'                        RealVal = CDbl(CStr(lib_Text))
'                On Error GoTo 0
'	End If

'does also not work in France	
'	If (Val("0.5") > Val("1")) Then

End Function
'---------------------------------------------------------------------
Function MWS_Version As Double

	MWS_Version = RealVal (Mid(Trim$(GetMWSVersion),3,3))
	
End Function
'---------------------------------------------------------------------
Function CSTSplit(lib_Text As String, lib_array() As String) As Integer

	Dim lib_index As Integer, lib_position As Integer
	
	lib_Text  = Trim$(Replace(lib_Text, Chr$(9), " "))
	lib_index = 0

	While lib_Text <> ""
		lib_position         = InStr(lib_Text + " ", " ")
		lib_array(lib_index) = Trim$(Left$(lib_Text, lib_position))
		lib_Text             = Trim$(Mid$(lib_Text, lib_position))
		lib_index            = lib_index + 1
	Wend

	CSTSplit = lib_index
				
End Function
'---------------------------------------------------------------------
Sub CST_MkDir (lib_dir As String)

	' creates directory, even if some directory levels are missing

	Const dir_max_level = 10
	
	Dim lib_subdir(dir_max_level) As String, lib_Ftmp As String, lib_dir2 As String
	Dim lib_iii As Integer, lib_jjj As Integer
	
	lib_dir2 = lib_dir
	
	If Right$(lib_dir2,1) = "\" Then
		' removes trailing "\"
		lib_dir2 = DirName (lib_dir2)
	End If
	        
	lib_Ftmp$ = ""
	On Error Resume Next
		lib_Ftmp$ = Dir$(lib_dir2,vbDirectory)
	On Error GoTo 0
	
	If lib_Ftmp$ <> "" Then
		' directory already exists
		Exit Sub
	End If
	
	lib_iii=0
	Do
		lib_subdir(lib_iii) = lib_dir2
		lib_dir2 = DirName (lib_dir2)
		lib_iii=lib_iii+1
	
		lib_Ftmp$ = ""
		On Error Resume Next
			lib_Ftmp$ = Dir$(lib_dir2,vbDirectory)
		On Error GoTo 0
	
	Loop Until lib_Ftmp$ <> "" Or lib_iii = dir_max_level+1 Or Right$(lib_dir2,1)=":" 
	
	If lib_iii <= dir_max_level Then
	
		For lib_jjj = lib_iii-1 To 0 STEP -1
			MkDir lib_subdir(lib_jjj)
			Wait 0.1
		Next lib_jjj
	
	End If
	
End Sub
'---------------------------------------------------------------------
Sub CST_RmDir (lib_dir As String)

	' removes an empty directory
	' If the directory is not empty, do not remove and proceed without a warning

	On Error Resume Next
		RmDir lib_dir
	On Error GoTo 0

End Sub
'---------------------------------------------------------------------
Function MoveMWSModel (lib_fullpath_from As String, lib_dir_to As String) As String

	Dim lib_dir_from As String
	Dim lib_basename_from As String, lib_basename_from_noIndex As String
	Dim lib_basename_to As String, lib_dir_name As String
	Dim lib_tmp_from As String
	Dim lib_backup_from As String
	Dim lib_tmp_to As String
	Dim lib_full_from As String
	Dim lib_full_to As String
	
	Dim lib_version As Integer, lib_ijk As Integer
	Dim lib_filename As String, lib_mod_file As String
	Dim lib_Ftmp As String, lib_Ftmp2 As String
	Dim lib_mylock_set As Boolean, lib_my_lock As String, lib_already_locked As Boolean

	lib_dir_from     	= DirName(lib_fullpath_from)
	lib_basename_from 	= BaseName(lib_fullpath_from)
	lib_basename_from_noIndex		= BaseName_noIndex(lib_fullpath_from)
	
	CST_MkDir lib_dir_to
	
	lib_version  = 1
	lib_filename = FindFirstFile(lib_dir_to, lib_basename_from_noIndex + "_###", False)
	While (lib_filename <> "")
			lib_version  = CInt(Right$(BaseName(lib_filename), 3)) + 1
			lib_filename = FindNextFile
	Wend

	lib_mylock_set = False

	While Not lib_mylock_set
			
			lib_basename_to	= lib_basename_from_noIndex + Format(lib_version, "\_000")
			lib_dir_name 	= lib_dir_to + "\" + lib_basename_to
			lib_my_lock 	= lib_dir_name + "_" + Environ$("COMPUTERNAME")+"_"+CStr(CLng(Date))+"_"+Replace(CStr(Time),":","")
	
			lib_already_locked = False
			lib_ijk = 0
			
			Do 
					lib_ijk = lib_ijk + 1
			
					If Not lib_already_locked Then
						lib_Ftmp = Dir$(lib_dir_name + "_*")
						If lib_Ftmp <> "" Then
							If LCase(lib_Ftmp) <> LCase(ShortName(lib_my_lock)) Then
								lib_already_locked = True
							Else
								lib_Ftmp2 = Dir$()
								If lib_Ftmp2 <> "" Then
									lib_already_locked = True
								End If
							End If
						End If
					End If
					
					If Not lib_already_locked Then
						Open lib_my_lock For Output As #2
						Close #2
						lib_mylock_set = True
					End If
		
					Wait 3*Rnd()

			Loop Until lib_ijk=3 Or lib_already_locked
			
			If lib_already_locked Then
				If lib_mylock_set Then
					Kill lib_my_lock
					lib_mylock_set = False
				End If
				lib_version = lib_version + 1
			End If
	Wend
	
	' now free unique directory-name is found, which is definitely notlocked by someone else
	
	CST_MkDir (lib_dir_name)

	lib_tmp_from	= LCase (lib_dir_from + "\" + lib_basename_from)
	lib_tmp_to		= LCase (lib_dir_name + "\" + lib_basename_from)
	
	lib_filename = FindFirstFile(lib_dir_from, lib_basename_from + ".???", False)
	While (lib_filename <> "")
			lib_full_from = LCase (FullPath(lib_filename,lib_dir_from))
			lib_full_to = Replace(lib_full_from, lib_tmp_from, lib_tmp_to, 1, 1)
			FileCopy lib_full_from, lib_full_to
			lib_filename = FindNextFile
	Wend

	lib_filename = FindFirstFile(lib_dir_from, lib_basename_from + "^*.???", False)
	While (lib_filename <> "")
			lib_full_from = LCase (FullPath(lib_filename,lib_dir_from))
			lib_full_to = Replace(lib_full_from, lib_tmp_from, lib_tmp_to, 1, 1)
			FileCopy lib_full_from, lib_full_to
			lib_filename = FindNextFile
	Wend

	lib_backup_from = "C:\TEMP\MWS_Backup"		

	CST_MkDir lib_backup_from

	FileCopy lib_dir_from + "\" + lib_basename_from + ".mod", _
			lib_backup_from + "\" + lib_basename_from + ".mod_" + _
			Environ$("COMPUTERNAME")+"_"+CStr(CLng(Date))+"_"+Replace(CStr(Time),":","")

	On Error GoTo DO_NOT_COPY_PAR

		FileCopy lib_dir_from + "\" + lib_basename_from + ".par", _
			lib_backup_from + "\" + lib_basename_from + ".par_"  + _
			Environ$("COMPUTERNAME")+"_"+CStr(CLng(Date))+"_"+Replace(CStr(Time),":","")
				
		On Error GoTo 0 ' Disable the error handler 
		
	DO_NOT_COPY_PAR:	

	Wait 3'00		' afterwards files should be copied, then kill then original
	
	lib_filename = FindFirstFile(lib_dir_from, lib_basename_from + ".???", False)
	While (lib_filename <> "")
			lib_full_from = LCase (FullPath(lib_filename,lib_dir_from))
			Kill lib_full_from
			lib_filename = FindNextFile
	Wend

	lib_filename = FindFirstFile(lib_dir_from, lib_basename_from + "^*.???", False)
	While (lib_filename <> "")
			lib_full_from = LCase (FullPath(lib_filename,lib_dir_from))
			Kill lib_full_from
			lib_filename = FindNextFile
	Wend

	Wait 3'00		' wait another time before proceed and exit function

	Kill lib_my_lock
	
	CST_RmDir (lib_dir_from)

	MoveMWSModel = lib_dir_name + "\" + lib_basename_from + ".mod"
	
End Function
'-------------------------------------------------------------------------------------
Sub Prepare_Step_File

	SelectTreeItem "Components"
	With STEP
		.Reset
		.ExportAttributes (True)
		.FileName GetProjectPath("ModelCache") + "example.stp"
		On Error GoTo no_step_license
		.WriteAll
	End With

	Dim sfile As String
	sfile = GetProjectPath("ModelCache") + "example.stp"

	Dim cst_line As String
	cst_line = GrepFirstPattern(sfile, sfile)
	If (cst_line <> "") Then
		StoreGlobalDataValue ("Step\Chk1", "11")
	End If

	Dim stree As String
	stree = ResultTree.GetFirstChildName("Components")
	RemoveFirstChars(stree,11)

	cst_line = GrepFirstPattern(sfile, stree)
	If (cst_line <> "") Then
		StoreGlobalDataValue ("Step\Chk2", "23")
	End If

	Exit Sub

  no_step_license:
    MsgBox "Step License not available.",vbCritical
End Sub
'-------------------------------------------------------------------------------------
Sub LoadSignalFiles (lib_modfile As String, cst_runid As String)

Dim mysigname2 As String
Dim myfilepath$, myfilepattern$, myfilepath_short$, mysigname$, mysigname_short$
Dim mysigname_short_1$, mysigname_short_2$, mysigname_short_3$, mysigname_short_4$
Dim mysigname_short_12$, mysigname_short_13$
Dim myTreePath$, myXLabel$, imylength As Integer, bReady As Boolean, bSkipThisFile As Boolean, bOtherFile As Boolean
Dim normimp_filename As String, tmpstr As String	' For Smith chart
Dim normimp As Double
Dim ilen As Long, ileft As Long

myfilepath    = DirName(lib_modfile)
myfilepattern = ShortName(lib_modfile) + "^*.sig"

' Search for first sig file
mysigname = FindFirstFile(myfilepath , myfilepattern, False) 'See if a sig exist

While (mysigname <> "")

	myfilepath_short = ShortName(lib_modfile)

	imylength = Len(BaseName(mysigname))-Len(myfilepath_short)-1

	mysigname_short   = Right$( BaseName(mysigname), imylength   )

	If imylength > 1 Then mysigname_short_1 = Right$( BaseName(mysigname), imylength-1 )
	If imylength > 2 Then mysigname_short_2 = Right$( BaseName(mysigname), imylength-2 )
	If imylength > 3 Then mysigname_short_3 = Right$( BaseName(mysigname), imylength-3 )
	If imylength > 4 Then mysigname_short_4 = Right$( BaseName(mysigname), imylength-4 )

	mysigname2 = DirName(lib_modfile) + "\" + myfilepath_short + "^" +mysigname_short + ".sig"

	bSkipThisFile = False
	bOtherFile = False
	bReady = False

	If (imylength > 2) Then
		If ( Left(mysigname_short,2)="ac" Or Left(mysigname_short,2)="bc" ) Then

			' these are internal full-deembedding files, not to be compared (^ac1(1)1(1).sig) (^bc1(1)1(1).sig)

			bSkipThisFile = True
			bReady = True
		End If
	End If

	If (imylength > 4) Then
		If ( Left(mysigname_short,4)="alph" ) Then

			' full-deembedding alpha file, directly goto other...

			bOtherFile = True
			bReady = True
		End If
		If ( Left(mysigname_short,5)="adapt" ) Then

			' adaptive meshing info file, directly goto other...

			bOtherFile = True
			bReady = True
		End If
		If ( Left(mysigname_short,5)="parti" ) Then

			' particle studio current ...

			bOtherFile = True
			bReady = True
		End If
		If ( Left(mysigname_short,5)="all s" ) Then

			' particle monitor "all sources" ...

			bOtherFile = True
			bReady = True
		End If
		If ( InStr(mysigname_short,"_eps_")<>0 Or InStr(mysigname_short,"_mu_")<>0 Or InStr(mysigname_short,"_mue_")<>0 ) Then

			' material dispersion file ...

			bOtherFile = True
			bReady = True
		End If
	End If

	If Not bReady Then
		bReady = True
		Select Case Left(mysigname_short,12)
			Case "Farfield_lin"
				mysigname_short_13 = Right$( BaseName(mysigname), imylength-13 )

				' create farfield polar plot together with according angle-file *.ang

				myTreePath = "Farfield\polar-linear\" + Replace(mysigname_short_13,"_","\",,2)
				myXLabel   = "Angle / degree"
				With ResultTree
					.Reset
					.Type "PolarPlot"
					.Xlabel myXLabel
					.Title myTreePath
					.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
					.File mysigname2
					.File2 Replace(mysigname2,".sig",".ang")
					.Add
				End With
				' change treepath for cartesian plot
				myTreePath = "Farfield\cartesian-linear\" + Replace(mysigname_short_13,"_","\",,2)

			Case "Farfield_dB_"
				mysigname_short_12 = Right$( BaseName(mysigname), imylength-12 )

				' create polar plot first together with according phase
				myTreePath = "Farfield\polar-dB\" + Replace(mysigname_short_12,"_","\",,2)
				myXLabel   = "Angle / degree"
				With ResultTree
					.Reset
					.Type "PolarPlotDB"
					.Xlabel myXLabel
					.Title myTreePath
					.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
					.File mysigname2
					.File2 Replace(mysigname2,".sig",".ang")
					.Add
				End With
				' change treepath for cartesian plot
				myTreePath = "Farfield\cartesian-dB\" + Replace(mysigname_short_12,"_","\",,2)

			Case Else
				bReady = False
		End Select
	End If

	If Not bReady Then
		bReady = True
		Select Case Left(mysigname_short,4)
			Case "ar^a"
				' create polar plot first together with according phase
				myTreePath = "S-Parameter\|S| polar (AR)\S" + mysigname_short_4
				myXLabel   = "Frequency"
				With ResultTree
					.Reset
					.Type "PolarSignal"
					.Xlabel myXLabel
					.Title myTreePath
					.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
					.File mysigname2
					.File2 Replace(mysigname2,"^ar^a","^ar^p")
					.Add
				End With
				' then create the Smith chart
				ilen = Len(mysigname_short_4)
				ileft = CLng(ilen/2)
				If Left(mysigname_short_4,ileft)=Right(mysigname_short_4,ilen-ileft) Then

					normimp_filename = myfilepath + "\"+myfilepath_short+".sds"
					normimp = GetNormImpedance(normimp_filename, Left(mysigname_short_4,ilen/2))

					If normimp > 0 Then
						' Plot it
						myTreePath = "S-Parameter\Smith Chart (AR)\S" + mysigname_short_4
						myXLabel   = "Frequency"
						With ResultTree
							.Reset
							.Type "SmithSignal"
							.Xlabel myXLabel
							.Title myTreePath
							.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
							.File mysigname2
							.File2 Replace(mysigname2,"^ar^a","^ar^p")
							.ReferenceImpedance Replace(CStr(normimp),",",".")
							' komma problem .ReferenceImpedance CStr(normimp)
							.Add
						End With
					End If
				End If
				'
				' now prepare normal plot of amplitude
				myTreePath = "S-Parameter\|S| linear (AR)\S" + mysigname_short_4
				myXLabel   = "Frequency"

			Case "ar^d"
				myTreePath = "S-Parameter\|S| dB (AR)\S" + mysigname_short_4
				myXLabel   = "Frequency"
			Case "ar^p"
				myTreePath = "S-Parameter\arg(S) (AR)\S" + mysigname_short_4
				myXLabel   = "Frequency"
			Case Else
				bReady = False
		End Select
	End If

	If Not bReady Then
		bReady = True
		Select Case Left(mysigname_short,3)
			Case "plw"
				myTreePath = "Plane Wave\Time Signal"
				myXLabel   = "Time"

			Case "pua"
				myTreePath = "Discrete Ports\Voltages\|U| linear\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "pud"
				myTreePath = "Discrete Ports\Voltages\|U| dB\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "pup"
				myTreePath = "Discrete Ports\Voltages\arg(U)\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "pus"
				myTreePath = "Discrete Ports\Voltages\Signals\" + mysigname_short_3
				myXLabel   = "Time"

			Case "pia"
				myTreePath = "Discrete Ports\Currents\|I| linear\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "pid"
				myTreePath = "Discrete Ports\Currents\|I| dB\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "pip"
				myTreePath = "Discrete Ports\Currents\arg(I)\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "pis"
				myTreePath = "Discrete Ports\Currents\Signals\" + mysigname_short_3
				myXLabel   = "Time"

			Case Else
				bReady = False
		End Select
	End If

	If Not bReady Then
		bReady = True
		Select Case Left(mysigname_short,3)
			Case "zre"
				myTreePath = "Z-Parameter\Re(Z)\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "zim"
				myTreePath = "Z-Parameter\Im(Z)\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "zam"
				myTreePath = "Z-Parameter\|Z|\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "zph"
				myTreePath = "Z-Parameter\arg(Z)\" + mysigname_short_3
				myXLabel   = "Frequency"

			Case "yre"
				myTreePath = "Y-Parameter\Re(Y)\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "yim"
				myTreePath = "Y-Parameter\Im(Y)\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "yam"
				myTreePath = "Y-Parameter\|Y|\" + mysigname_short_3
				myXLabel   = "Frequency"
			Case "yph"
				myTreePath = "Y-Parameter\arg(Y)\" + mysigname_short_3
				myXLabel   = "Frequency"

			Case Else
				bReady = False
		End Select
	End If

	If Not bReady Then
		bReady = True
		Select Case Left(mysigname_short,2)
			Case "zr"
				myTreePath = "Lumped Elements\Impedances\Re(Z)\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "zi"
				myTreePath = "Lumped Elements\Impedances\Im(Z)\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "za"
				myTreePath = "Lumped Elements\Impedances\|Z|\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "zp"
				myTreePath = "Lumped Elements\Impedances\arg(Z)\" + mysigname_short_2
				myXLabel   = "Frequency"

			Case "ua"
				myTreePath = "Lumped Elements\Voltages\|U| linear\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "ud"
				myTreePath = "Lumped Elements\Voltages\|U| dB\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "up"
				myTreePath = "Lumped Elements\Voltages\arg(U)\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "us"
				myTreePath = "Lumped Elements\Voltages\Signals\" + mysigname_short_2
				myXLabel   = "Time"

			Case "ia"
				myTreePath = "Lumped Elements\Currents\|I| linear\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "id"
				myTreePath = "Lumped Elements\Currents\|I| dB\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "ip"
				myTreePath = "Lumped Elements\Currents\arg(I)\" + mysigname_short_2
				myXLabel   = "Frequency"
			Case "is"
				myTreePath = "Lumped Elements\Currents\Signals\" + mysigname_short_2
				myXLabel   = "Time"

			Case Else
				bReady = False
		End Select
	End If

	If Not bReady Then
		bReady = True
		Select Case Left(mysigname_short,1)
			Case "a"

				' create polar plot first
				myTreePath = "S-Parameter\|S| polar\S" + mysigname_short_1
				myXLabel   = "Frequency"
				With ResultTree
					.Reset
					.Type "PolarSignal"
					.Title myTreePath
					.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
					.File mysigname2
					.File2 Replace(mysigname2,"^a","^p")
					.Add
				End With

				' then create the Smith chart
				ilen = Len(mysigname_short_1)
				ileft = CLng(ilen/2)
				If Left(mysigname_short_1,ileft)=Right(mysigname_short_1,ilen-ileft) Then

					normimp_filename = myfilepath + "\"+myfilepath_short+".sds"
					normimp = GetNormImpedance(normimp_filename, Left(mysigname_short_1,ilen/2))

					If normimp > 0 Then
						' Plot it
						myTreePath = "S-Parameter\Smith Chart\S" + mysigname_short_1
						myXLabel   = "Frequency"
						With ResultTree
							.Reset
							.Type "SmithSignal"
							.Xlabel myXLabel
							.Title myTreePath
							.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
							.File mysigname2
							.File2 Replace(mysigname2,"^a","^p")
							.ReferenceImpedance Replace(CStr(normimp),",",".")
							' komma problem .ReferenceImpedance CStr(normimp)
							.Add
						End With
					End If
				End If
				' now prepare normal plot of amplitude
				myTreePath = "S-Parameter\|S| linear\S" + mysigname_short_1
				myXLabel   = "Frequency"

			Case "d"
				myTreePath = "S-Parameter\|S| dB\S" + mysigname_short_1
				myXLabel   = "Frequency"
			Case "p"
				myTreePath = "S-Parameter\arg(S)\S" + mysigname_short_1
				myXLabel   = "Frequency"

			Case "o"
				myTreePath = "Port Signals\outcoming\o" + mysigname_short_1
				myXLabel   = "Time"
			Case "i"
				myTreePath = "Port Signals\ingoing\i" + mysigname_short_1
				myXLabel   = "Time"

			Case Else
				bReady = False
		End Select
	End If

	If bOtherFile Or Not bReady Then
		myTreePath = "other\" + mysigname_short
		myXLabel   = ""
	End If

	If (Not bSkipThisFile) Then
		'Add all sig files to
		With ResultTree
			.Reset
			.Type "XYSignal"
			.Xlabel myXLabel
			.Title myTreePath
			.Name "1D Results\Comparison\" + myTreePath + "\" + cst_runid
			.File mysigname2
			.Add
		End With
	End If

	mysigname = FindNextFile
Wend

End Sub

'-------------------------------------------------------------------------------------
Sub LoadBalances (lib_modfile As String, cst_runid As String)

Dim MyResult$(4), MyFolder$(4), myXLabel$(4)

	MyResult$(1)=".bil"
	MyFolder$(1)="Balance"
	myXLabel$(1)="Frequency"

Dim mysigname2 As String
Dim myres$, myfol$, myfilepath$, myfilepattern$, myfilepath_short$, myext$, myext2$, mysigname$, mysigname_short$
Dim iii As Integer
		
myfilepath    = DirName(lib_modfile)
myfilepattern = ShortName(lib_modfile) + "^*" + MyResult$(1)

' Search for first sig file
mysigname = FindFirstFile(myfilepath , myfilepattern, False) 'See if a sig exist 

While (mysigname <> "")
	For iii = 1 To 1
		myfilepath_short = ShortName(lib_modfile)
		mysigname_short = Right$((BaseName(mysigname)), (Len(BaseName(mysigname))-Len(myfilepath_short)-1))
		mysigname2 = DirName(lib_modfile) + "\" + myfilepath_short + "^" +mysigname_short +MyResult$(iii)
		
		'Add all sig files to  
		With ResultTree
				.Reset
				.Type "XYSignal"
				.Xlabel myXLabel$(iii)
				.Title "Balance " + mysigname_short
				.Name "1D Results\Comparison\Balance\" + "Balance " + mysigname_short +"\" + cst_runid
				.File mysigname2
				.Add
		End With
	Next iii

	mysigname = FindNextFile
Wend

End Sub

