    Case 1 ' Dialog box initialization
 '   	DlgSetPicture "Picture1",MacroDir + "\CTLE_Passive.bmp",0
 '   	DlgSetPicture "Picture1",MacroDir + "\CTLE_Active.bmp",0


    	DlgVisible "eqtypes", False	' Initial simple implementation, not used anymore
    	DlgVisible "Eq_Method", False	' Initial simple implementation, not used anymore

		'DlgEnable "CTLE", True
    	' While CTLE options not implemented
		DlgVisible "CTLE_Options", False
		DlgVisible "CTLE_Passive", False
		DlgVisible "CTLE_Active", False
		DlgValue ("CTLE_Options", 0)

		DlgVisible "CTLE_Auto", False
		DlgEnable "CTLE_Auto", False


		'DlgVisible "R1", False
		'DlgVisible "R2", False
		'DlgVisible "R3", False
		'DlgVisible "C1", False
		'DlgVisible "C2", False

		'DlgVisible "Text5", False
		'DlgVisible "Text6", False
		'DlgVisible "Text7", False
		'DlgVisible "Text8", False
		'DlgVisible "Text9", False

		' When CTLE will be implemented
		If DlgValue("CTLE") = 0 Then
			'DlgEnable "CTLE_Options", False

			'DlgEnable "R1", False: DlgEnable "R2", False: DlgEnable "R3", False: DlgEnable "C1", False:	DlgEnable "C2", False
		End If

		DlgEnable "npre", True
		DlgEnable "npost_LFE", True
		DlgEnable "npost_DFE", True
		DlgEnable "LFE", True
		DlgEnable "DFE", True

		DlgVisible "Picture1", False

    Case 2 ' Value changing or button pressed
    	If DlgItem$ = "CTLE" Or DlgItem$ = "CTLE_Options" Then
    		If DlgValue("CTLE") = 1 Then
  				'DlgVisible "Picture1", True
				'DlgEnable "CTLE_Options", True
	  			'DlgEnable "R1", True: DlgEnable "R2", True: DlgEnable "R3", True: DlgEnable "C1", True:	DlgEnable "C2", True
				If DlgValue("CTLE_Options") = 0 Then
    '				DlgSetPicture "Picture1",MacroDir + "\CTLE_Passive.bmp",0
    			Else
    '				DlgSetPicture "Picture1",MacroDir + "\CTLE_Active.bmp",0
    			End If
    		Else
				'DlgVisible "Picture1", False
				'DlgEnable "CTLE_Options", False
				'DlgEnable "R1", False: DlgEnable "R2", False: DlgEnable "R3", False: DlgEnable "C1", False:	DlgEnable "C2", False
    		End If
    	End If
    Case 4 ' Focus changed
 '       Debug.Print "DlgFocus="""; DlgFocus(); """"
    Case 6 ' Function key
 '       If SuppValue? And &H100 Then Debug.Print "Shift-";
 '       Debug.Print "F" & (SuppValue And &HFF)
    End Select
End Function

Sub Read_Equalization_Settings()

	Dim methods_array(0 To 1) As String
	methods_array(0) = "ZFS"	'"Zero forcing solution (ZFS)"
	methods_array(1) = "MMSE"	'"Minimum mean square error (MMSE)"

	Begin Dialog UserDialog 850,287,"Equalization",.DialogFunction_Equalize ' %GRID:10,7,1,1
		Text 30,14,130,14,"Equalization method",.Eq_Method
		DropListBox 200,14,170,28,EQTypesArray(),.eqtypes
		OKButton 30,252,90,21
		CancelButton 130,252,90,21
		Text 30,49,390,14,"Equalization to be applied (will be applied in this order)",.Text10

		Text 30,77,160,14,"Transmitter equalization",.Text1
		' LFE
		Text 30,98,20,14,"1)",.Text13
		CheckBox 70,98,90,14,"Dig LFE",.LFE
		Text 220,98,50,14,"Npre",.Text2
		Text 380,98,50,14,"Npost",.Text3
		TextBox 260,98,90,21,.npre
		TextBox 420,98,90,21,.npost_LFE
		Text 530,98,60,14,"Method",.Text15
		DropListBox 590,98,180,28,methods_array(),.LFE_Method

		Text 40,133,160,14,"Receiver equalization",.Text4
		' CTLE
		Text 30,154,20,14,"2)",.Text12
		CheckBox 70,154,100,14,"CTLE (beta)",.CTLE
		OptionGroup .CTLE_Options
			OptionButton 750,154,70,14,"Passive",.CTLE_Passive
			OptionButton 750,168,70,14,"Active",.CTLE_Active
		'Text 320,154,30,14,"R1",.Text5
		'Text 320,175,30,14,"C1",.Text7
		'Text 470,175,30,14,"C2",.Text8
		'Text 470,154,30,14,"R2",.Text6
		'Text 630,154,30,14,"R3",.Text9
		'TextBox 350,154,90,21,.R1
		'TextBox 350,175,90,21,.C1
		'TextBox 500,175,90,21,.C2
		'TextBox 500,154,90,21,.R2
		'TextBox 660,154,90,21,.R3

		Text 240,154,50,14,"DC gain",.Text5_1
		Text 240,175,40,14,"f_zero",.Text7_1
		Text 440,154,50,14,"f_pole1",.Text6_1
		Text 440,175,50,14,"f_pole2",.Text8_1
		'Text 630,154,30,14,"R3",.Text9_1
		TextBox 280,154,90,21,.Adc
		TextBox 280,175,90,21,.fz
		TextBox 490,154,90,21,.fp1
		TextBox 490,175,90,21,.fp2
		Text 372,154,40,21,Units.GetUnit("Frequency")
		Text 372,175,40,21,Units.GetUnit("Frequency")
		Text 580,154,40,21,Units.GetUnit("Frequency")
		Text 580,175,40,21,Units.GetUnit("Frequency")
		CheckBox 670,161,60,14,"Auto",.CTLE_Auto

		' DFE
		Text 30,210,20,14,"3)",.Text14
		CheckBox 70,210,90,14,"DFE",.DFE
		Text 220,210,50,14,"Npost",.Text11
		TextBox 260,210,90,21,.npost_DFE


		Picture 420,203,300,49,"Picture1",0,.Picture1
'		MultiListBox 220,56,90,70,EQTypesArray(),.MultiListBox1
	End Dialog

	Dim dlg As UserDialog

	dlg.eqtypes = EQ_Type
	'dlg.R1 = CStr(sett_CTLE.R1)	'"1"
	'dlg.R2 = CStr(sett_CTLE.R2)	'"1"
	'dlg.R3 = CStr(sett_CTLE.R3)	'"1"
	'dlg.C1 = Format(sett_CTLE.C1, "0.0000E+00")	'"1e-12"
	'dlg.C2 = Format(sett_CTLE.C2, "0.0000E+00")	'"1e-12"
	dlg.npre = CStr(sett_LFE.npre)	'"1"
	dlg.npost_LFE = CStr(sett_LFE.npost)	'"2"
	dlg.npost_DFE = CStr(sett_DFE.npost)	'"2"

	dlg.Adc = CStr(sett_CTLE.Adc)
	dlg.fz  = Replace(Format$(sett_CTLE.fz,  "#.000e+00;-#.000e+00;0.000"), ",", ".")
	dlg.fp1 = Replace(Format$(sett_CTLE.fp1,  "#.000e+00;-#.000e+00;0.000"), ",", ".")
	dlg.fp2 = Replace(Format$(sett_CTLE.fp2,  "#.000e+00;-#.000e+00;0.000"), ",", ".")

	If sett_CTLE.isOn = False Then 	dlg.ctle = 0 Else dlg.CTLE = 1 'End If
	If sett_LFE.isOn = False Then 	dlg.LFE = 0  Else dlg.LFE = 1 'End If
	If sett_DFE.isOn = False Then 	dlg.DFE = 0  Else dlg.DFE = 1 'End If

	If sett_CTLE.CTLE_Type = "Passive" Then dlg.CTLE_Options = 0 Else dlg.CTLE_Options = 1 'End If

	If sett_LFE.method = "ZFS" Then dlg.LFE_Method = 0
	If sett_LFE.method = "MMSE" Then dlg.LFE_Method = 1


	If Dialog (dlg) = 0 Then Exit Sub

	EQ_Type = dlg.eqtypes
	sett_CTLE.isOn = dlg.CTLE
	sett_CTLE.isAuto = dlg.CTLE_Auto
	If dlg.CTLE_Options = 0 Then sett_CTLE.CTLE_Type = "Passive" Else sett_CTLE.CTLE_Type = "Active"
	sett_CTLE.Adc = RealVal(dlg.Adc)
	sett_CTLE.fz = RealVal(dlg.fz)
	sett_CTLE.fp1 = RealVal(dlg.fp1)
	sett_CTLE.fp2 = RealVal(dlg.fp2)

	sett_LFE.isOn = dlg.LFE
	sett_DFE.isOn = dlg.DFE
	'sett_CTLE.R1 = Val(dlg.R1)
	'sett_CTLE.R2 = Val(dlg.R2)
	'sett_CTLE.R3 = Val(dlg.R3)
	'sett_CTLE.C1 = Val(dlg.C1)
	'sett_CTLE.C2 = Val(dlg.C2)
	sett_LFE.npre = Val(dlg.npre)
	sett_LFE.npost = Val(dlg.npost_LFE)
	sett_DFE.npost = Val(dlg.npost_DFE)
	sett_LFE.method = methods_array(dlg.LFE_Method)
End Sub

' ======================
Function CTLE_dig_filter(i1 As Object, a() As Double, b() As Double) As Object
	' i1: input signal
	' a: filter coefficients for the denominator
	' b: filter coefficients for the numerator
	' a and b must have the same dimensions, going from 1 to n+1, where n is the order of the filter

	Dim n As Long	' Order of the filter + 1
	Dim z() As Double	' At the beginning of each sample, contains the previous values of z. Gets updated to the new values in the current iteration
						' (Old values are overwritten)
	Dim o1 As Object	' Output
	Dim x As Double, y As Double	' Current input and output


	Dim iii As Long, jjj As Long

	If UBound(a) <> UBound(b) Then
		ReportError "Inconsistent digital filter coefficients!"
		Exit All
	End If

	n = UBound(a)
	ReDim z(1 To n-1)

	Set o1 = i1.Copy


	For iii = 0 To i1.GetN-1
		x = i1.GetY(iii)

		y = b(1) * x +z(1)
		o1.SetY(iii, y)
		For jjj = 1 To n-2
			z(jjj) = b(jjj+1) * x + z(jjj+1) - a(jjj+1) * y	' 2nd order: z(1) = b(2) * x + z(2) - a(2) * y
		Next

		z(n-1) = b(n) * x - a(n) * y	' 2nd order: z(2) = b(3) * x - a(3) * y
	Next

	Set CTLE_dig_filter = o1.Copy

End Function


Sub CTLE_determine_dig_Coeffs(a() As Double, b() As Double, i1 As Object, dt As Double)
	' Calculate the coefficients of the digital filter from the transfer function information

	Dim iii As Long

	Dim fz As Double, fp1 As Double, fp2 As Double, Adc As Double
	Dim om_z As Double, om_p1 As Double, om_p2 As Double, K As Double

	fz = sett_CTLE.fz '3.183098862E-01
	fp1 = sett_CTLE.fp2	'7.840735518E-01
	fp2 = sett_CTLE.fp1	'9.821030105E+01
	Adc = sett_CTLE.Adc	'0.328947368


	Dim myfact As Double	' Frequency factor
	myfact = Units.GetFrequencyUnitToSI	'1e9
	om_z = fz * myfact*2*pi()
	om_p1 = fp1 * myfact*2*pi()
	om_p2 = fp2 * myfact*2*pi()

	K = Adc * om_p1 * om_p2 / om_z

	ReDim a(1 To 3)
	ReDim b(1 To 3)

	' Sampling rate
	Dim fs As Double
	fs = 1/dt

	' Cutoff
	Dim fc As Double
	fc = fp2

	' Prewarping, not used right now
If 1 = 0 Then
	Dim CW As Double
	CW = fs/pi() * Tan(pi()*fc/fs)

	dt = 6.4e-12	' Good for the model CTLE_DS_tests_Hz

	dt = 1/fc
	dt = 1/fc/10

	i1.ResampleTo(i1.GetX(0), i1.GetX(i1.GetN-1), Round(i1.GetX(i1.GetN-1)/dt))

	dt = dt*2*pi()
End If
CW = 1

	Dim Vn As Double
	Vn = 2/dt

	' Coefficients for H(z)
	' Denominator
	a(1) = Vn^2 + Vn*(om_p1 + om_p2) + om_p1 * om_p2
	a(2) = -2*Vn^2 + 2*om_p1 * om_p2
	a(3) = Vn^2 - Vn*(om_p1 + om_p2) + om_p1 * om_p2

	' Numerator
	b(1) = (Vn + om_z)*K
	b(2) = 2*om_z*K
	b(3) = (om_z-Vn)*K

	Dim a1 As Double

	b(1) = b(1) / CW^2
	b(2) = b(2) / CW
	a(1) = a(1) / CW^2
	a(2) = a(2) / CW

	a1 = a(1)
	For iii = 1 To 3
		a(iii) = a(iii) / a1
		b(iii) = b(iii) / a1
	Next

End Sub

