Sub plot_o2(o2 As Object, tmpstr As String, ParentTreeName As String)

	If not bAdditionalOutput Then Exit Sub

'	o2.save "^" + "Worst1.sig"  ' WORKS like in 2006
	o2.save "^" + "Worst1"+tmpstr +".sig"  ' WORKS like in 2006

	o2.title "Worst_1"+tmpstr
	o2.SetXLabelAndUnit "Time" , Units.GetUnit("Time")
	o2.AddToTree   ParentTreeName + "\TestWorst\Worst1"+tmpstr	'"1D Results\TestWorst\Worst1"+tmpstr
'	If mybMWS Then
'		o2.AddToTree   ParentTreeName + "\TestWorst\Worst1"+tmpstr	'"1D Results\TestWorst\Worst1"+tmpstr
'	Else
'		o2.AddToTree   "Results\TestWorst\Worst1"+tmpstr
'	End If

'If mybMWS Then		' Commented out on 19.05.2016
'	CSTResultTree.RefreshView
'	CSTResultTree.UpdateTree
'End If
End Sub

Sub plot_o3(o3 As Object, tmpstr As String, ParentTreeName As String)

	If not bAdditionalOutput Then Exit Sub
	
	o3.save "^" + "Worst0"+tmpstr +".sig"  ' WORKS like in 2006
	o3.title "Worst_0"+tmpstr
	o3.SetXLabelAndUnit "Time" , Units.GetUnit("Time")
	o3.AddToTree   ParentTreeName + "\TestWorst\Worst0"+tmpstr
'	If mybMWS Then
