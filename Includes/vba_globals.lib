Const lib_rundef = -1.2345678e27
Const lib_deg2rad = Pi/180.0
Const lib_rad2deg = 180.0/Pi

'================================================================================

Public oSelectedSP As Object
Function GetSimulationProjectByName_LIB(sSPName As String) As Object

	' Get simulation project by name
	If (Left(GetApplicationName, 2) = "DS") Then
		If (sSPName <> "") And (sSPName <> "3D Tab") Then
			If Not CallByName(SimulationProject, "DoesExist", vbMethod, sSPName) Then
				ReportWarning("The specified simulation project '" & sSPName & "' does not exist. Please check your settings.") ' cannot be error or it might prevent FF GUI from opening
			End If
		End If
		Set GetSimulationProjectByName_LIB = CallByName(DS, "GetSimulationProject", vbMethod, sSPName)
		If GetSimulationProjectByName_LIB Is Nothing Then
			Set GetSimulationProjectByName_LIB = GetOwnProject
		End If
	Else
		Set GetSimulationProjectByName_LIB = GetOwnProject
	End If

End Function

