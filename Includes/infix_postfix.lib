Function Atn21DC(Operand1 As Object, Operand2 As Object) As Object
	' Calculate atan2(z1, z2), result in rad
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	Dim dYReValues2() As Double, dYImValues2() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z2.re = dYReValues2(i)
		z2.im = dYImValues2(i)
		z = zatn2(z1, z2)
		dYReValues1(i) = z.re
		dYImValues1(i) = z.im
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Atn21DC = Operand1
End Function

Function Atn2D1DC(Operand1 As Object, Operand2 As Object) As Object
	' Calculate atan2(z1, z2), result in deg
	Dim i As Long
	Dim z As Complex, z1 As Complex, z2 As Complex
	Dim dYReValues1() As Double, dYImValues1() As Double
	Dim dYReValues2() As Double, dYImValues2() As Double
	dYReValues1 = Operand1.GetArray("yre")
	dYImValues1 = Operand1.GetArray("yim")
	dYReValues2 = Operand2.GetArray("yre")
	dYImValues2 = Operand2.GetArray("yim")
	For i = 0 To Operand1.GetN-1
		z1.re = dYReValues1(i)
		z1.im = dYImValues1(i)
		z2.re = dYReValues2(i)
		z2.im = dYImValues2(i)
		z = zatn2(z1, z2)
		dYReValues1(i) = z.re/Pi*180
		dYImValues1(i) = z.im/Pi*180
	Next
	Operand1.SetArray(dYReValues1, "yre")
	Operand1.SetArray(dYImValues1, "yim")
	Set Atn2D1DC = Operand1
End Function

Function Re1DC(Operand As Object) As Object
	' Return re(z)
	Dim dXValues() As Double, dYReValues() As Double
	dXValues = Operand.GetArray("x")
	dYReValues = Operand.GetArray("yre")
	Operand.Initialize(UBound(dXValues)+1)
	Operand.SetArray(dXValues, "x")
	Operand.SetArray(dYReValues, "yre")
	Set Re1DC = Operand
End Function

Function Im1DC(Operand As Object) As Object
	' Return im(z)
	Dim dXValues() As Double, dYImValues() As Double
	dXValues = Operand.GetArray("x")
	dYImValues = Operand.GetArray("yim")
	Operand.Initialize(UBound(dXValues)+1)
	Operand.SetArray(dXValues, "x")
	Operand.SetArray(dYImValues, "yre")
	Set Im1DC = Operand
End Function

Function Abs1DC(Operand As Object) As Object
	' Return abs(z)
	Dim i As Long
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		dYReValues(i) = Sqr(dYReValues(i)^2+dYImValues(i)^2)
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Abs1DC = Operand
End Function

Function MagdB101DC(Operand As Object) As Object
	' Return magnitude of z in dB, Factor 10
	Dim i As Long
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		dYReValues(i) = 10*Log(Sqr(dYReValues(i)^2+dYImValues(i)^2))/Log(10)
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set MagdB101DC = Operand
End Function

Function MagdB201DC(Operand As Object) As Object
	' Return magnitude of z in dB, Factor 20
	MagdB101DC(Operand)
	Operand.ScalarMultReIm(2,0)
	Set MagdB201DC = Operand
End Function

Function Arc1DC(Operand As Object) As Object
	' Return wrapped phase/arc of z in rad
	Dim i As Long
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		dYReValues(i) = ATn2(dYImValues(i),dYReValues(i))
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Arc1DC = Operand
End Function

Function ArcD1DC(Operand As Object) As Object
	' Return wrapped phase/arc of z in deg
	Dim i As Long
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		dYReValues(i) = ATn2D(dYImValues(i),dYReValues(i))
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set ArcD1DC = Operand
End Function

Function UArc1DC(Operand As Object, oWrapTolerance As Object) As Object

	' Return unwrapped phase/arc of z in rad, dWrapTolerance also in rad

	Dim i As Long, dWrapTolerance As Double, dCurrentOffset As Double
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	dWrapTolerance = oWrapTolerance.GetYRe(0)
	dCurrentOffset = 0 ' store current offset for increased performance, no need to start the while loops at 0 every time

	dYReValues(0) = ATn2(dYImValues(0),dYReValues(0))
	dYImValues(0) = 0
	For i = 1 To Operand.GetN-1
		dYReValues(i) = ATn2(dYImValues(i),dYReValues(i))+dCurrentOffset
		' Unwrap downwards
		While((dYReValues(i)-dYReValues(i-1) > dWrapTolerance) And Not GetTemplateAborted())
			dCurrentOffset = dCurrentOffset - 2*Pi
			dYReValues(i) = dYReValues(i) - 2*Pi
		Wend
		' Unwrap upwards
		While((dYReValues(i)-dYReValues(i-1)< -dWrapTolerance) And Not GetTemplateAborted())
			dCurrentOffset = dCurrentOffset + 2*Pi
			dYReValues(i) = dYReValues(i) + 2*Pi
		Wend
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set UArc1DC = Operand
End Function

Function UArcD1DC(Operand As Object, oWrapTolerance As Object) As Object

	' Return unwrapped phase/arc of z in deg, dWrapTolerance also in deg

	Dim i As Long, dWrapTolerance As Double, dCurrentOffset As Double
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")

	dWrapTolerance = oWrapTolerance.GetYRe(0)
	dCurrentOffset = 0 ' store current offset for increased performance, no need to start the while loops at 0 every time

	dYReValues(0) = ATn2D(dYImValues(0),dYReValues(0))
	dYImValues(0) = 0
	For i = 1 To Operand.GetN-1
		dYReValues(i) = ATn2D(dYImValues(i),dYReValues(i))+dCurrentOffset
		' Unwrap downwards
		While((dYReValues(i)-dYReValues(i-1) > dWrapTolerance) And Not GetTemplateAborted())
			dCurrentOffset = dCurrentOffset - 2*180
			dYReValues(i) = dYReValues(i) - 2*180
		Wend
		' Unwrap upwards
		While((dYReValues(i)-dYReValues(i-1)< -dWrapTolerance) And Not GetTemplateAborted())
			dCurrentOffset = dCurrentOffset + 2*180
			dYReValues(i) = dYReValues(i) + 2*180
		Wend
		dYImValues(i) = 0
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set UArcD1DC = Operand
End Function

Function Log1DC(Operand As Object) As Object
	' Calculate log_e(z)
	Dim i As Long
	Dim z As Complex
	Dim dYReValues() As Double, dYImValues() As Double
	dYReValues = Operand.GetArray("yre")
	dYImValues = Operand.GetArray("yim")
	For i = 0 To Operand.GetN-1
		z.re = dYReValues(i)
		z.im = dYImValues(i)
		z = zlog(z)
		dYReValues(i) = z.re
		dYImValues(i) = z.im
	Next
	Operand.SetArray(dYReValues, "yre")
	Operand.SetArray(dYImValues, "yim")
	Set Log1DC = Operand
End Function

Function Log101DC(Operand As Object) As Object
	' Calculate log_10(z)
	Log1DC(Operand)
	Operand.ScalarMultReIm(1/Log(10),0)
	Set Log101DC = Operand
End Function

