'End If
End Sub

Function plot_vec_zzz(xv As Variant, yv As Variant, plotname As String) As Boolean
		Dim i3 As Object, m1 As Long, m2 As Long
		Dim iii As Long

		m1 = LBound(xv)
		m2 = UBound(yv)

		Set i3 = Result1D("")
		i3.Initialize(m2-m1+1)
		For iii = m1 To m2	'UBound(maxcdf1)
			i3.SetXY(iii-m1, xv(iii), yv(iii))
		Next
		i3.Save "zzz"+plotname + ".sig"					'"zzzzerocdf1.sig"
		i3.AddToTree "1D Results\zzz\" + plotname	'zzzzerocdf"

End Function

Sub write_bin_mat(bin_mat() As Double, nt As Long, na As Long, filen As String)
	Dim iii As Long, jjj As Long
	Dim tmpstr As String

	Open GetProjectPath("Result") + "\" + filen For Output As #55
	For iii = 0 To na
		tmpstr = ""
		For jjj = 0 To nt
			tmpstr = tmpstr + Cstr(bin_mat(iii,jjj)) + vbTab 'vbCrLf
		Next
		Print #55, tmpstr
	Next
	Close #55
End Sub

' ----------- TEST FUNCTIONS FOR STATISTICAL EYE
Sub testsignal_statistical_eye (y() As Double, t() As Double, ByRef Ly As Long, ByRef cursor As Long, ByRef T2 As Long, ByRef da As Double, ByRef amin As Double, ByRef amax As Double, ByRef Lc1 As Long, ByRef Lc2 As Long)
'	Put #99, , nUIs_cursor
'	Put #99, , BitLen
'	Put #99, , posmax
'	Put #99, , posmin
'	Put #99, , da
'	Put #99, , na

'	Put #99, , Ly
'	Put #99, , t

			If 1 = 0 Then	' Test in which only the pre- and post-cursors are considered in y
		'	    y = [0.1 -0.2 0.2 -0.1 0.1 0.1]
				ReDim y(1 To 6)
				y(1)= 0.1: y(2)= -0.2: y(3)= 0.2: y(4)= -0.1: y(5)= 0.1: y(6)= 0.1
			    cursor = 0
			    T2 = 2
			    da = 0.1
			    amin = -0.3
			    amax = 0.8
			    Lc1 = 2
			    Lc2 = 2
			    T2 = 1
		    End If
			If 1 = 1 Then	' Test with all samples
		'	    y = [0.1 1.1 -0.2 0.2 -0.1 0.1 0.1]
				ReDim y(1 To 7), t(1 To 7)
				y(1)= 0.1: y(2) = 1.1: y(3)= -0.2: y(4)= 0.2: y(5)= -0.1: y(6)= 0.1: y(7)= 0.1
				t(1)= 0.1: t(2) = 1.1: t(3)= -0.2: t(4)= 0.2: t(5)= -0.1: t(6)= 0.1: t(7)= 0.1
			    cursor = 0
			    T2 = 2
			    da = 0.1
			    da = 0.01
			    amin = -0.3
			    amax = 1.7
			    Lc1 = 1
			    Lc2 = 1
			    T2 = 1
			    Ly = 7
		    End If
			If 1 = 0 Then	' Test with all samples, all double to simulate a longer pulse
		'	    y = [0.1 1.1 -0.2 0.2 -0.1 0.1 0.1]
				ReDim y(1 To 14)
				y(1)= 0.1: y(2)= 0.1: y(3) = 1.1: y(4) = 1.1: y(5)= -0.2: y(6)= -0.2: y(7)= 0.2: y(8)= 0.2
				y(9)= -0.1: y(10)= -0.1: y(11)= 0.1: y(12)= 0.1: y(13)= 0.1: y(14)= 0.1
			    cursor = 0
			    T2 = 2
			    da = 0.1
			    amin = -0.3
			    amax = 1.6
			    Lc1 = 2
			    Lc2 = 2
			    T2 = 2
		    End If

			If 1 = 0 Then	' Test with all samples, all double to simulate a longer pulse
		'	    y = [0.1 1.1 -0.2 0.2 -0.1 0.1 0.1]
				ReDim y(1 To 14)
				y(1)= 0.11: y(2)= 0.11: y(3) = 1.12: y(4) = 1.12: y(5)= -0.21: y(6)= -0.21: y(7)= 0.21: y(8)= 0.21
				y(9)= -0.17: y(10)= -0.17: y(11)= 0.11: y(12)= 0.11: y(13)= 0.11: y(14)= 0.11
			    cursor = 0
			    T2 = 2
			    da = 0.1
			    amin = -0.4
			    amax = 1.6
			    Lc1 = 2
			    Lc2 = 3
			    T2 = 2
		    End If
End Sub


Sub construct_test_shift_binmat(bin_mat() As Double, ByRef nshifts As Long)
	' Called in sub shift_binmat1
	Dim m As Long, n As Long

	ReDim bin_mat(0 To 2, 0 To 4)
	bin_mat(0, 1) = 0.1
	bin_mat(0, 2) = 0.2
	bin_mat(0, 3) = 0.3
	bin_mat(0, 4) = 0.4
	bin_mat(1, 0) = 1
	bin_mat(2, 0) = 2
	bin_mat(1, 1) = 1
	bin_mat(1, 2) = 2
	bin_mat(1, 3) = 3
	bin_mat(1, 4) = 1
	bin_mat(2, 1) = 1
	bin_mat(2, 2) = 2
	bin_mat(2, 3) = 3
	bin_mat(2, 4) = 1
	nshifts = 1
	m = UBound(bin_mat,1)
	n = UBound(bin_mat,2)
	'write_bin_mat(bin_mat, n, m, "bin_mat_fine_additive_shifted_TestINIT.txt")
End Sub

Sub read_from_contour_file(filen_out As String, nlev_PAM As Long)
	' FOR TESTING
	'
	Open filen_out For Binary Access Read As #99
Dim ttmp() As Double, otmp() As Double
Dim o2dim As Long

Dim vcrt As Double
Dim levcrt As Long

Dim vmin As Double, vmax As Double, ncontours As Long, vvv As Long

For levcrt = 0 To nlev_PAM-2
	Get #99, , vmin
	Get #99, , vmax

	Get #99, , vcrt
	Get #99, , o2dim
	ReDim ttmp(0 To o2dim-1)
	ReDim otmp(0 To o2dim-1)
	Get #99, , ttmp
	Get #99, , otmp
	vmin = vmin-1	' In the file, vmin is larger by 1

	vmin = Fix(vmin)+2	' For the variant "from file", add one more 1. Add 1, since the minimum BER is per conventin one unit less than
	vmax = Fix(vmax)-1
	ncontours = vmax - vmin+1
	For vvv = vmin To vmax
		'stateye_find_one_contour(xfull, vvv, o1, nUIs)
		Get #99, , vcrt
		Get #99, , o2dim
		ReDim ttmp(0 To o2dim-1)
		ReDim otmp(0 To o2dim-1)
		Get #99, , ttmp
		Get #99, , otmp
	Next
Next levcrt
Close #99

End Sub

Function digseq_as_string(digseq() As Byte, Optional limmax As Long) As String
	Dim tmpstr As String, iii As Long
	Dim mylim As Long

	mylim = UBound(digseq)
	If limmax > 0 Then mylim = limmax

	For iii = 1 To mylim
		tmpstr = tmpstr + Cstr(digseq(iii))
	Next

	digseq_as_string = tmpstr

End Function

Function display_ScriptSettings() As String
	' For debugging. Returns the current set of script settings as a string
	Dim tmpstr As String

	tmpstr = ""

	tmpstr = tmpstr +	"sAllXTalkChannels" + " " + GetScriptSetting("sAllXTalkChannels", "xxx") + vbCrLf

		' Warum werden die PP tasks nicht beruecksichtigt?
	tmpstr = tmpstr +	"TextBox_Channel"+ " " + GetScriptSetting("TextBox_Channel", "xxx") + vbCrLf
		' maybe use GetTreeNameScriptSetting StoreTreeNameSetting  for tree changes

	tmpstr = tmpstr +	"unitint"+ " " + GetScriptSetting("unitint", "xxx") + vbTab '+ vbCrLf

	tmpstr = tmpstr +	"iTimeFrq"+ " " + GetScriptSetting("iTimeFrq", "xxx") + vbCrLf
	tmpstr = tmpstr +	"CheckJitter"+ " " + GetScriptSetting("CheckJitter", "xxx") + vbCrLf
	tmpstr = tmpstr +	"CheckEncodingPAM"+ " " + GetScriptSetting("CheckEncodingPAM", "xxx") + vbCrLf
	tmpstr = tmpstr +	"CheckEmphasisEqualization"+ " " + GetScriptSetting("CheckEmphasisEqualization", "xxx") + vbCrLf

	tmpstr = tmpstr +	"GroupTyp_0class_1stat_2worst"+ " " + GetScriptSetting("GroupTyp_0class_1stat_2worst", "xxx") + vbCrLf
	tmpstr = tmpstr +	"Group_Step_Pulse_DblStep"+ " " + GetScriptSetting("Group_Step_Pulse_DblStep", "xxx") + vbCrLf

	tmpstr = tmpstr +	"n"+ " " + GetScriptSetting("n", "xxx") + vbCrLf

	'tmpstr = tmpstr +	GetScriptSettings_Equalization()

	tmpstr = tmpstr +	"EncType"+ " " + GetScriptSetting("EncType","xxx") + vbCrLf
	tmpstr = tmpstr +	"levels_PAM_txt"+ " " + GetScriptSetting("levels_PAM_txt", "xxx") + vbCrLf
	display_ScriptSettings = tmpstr

End Function

