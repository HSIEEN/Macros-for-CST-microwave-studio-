'
' This library allows the user to generate animations/movies from image series by providing an interface to FFMpeg and FFPlay
' It is used in the "Save Video" Macro, but can also be applied elsewhere.
' 
' Features:
' * rich set of supported output codecs
' * allows resizing and cropping of the images
' * allows overlaying a logo file
' * allows reverting the playback order
'
' Copyright 2020-2023 Dassault Systemes Deutschland GmbH
'-----------------------------------------------------------------------------------------------------------------------------------------------
' History of Changes
'-----------------------------------------------------------------------------------------------------------------------------------------------
' 01-Mar-2021 thn: change logo default position to NorthWest
' 15-Oct-2020 pge : Add default extension if extension if missing, otherwise no output is created
' 08-Jul-2020 mwl,ube: use new command for image creation ExportImageToFile
' 23-Mar-2020 mwl: added support for creating a movie from images in a directory (with dialog): GenerateMovieFromImagesInDirectory_Interactive()
' 22-Mar-2020 mwl: added support for joining multiple images vertically or horizontally and adding overlay text: JoinImages()
' 13-Feb-2020 mwl: added support for single image processing: CreateImageFromImage()
' 13-Feb-2020 mwl: added support for apng and mjpeg video codecs
' 12-Feb-2020 mwl: added support for wildcard patterns like '*.bmp'
' 11-Feb-2020 mwl: added AV1 support
' 08-Feb-2020 mwl: created library with extracts from new ffmpeg-only Save Video Macro
'-----------------------------------------------------------------------------------------------------------------------------------------------

''''''''''''' SUPPORTED VIDEO CODECS AND THEIR OPTIONS --> Used for CreateVideoFromImageSequence() ''''''''''''''''''''''''''
Public Const                                      GIF=0,  MPEG=1,  MP4=2,  CVID=3,  FLV=4,  H264=5,  VP9=6,  MSVC=7,  WMV7=8,  WMV8=9, THEORA=10, AV1=11,  APNG=12,  MJPEG=13, LASTCODEC=13
Public Const cst_codec_default_extension = Array("gif",  "mpg",   "mp4",  "avi",   "flv",  "mkv",   "webm", "avi",   "wmv",   "wmv",  "ogg",     "mkv",   "apng",   "mjpg")
Public Const cst_codec_description       = Array( _
            "Animated GIF", _
            "MPEG II Video", _
            "MP4 Video", _
            "Radius Cinepak Codec (AVI container)", _
            "Flash Video", _
            "H.264 (MKV container, for mobile devices)", _
            "VP9 (TrueMotion, for HTML5)", _
            "Microsoft Video 1 (AVI container)", _
            "Windows Media Video 7 (WMV)", _
            "Windows Media Video 8 (WMV)", _
            "Ogg (Theora)", _
            "AOMedia Video1 (AV1)", _
            "Animated PNG", _
            "Motion JPEG video")
Public Const cst_codec_default_option = Array( _
            "-y -loop 0", _
            "-y -vcodec mpeg2video -qscale:v 4 -pix_fmt yuv420p", _
            "-y -vcodec mpeg4 -qscale:v 4 -pix_fmt yuv420p", _
            "-y -vcodec cinepak", _
            "-y -vcodec flv1 -qscale:v 6", _
            "-y -vcodec h264 -pix_fmt yuv420p", _
            "-y -vcodec libvpx-vp9 -threads 4 -speed 1 -quality good", _
            "-y -vcodec msvideo1", _
            "-y -vcodec wmv1 -qscale:v 4", _
            "-y -vcodec wmv2 -qscale:v 4", _
            "-y -vcodec libtheora -qscale:v 4", _
            "-y -vcodec av1 -strict -2 -qscale:v 4", _
            "-y -vcodec apng -qscale:v 4", _
            "-y -vcodec mjpeg -qscale:v 4")
' some codecs only support specific resolutions (e.g. width and height divisible by 2 or 4 - this is what we adjust for here, using trunc(X+0.5) as round() is not avilable on Linux)
' for animated GIF, we generate and use a palette on the fly
Public Const cst_codec_extrafilter = Array( _
            "split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse", _
            "", _
            "", _
            "scale='trunc(ih*dar/4+0.5)*4':'trunc(ih/4+0.5)*4':bicubic,setsar=1/1", _
            "", _
            "scale='trunc(ih*dar/2+0.5)*2':'trunc(ih/2+0.5)*2':bicubic,setsar=1/1", _
            "", _
            "scale='trunc(ih*dar/4+0.5)*4':'trunc(ih/4+0.5)*4':bicubic,setsar=1/1", _
            "scale='trunc(ih*dar/2+0.5)*2':'trunc(ih/2+0.5)*2':bicubic,setsar=1/1", _
            "scale='trunc(ih*dar/2+0.5)*2':'trunc(ih/2+0.5)*2':bicubic,setsar=1/1", _
            "", _
            "", _
            "", _
            "")
