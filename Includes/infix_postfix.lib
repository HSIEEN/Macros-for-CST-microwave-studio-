		dYReValues = Operand.GetArray("yre")
		dYImValues = Operand.GetArray("yim")
		dZReValues = Operand.GetArray("zre")
		dZImValues = Operand.GetArray("zim")

	    For i = 0 To Operand.GetLength() - 1
	    	zx.re = dXReValues(i)
			zx.im = dXImValues(i)
	    	zy.re = dYReValues(i)
			zy.im = dYImValues(i)
	    	zz.re = dZReValues(i)
			zz.im = dZImValues(i)

			zx = zatn(zx)
			zy = zatn(zy)
			zz = zatn(zz)

			dXReValues(i) =  zx.re
			dXImValues(i) =  zx.im
			dYReValues(i) =  zy.re
			dYImValues(i) =  zy.im
			dZReValues(i) =  zz.re
			dZImValues(i) =  zz.im
	    Next

		Operand.SetArray(dXReValues, "xre")
		Operand.SetArray(dXImValues, "xim")
		Operand.SetArray(dYReValues, "yre")
		Operand.SetArray(dYImValues, "yim")
		Operand.SetArray(dZReValues, "zre")
		Operand.SetArray(dZImValues, "zim")
	ElseIf (Operand.GetResultObjectType() = "1DC") Then
		' 1DC Implementation
		Set Atn3D = Atn1DC(Operand)
	Else
		ReportError("ATn3D: Unknown operand type " & Operand.GetResultObjectType() & ". Please contact support.")
	End If

	Set Atn3D = Operand
End Function

Function AtnD3D(Operand As Object) As Object
	' Calculate atan(z), result in deg
	Dim i As Long
	Dim zx As Complex, zy As Complex, zz As Complex ' complex vector components
	Dim dXReValues() As Double, dXImValues() As Double, dYReValues() As Double, dYImValues() As Double, dZReValues() As Double, dZImValues() As Double

	If (Operand.GetResultObjectType() = "3D") Then
		dXReValues = Operand.GetArray("xre")
		dXImValues = Operand.GetArray("xim")
		dYReValues = Operand.GetArray("yre")
		dYImValues = Operand.GetArray("yim")
		dZReValues = Operand.GetArray("zre")
		dZImValues = Operand.GetArray("zim")

	    For i = 0 To Operand.GetLength() - 1
	    	zx.re = dXReValues(i)
			zx.im = dXImValues(i)
	    	zy.re = dYReValues(i)
			zy.im = dYImValues(i)
	    	zz.re = dZReValues(i)
			zz.im = dZImValues(i)

			zx = zatn(zx)
			zy = zatn(zy)
			zz = zatn(zz)

			dXReValues(i) =  zx.re/Pi*180
			dXImValues(i) =  zx.im/Pi*180
			dYReValues(i) =  zy.re/Pi*180
			dYImValues(i) =  zy.im/Pi*180
			dZReValues(i) =  zz.re/Pi*180
			dZImValues(i) =  zz.im/Pi*180
	    Next

		Operand.SetArray(dXReValues, "xre")
		Operand.SetArray(dXImValues, "xim")
		Operand.SetArray(dYReValues, "yre")
		Operand.SetArray(dYImValues, "yim")
		Operand.SetArray(dZReValues, "zre")
		Operand.SetArray(dZImValues, "zim")
	ElseIf (Operand.GetResultObjectType() = "1DC") Then
		' 1DC Implementation
		Set AtnD3D = AtnD1DC(Operand)
	Else
		ReportError("ATnD3D: Unknown operand type " & Operand.GetResultObjectType() & ". Please contact support.")
	End If

	Set AtnD3D = Operand
End Function

Function Atn23D(Operand1 As Object, Operand2 As Object) As Object
	' Calculate atan2(z1, z2), result in rad
	Dim i As Long
	Dim zx As Complex, zy As Complex, zz As Complex ' complex vector components
	Dim zx1 As Complex, zy1 As Complex, zz1 As Complex ' complex vector components
	Dim zx2 As Complex, zy2 As Complex, zz2 As Complex ' complex vector components
	Dim dXReValues1() As Double, dXImValues1() As Double, dYReValues1() As Double, dYImValues1() As Double, dZReValues1() As Double, dZImValues1() As Double
	Dim dXReValues2() As Double, dXImValues2() As Double, dYReValues2() As Double, dYImValues2() As Double, dZReValues2() As Double, dZImValues2() As Double

	' Check this just in case. If needed, mixed combinations could be implemented later.
	If (Operand1.GetResultObjectType() <> Operand2.GetResultObjectType()) Then
		ReportError("Mix 3D Atn2: Both operands must be of the same type.")
	End If

	If (Operand1.GetResultObjectType() = "3D") Then
		dXReValues1 = Operand1.GetArray("xre")
		dXImValues1 = Operand1.GetArray("xim")
		dYReValues1 = Operand1.GetArray("yre")
		dYImValues1 = Operand1.GetArray("yim")
		dZReValues1 = Operand1.GetArray("zre")
		dZImValues1 = Operand1.GetArray("zim")

		dXReValues2 = Operand2.GetArray("xre")
		dXImValues2 = Operand2.GetArray("xim")
		dYReValues2 = Operand2.GetArray("yre")
		dYImValues2 = Operand2.GetArray("yim")
		dZReValues2 = Operand2.GetArray("zre")
		dZImValues2 = Operand2.GetArray("zim")

	    For i = 0 To Operand1.GetLength() - 1
	    	zx1.re = dXReValues1(i)
			zx1.im = dXImValues1(i)
	    	zy1.re = dYReValues1(i)
			zy1.im = dYImValues1(i)
	    	zz1.re = dZReValues1(i)
			zz1.im = dZImValues1(i)

	    	zx2.re = dXReValues2(i)
			zx2.im = dXImValues2(i)
	    	zy2.re = dYReValues2(i)
			zy2.im = dYImValues2(i)
	    	zz2.re = dZReValues2(i)
			zz2.im = dZImValues2(i)

			zx = zatn2(zx1, zx2)
			zy = zatn2(zx1, zx2)
			zz = zatn2(zx1, zx2)

			dXReValues1(i) =  zx.re
			dXImValues1(i) =  zx.im
			dYReValues1(i) =  zy.re
			dYImValues1(i) =  zy.im
			dZReValues1(i) =  zz.re
			dZImValues1(i) =  zz.im
	    Next

		Operand1.SetArray(dXReValues1, "xre")
		Operand1.SetArray(dXImValues1, "xim")
		Operand1.SetArray(dYReValues1, "yre")
		Operand1.SetArray(dYImValues1, "yim")
		Operand1.SetArray(dZReValues1, "zre")
		Operand1.SetArray(dZImValues1, "zim")
	ElseIf (Operand1.GetResultObjectType() = "1DC") Then
		' 1DC Implementation
		Set Atn23D = Atn21DC(Operand1, Operand2)
	Else
		ReportError("Atn23D: Unknown operand type " & Operand1.GetResultObjectType() & ". Please contact support.")
	End If

	Set Atn23D = Operand1
End Function

Function Atn2D3D(Operand1 As Object, Operand2 As Object) As Object
	' Calculate atan2(z1, z2), result in deg
	Dim i As Long
	Dim zx As Complex, zy As Complex, zz As Complex ' complex vector components
	Dim zx1 As Complex, zy1 As Complex, zz1 As Complex ' complex vector components
	Dim zx2 As Complex, zy2 As Complex, zz2 As Complex ' complex vector components
